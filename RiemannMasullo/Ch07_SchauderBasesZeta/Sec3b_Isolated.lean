/-! # A quartic benchmark for the shifted Euler-factor estimate

Issue #7336 concerns the single-place estimate in the reconstruction of Theorem 7.3.3.4
(pp. 360–363), with the coefficient change on p. 349. We verify the quartic prime data,
the explicit phases and their pole-lattice behavior, and a necessary bound for
squared-height records. The mixed two-place estimate uses a cited classical input
on three fixed logarithms.
-/

@[expose] public noncomputable section

namespace RiemannMasullo.Isolated

open Filter Ideal NumberField Set
open scoped ComplexConjugate NNReal NumberField Topology

/-! ## Quartic prime data -/

local notation "F₈" => CyclotomicField 8 ℚ

private theorem quarticBenchmark_finrank : Module.finrank ℚ F₈ = 4 := by
  let : IsCyclotomicExtension {8} ℚ F₈ := CyclotomicField.isCyclotomicExtension 8 ℚ
  rw [IsCyclotomicExtension.Rat.finrank 8 F₈]
  decide

private theorem quarticBenchmark_primeSplitting (p f : ℕ) [Fact p.Prime]
    (hp : ¬ p ∣ 8) (hf : orderOf (p : ZMod 8) = f) :
    let P : Ideal ℤ := Ideal.span {(p : ℤ)}
    (P.primesOver (𝓞 F₈)).ncard * f = 4 ∧
      ∀ Q ∈ P.primesOver (𝓞 F₈), Q.absNorm = p ^ f := by
  let P : Ideal ℤ := Ideal.span {(p : ℤ)}
  change (P.primesOver (𝓞 F₈)).ncard * f = 4 ∧ _
  have : IsCyclotomicExtension {8} ℚ F₈ := CyclotomicField.isCyclotomicExtension 8 ℚ
  have : P.IsMaximal := Int.ideal_span_isMaximal_of_prime p
  let : Fintype (P.primesOver (𝓞 F₈)) := (IsDedekindDomain.primesOver_finite P (𝓞 F₈)).fintype
  have hinertia (Q : P.primesOver (𝓞 F₈)) : Q.val.inertiaDeg ℤ = f := by
    have := Q.property.1
    have := Q.property.2
    exact (IsCyclotomicExtension.Rat.inertiaDeg_eq_of_not_dvd p F₈ Q.val hp).trans hf
  have hram (Q : P.primesOver (𝓞 F₈)) : Q.val.ramificationIdx ℤ = 1 := by
    have := Q.property.1
    have := Q.property.2
    exact IsCyclotomicExtension.Rat.ramificationIdx_eq_of_not_dvd p F₈ Q.val hp
  have hs := Ideal.sum_ramification_inertia_eq_finrank P (𝓞 F₈)
  simp only [hinertia, hram, one_mul, Finset.sum_const, Finset.card_univ, smul_eq_mul,
    RingOfIntegers.rank, quarticBenchmark_finrank, Set.fintypeCard_eq_ncard] at hs
  refine ⟨hs, ?_⟩
  intro Q hQ
  have := hQ.1
  have := hQ.2
  rw [← Ideal.natAbs_pow_inertiaDeg (p : ℤ) Q, Int.natAbs_natCast, hinertia ⟨Q, hQ⟩]

/-- The two primary places in the quartic benchmark have residue size 49. -/
theorem quarticBenchmark_primes_over_seven :
    let P : Ideal ℤ := Ideal.span {(7 : ℤ)}
    (P.primesOver (𝓞 F₈)).ncard = 2 ∧
      ∀ Q ∈ P.primesOver (𝓞 F₈), Q.absNorm = 49 := by
  have : Fact (Nat.Prime 7) := ⟨by decide⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have ho : orderOf ((7 : ℕ) : ZMod 8) = 2 := orderOf_eq_prime (by decide) (by decide)
  obtain ⟨hcard, hnorm⟩ := quarticBenchmark_primeSplitting 7 2 (by decide) ho
  change ((Ideal.span {(7 : ℤ)}).primesOver (𝓞 F₈)).ncard * 2 = 4 at hcard
  exact ⟨by omega, hnorm⟩

/-- The outside prime in the quartic benchmark has four places of residue size 17. -/
theorem quarticBenchmark_primes_over_seventeen :
    let P : Ideal ℤ := Ideal.span {(17 : ℤ)}
    (P.primesOver (𝓞 F₈)).ncard = 4 ∧
      ∀ Q ∈ P.primesOver (𝓞 F₈), Q.absNorm = 17 := by
  have : Fact (Nat.Prime 17) := ⟨by decide⟩
  have ho : orderOf ((17 : ℕ) : ZMod 8) = 1 := by
    rw [show ((17 : ℕ) : ZMod 8) = 1 by decide, orderOf_one]
  obtain ⟨hcard, hnorm⟩ := quarticBenchmark_primeSplitting 17 1 (by decide) ho
  exact ⟨by simpa using hcard, by simpa using hnorm⟩

/-- The quartic benchmark has class number one. The Minkowski bound is below three, and
the unique prime over two is generated by the difference of a primitive eighth root and one. -/
theorem quarticBenchmark_classNumber : NumberField.classNumber F₈ = 1 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : IsCyclotomicExtension {8} ℚ F₈ := CyclotomicField.isCyclotomicExtension 8 ℚ
  let : IsCyclotomicExtension {2 ^ (2 + 1)} ℚ F₈ := inferInstanceAs
    (IsCyclotomicExtension {8} ℚ F₈)
  have hdisc : NumberField.discr F₈ = 256 := by
    simpa using IsCyclotomicExtension.Rat.discr_prime_pow_succ 2 2 F₈
  have hcomplex : NumberField.InfinitePlace.nrComplexPlaces F₈ = 2 := by
    rw [IsCyclotomicExtension.Rat.nrComplexPlaces_eq_totient_div_two 8]
    decide
  have hM : (4 / Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces F₈ *
      ((Nat.factorial (Module.finrank ℚ F₈) : ℝ) / (Module.finrank ℚ F₈ : ℝ) ^
        Module.finrank ℚ F₈ * Real.sqrt |(NumberField.discr F₈ : ℝ)|) < 3 := by
    rw [hdisc, hcomplex, quarticBenchmark_finrank]
    have hs : Real.sqrt 256 = 16 := by rw [show (256 : ℝ) = 16 ^ 2 by norm_num]; simp
    norm_num [Nat.factorial, div_pow, hs]
    field_simp [Real.pi_ne_zero]
    nlinarith [Real.pi_gt_three, sq_nonneg (Real.pi - 3)]
  apply NumberField.classNumber_eq_one_iff.mpr
  apply NumberField.RingOfIntegers.isPrincipalIdealRing_of_isPrincipal_of_pow_le_of_mem_primesOver_of_mem_Icc
  intro p hp hpPrime P hP _
  have hfloor := (Nat.floor_lt' (by decide : 3 ≠ 0)).mpr hM
  have hpLe := (Finset.mem_Icc.mp hp).2
  have hpLower := hpPrime.two_le
  have hpTwo : p = 2 := by omega
  subst p
  have := hP.1
  have := hP.2
  let ζ := IsCyclotomicExtension.zeta 8 ℚ F₈
  have hζ : IsPrimitiveRoot ζ (2 ^ (2 + 1)) := IsCyclotomicExtension.zeta_spec 8 ℚ F₈
  rw [IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver 2 2 F₈ hζ P]
  exact ⟨_, rfl⟩

/-- The Picard group is trivial at every stage of the quartic benchmark. -/
theorem quarticBenchmark_sInteger_picard (S : Set (IsDedekindDomain.HeightOneSpectrum (𝓞 F₈))) :
    Subsingleton (CommRing.Pic (Set.integer S F₈)) := by
  let R := 𝓞 F₈
  let A := Set.integer S F₈
  let M := Localization.submonoid S
  have : IsPrincipalIdealRing R := NumberField.classNumber_eq_one_iff.mp quarticBenchmark_classNumber
  have : IsPrincipalIdealRing A := ⟨fun I ↦ by
    rw [← IsLocalization.map_under M A I]
    exact (IsPrincipalIdealRing.principal (I.under R)).map_ringHom (algebraMap R A)⟩
  infer_instance

private theorem quarticBenchmark_zeta_reduction {ζ : 𝓞 F₈} (hζ : IsPrimitiveRoot ζ 8)
    (t : ZMod 17) (ht : t ^ 4 + 1 = 0) :
    ∃ φ : (𝓞 F₈) →ₐ[ℤ] ZMod 17, φ ζ = t := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : IsCyclotomicExtension {2 ^ (2 + 1)} ℚ F₈ :=
    CyclotomicField.isCyclotomicExtension 8 ℚ
  have hζ' : IsPrimitiveRoot (algebraMap (𝓞 F₈) F₈ ζ) (2 ^ (2 + 1)) :=
    hζ.map_of_injective RingOfIntegers.coe_injective
  let pb := hζ'.integralPowerBasisOfPrimePow
  have hgen : pb.gen = ζ := by
    dsimp [pb]
    rw [IsPrimitiveRoot.integralPowerBasisOfPrimePow_gen]
    exact IsPrimitiveRoot.toInteger_coe hζ'
  have hmin : Polynomial.cyclotomic (2 ^ (2 + 1)) ℤ = minpoly ℤ ζ :=
    (Polynomial.cyclotomic_eq_minpoly hζ' (by decide)).trans
      (minpoly.algebraMap_eq RingOfIntegers.coe_injective ζ)
  have hroot : Polynomial.aeval t (minpoly ℤ pb.gen) = 0 := by
    rw [hgen, ← hmin,
      Polynomial.cyclotomic_prime_pow_eq_geom_sum Nat.prime_two]
    simpa [Finset.sum_range_succ, add_comm] using ht
  exact ⟨pb.lift t hroot, hgen ▸ pb.lift_gen t hroot⟩

private theorem quarticBenchmark_ker_mem_primesOver (φ : (𝓞 F₈) →ₐ[ℤ] ZMod 17) :
    RingHom.ker φ ∈ (Ideal.span {(17 : ℤ)}).primesOver (𝓞 F₈) := by
  have : Fact (Nat.Prime 17) := ⟨by decide⟩
  refine ⟨RingHom.ker_isPrime φ, ⟨?_⟩⟩
  change Ideal.span {((17 : ℕ) : ℤ)} =
    (RingHom.ker φ.toRingHom).comap (algebraMap ℤ (𝓞 F₈))
  rw [RingHom.comap_ker, ← ZMod.ker_intCastRingHom 17]
  congr 1
  ext x
  simp

private theorem quarticBenchmark_generatorNorm {ζ : 𝓞 F₈} (hζ : IsPrimitiveRoot ζ 8) :
    (Ideal.span {2 + ζ}).absNorm = 17 ∧ (Ideal.span {2 - ζ}).absNorm = 17 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : IsCyclotomicExtension {2 ^ (2 + 1)} ℚ F₈ :=
    CyclotomicField.isCyclotomicExtension 8 ℚ
  have hζ' : IsPrimitiveRoot (algebraMap (𝓞 F₈) F₈ ζ) (2 ^ (2 + 1)) :=
    hζ.map_of_injective RingOfIntegers.coe_injective
  let pb := hζ'.integralPowerBasisOfPrimePow
  have hgen : pb.gen = ζ := by
    dsimp [pb]
    rw [IsPrimitiveRoot.integralPowerBasisOfPrimePow_gen]
    exact IsPrimitiveRoot.toInteger_coe hζ'
  have hmin : minpoly ℤ pb.gen = Polynomial.X ^ 4 + 1 := by
    have hc : Polynomial.cyclotomic (2 ^ (2 + 1)) ℤ = minpoly ℤ ζ :=
      (Polynomial.cyclotomic_eq_minpoly hζ' (by decide)).trans
        (minpoly.algebraMap_eq RingOfIntegers.coe_injective ζ)
    rw [hgen, ← hc, Polynomial.cyclotomic_prime_pow_eq_geom_sum Nat.prime_two]
    norm_num [Finset.sum_range_succ]
    ring
  have hdim : pb.dim = 4 := by
    rw [← pb.natDegree_minpoly, hmin]
    compute_degree
    norm_num
  let M := Algebra.leftMulMatrix pb.basis
  have hchar (t : ℤ) : (Matrix.scalar _ t - M pb.gen).det = t ^ 4 + 1 := by
    rw [← Matrix.eval_charpoly, charpoly_leftMulMatrix, hmin]
    simp
  have hscalar (t : ℤ) : M (t : 𝓞 F₈) = Matrix.scalar _ t := by
    rw [← map_intCast (algebraMap ℤ (𝓞 F₈)) t, M.commutes]
    ext i j
    rw [Matrix.algebraMap_matrix_apply]
    rfl
  constructor
  · rw [Ideal.absNorm_span_singleton, Algebra.norm_eq_matrix_det pb.basis, ← hgen]
    change (M (2 + pb.gen)).det.natAbs = 17
    have he : M (2 + pb.gen) = -(Matrix.scalar _ (-2 : ℤ) - M pb.gen) := by
      rw [map_add, neg_sub, ← hscalar]
      norm_num [sub_eq_add_neg, add_comm]
    rw [he, Matrix.det_neg, Fintype.card_fin, hchar, hdim]
    decide
  · rw [Ideal.absNorm_span_singleton, Algebra.norm_eq_matrix_det pb.basis, ← hgen]
    change (M (2 - pb.gen)).det.natAbs = 17
    rw [map_sub, show M 2 = Matrix.scalar _ (2 : ℤ) from hscalar 2, hchar]
    decide

/-- Two distinct primes over seventeen select the indicated signs of the quadratic factors in
the quartic benchmark. For a primitive eighth root `ζ`, the two quadratic generators are
`ζ ^ 2` and `ζ + ζ ^ 3`. -/
theorem quarticBenchmark_distinct_primes_over_seventeen {ζ : 𝓞 F₈}
    (hζ : IsPrimitiveRoot ζ 8) :
    let P : Ideal ℤ := Ideal.span {(17 : ℤ)}
    ∃ Pplus Pminus : Ideal (𝓞 F₈),
      Pplus ∈ P.primesOver (𝓞 F₈) ∧ Pminus ∈ P.primesOver (𝓞 F₈) ∧
      Pplus ≠ Pminus ∧ (1 + 4 * ζ ^ 2) ∈ Pplus ∧ (1 + 4 * ζ ^ 2) ∈ Pminus ∧
      (3 + 2 * (ζ + ζ ^ 3)) ∈ Pplus ∧ (3 - 2 * (ζ + ζ ^ 3)) ∈ Pminus ∧
      Pplus = Ideal.span {2 + ζ} ∧ Pminus = Ideal.span {2 - ζ} := by
  obtain ⟨φplus, hφplus⟩ := quarticBenchmark_zeta_reduction hζ 15 (by decide)
  obtain ⟨φminus, hφminus⟩ := quarticBenchmark_zeta_reduction hζ 2 (by decide)
  have hplus : (3 + 2 * (ζ + ζ ^ 3)) ∈ RingHom.ker φplus := by
    simp only [RingHom.mem_ker, map_add, map_mul, map_ofNat, map_pow, hφplus]
    decide
  have hplus_not : (3 + 2 * (ζ + ζ ^ 3)) ∉ RingHom.ker φminus := by
    simp only [RingHom.mem_ker, map_add, map_mul, map_ofNat, map_pow, hφminus]
    decide
  have normPrime (x : 𝓞 F₈) (hx : (Ideal.span {x}).absNorm = 17) :
      (Ideal.span {x}).IsMaximal := by
    have hprime : (Ideal.span {x}).IsPrime := Ideal.isPrime_of_irreducible_absNorm (by
      rw [hx, Nat.irreducible_iff_prime]
      decide)
    apply hprime.isMaximal
    intro hbot
    rw [hbot, Ideal.absNorm_bot] at hx
    contradiction
  obtain ⟨hnormPlus, hnormMinus⟩ := quarticBenchmark_generatorNorm hζ
  have hspanPlus : Ideal.span {2 + ζ} = RingHom.ker φplus :=
    (normPrime _ hnormPlus).eq_of_le (quarticBenchmark_ker_mem_primesOver φplus).1.ne_top
      (Ideal.span_singleton_le_iff_mem _ |>.mpr (by
        simp only [RingHom.mem_ker, map_add, map_ofNat, hφplus]
        decide))
  have hspanMinus : Ideal.span {2 - ζ} = RingHom.ker φminus :=
    (normPrime _ hnormMinus).eq_of_le (quarticBenchmark_ker_mem_primesOver φminus).1.ne_top
      (Ideal.span_singleton_le_iff_mem _ |>.mpr (by
        simp only [RingHom.mem_ker, map_sub, map_ofNat, hφminus]
        decide))
  refine ⟨_, _, quarticBenchmark_ker_mem_primesOver φplus,
    quarticBenchmark_ker_mem_primesOver φminus, ?_, ?_, ?_, hplus, ?_,
    hspanPlus.symm, hspanMinus.symm⟩
  · intro h
    exact hplus_not (h ▸ hplus)
  · simp only [RingHom.mem_ker, map_add, map_one, map_mul, map_ofNat, map_pow, hφplus]
    decide
  · simp only [RingHom.mem_ker, map_add, map_one, map_mul, map_ofNat, map_pow, hφminus]
    decide
  · simp only [RingHom.mem_ker, map_sub, map_add, map_mul, map_ofNat, map_pow, hφminus]
    decide

/-! ## Finite places and stages -/

section FiniteStages

open IsDedekindDomain

private theorem rationalPlace_under_int_eq_iff {F : Type*} [Field F] [NumberField F]
    (v w : HeightOneSpectrum (𝓞 F)) :
    v.under (𝓞 ℚ) = w.under (𝓞 ℚ) ↔ v.asIdeal.under ℤ = w.asIdeal.under ℤ := by
  have hs : Function.Surjective (algebraMap ℤ (𝓞 ℚ)) := by
    have hhom : algebraMap ℤ (𝓞 ℚ) = Rat.ringOfIntegersEquiv.symm.toRingHom :=
      Subsingleton.elim _ _
    rw [hhom]
    exact Rat.ringOfIntegersEquiv.symm.surjective
  constructor
  · intro h
    have := congrArg (fun y : HeightOneSpectrum (𝓞 ℚ) ↦ y.asIdeal.under ℤ) h
    simpa only [HeightOneSpectrum.under_asIdeal, Ideal.under_under] using this
  · intro h
    apply HeightOneSpectrum.ext
    apply Ideal.comap_injective_of_surjective _ hs
    change ((v.asIdeal.under (𝓞 ℚ)).under ℤ) = ((w.asIdeal.under (𝓞 ℚ)).under ℤ)
    rwa [Ideal.under_under, Ideal.under_under]

local notation "V₈" => HeightOneSpectrum (𝓞 F₈)
local notation "Vℚ" => HeightOneSpectrum (𝓞 ℚ)
local notation "P₇" => (Ideal.span {(7 : ℤ)})
local notation "P₁₇" => (Ideal.span {(17 : ℤ)})

open scoped Classical in
/-- Assemble the saturated stages over seven and seventeen and the selected four-place
set from the two named primes in each fiber. -/
theorem quarticFiniteStages (I J K L : Ideal (𝓞 F₈))
    (hI : I ∈ (P₇).primesOver (𝓞 F₈)) (hJ : J ∈ (P₇).primesOver (𝓞 F₈))
    (hK : K ∈ (P₁₇).primesOver (𝓞 F₈)) (hL : L ∈ (P₁₇).primesOver (𝓞 F₈))
    (hIJ : I ≠ J) (hKL : K ≠ L) (hcard : ((P₇).primesOver (𝓞 F₈)).ncard = 2) :
    ∃ (v₁ v₂ u₁ u₂ : V₈) (p q : Vℚ) (S : Finset V₈),
      let S₀ : Finset V₈ := {v₁, v₂}
      let T := S₀ ∪ {u₁, u₂}
      v₁.asIdeal = I ∧ v₂.asIdeal = J ∧ u₁.asIdeal = K ∧ u₂.asIdeal = L ∧
      v₁ ≠ v₂ ∧ u₁ ≠ u₂ ∧ p ≠ q ∧
      v₁.under (𝓞 ℚ) = p ∧ v₂.under (𝓞 ℚ) = p ∧
      u₁.under (𝓞 ℚ) = q ∧ u₂.under (𝓞 ℚ) = q ∧
      IsSaturatedPlaceSet S₀ ∧ IsSaturatedPlaceSet S ∧ T ⊆ S ∧
      sLocalPrimaryPlaces S p = S₀ ∧ sLocalPrimaryPlaces T p = S₀ ∧
      T \ S₀ = {u₁, u₂} := by
  classical
  have h7bot : P₇ ≠ ⊥ := by simp
  have h17bot : P₁₇ ≠ ⊥ := by simp
  let v₁ : V₈ := ⟨I, hI.1, Ideal.ne_bot_of_mem_primesOver h7bot hI⟩
  let v₂ : V₈ := ⟨J, hJ.1, Ideal.ne_bot_of_mem_primesOver h7bot hJ⟩
  let u₁ : V₈ := ⟨K, hK.1, Ideal.ne_bot_of_mem_primesOver h17bot hK⟩
  let u₂ : V₈ := ⟨L, hL.1, Ideal.ne_bot_of_mem_primesOver h17bot hL⟩
  let p := v₁.under (𝓞 ℚ)
  let q := u₁.under (𝓞 ℚ)
  have h7 (v : V₈) : v.asIdeal ∈ (P₇).primesOver (𝓞 F₈) ↔ v.under (𝓞 ℚ) = p := by
    rw [rationalPlace_under_int_eq_iff, hI.2.over.symm]
    exact ⟨fun hv ↦ hv.2.over.symm, fun hv ↦ ⟨v.isPrime, ⟨hv.symm⟩⟩⟩
  have h17 (v : V₈) : v.asIdeal ∈ (P₁₇).primesOver (𝓞 F₈) ↔ v.under (𝓞 ℚ) = q := by
    rw [rationalPlace_under_int_eq_iff, hK.2.over.symm]
    exact ⟨fun hv ↦ hv.2.over.symm, fun hv ↦ ⟨v.isPrime, ⟨hv.symm⟩⟩⟩
  have hpq : p ≠ q := by
    intro hpq
    have hh := (rationalPlace_under_int_eq_iff v₁ u₁).mp hpq
    have hEq : P₇ = P₁₇ := hI.2.over.trans (hh.trans hK.2.over.symm)
    have hmem : (7 : ℤ) ∈ P₁₇ := hEq ▸ Ideal.mem_span_singleton_self 7
    rw [Ideal.mem_span_singleton] at hmem
    omega
  have hv₁ : v₁.under (𝓞 ℚ) = p := rfl
  have hv₂ : v₂.under (𝓞 ℚ) = p := (h7 v₂).mp hJ
  have hu₁ : u₁.under (𝓞 ℚ) = q := rfl
  have hu₂ : u₂.under (𝓞 ℚ) = q := (h17 u₂).mp hL
  have h7f : ((P₇).primesOver (𝓞 F₈)).Finite := by
    have : Fact (Nat.Prime 7) := ⟨by decide⟩
    have : (P₇).IsMaximal := Int.ideal_span_isMaximal_of_prime 7
    exact IsDedekindDomain.primesOver_finite P₇ (𝓞 F₈)
  have h17f : ((P₁₇).primesOver (𝓞 F₈)).Finite := by
    have : Fact (Nat.Prime 17) := ⟨by decide⟩
    have : (P₁₇).IsMaximal := Int.ideal_span_isMaximal_of_prime 17
    exact IsDedekindDomain.primesOver_finite P₁₇ (𝓞 F₈)
  have hfull : ({I, J} : Set (Ideal (𝓞 F₈))) = (P₇).primesOver (𝓞 F₈) := by
    apply Set.eq_of_subset_of_ncard_le _ _ h7f
    · intro M hM
      rcases hM with h | h
      · exact h ▸ hI
      · have he : M = J := h
        exact he ▸ hJ
    · rw [hcard, Set.ncard_pair_eq_two_iff.mpr hIJ]
  let S₀ : Finset V₈ := {v₁, v₂}
  let T : Finset V₈ := S₀ ∪ {u₁, u₂}
  let Sset := HeightOneSpectrum.asIdeal ⁻¹'
    ((P₇).primesOver (𝓞 F₈) ∪ (P₁₇).primesOver (𝓞 F₈))
  have hSset : Sset.Finite := (h7f.union h17f).preimage
    (fun _ _ _ _ he ↦ HeightOneSpectrum.ext he)
  let S := hSset.toFinset
  have hS (v : V₈) : v ∈ S ↔ v.under (𝓞 ℚ) = p ∨ v.under (𝓞 ℚ) = q := by
    rw [Set.Finite.mem_toFinset]
    change v.asIdeal ∈ (P₇).primesOver (𝓞 F₈) ∨ v.asIdeal ∈ (P₁₇).primesOver (𝓞 F₈) ↔ _
    rw [h7, h17]
  have hS₀ (v : V₈) : v ∈ S₀ ↔ v.under (𝓞 ℚ) = p := by
    rw [← h7, ← hfull]
    simp only [S₀, Finset.mem_insert, Finset.mem_singleton, Set.mem_insert_iff, Set.mem_singleton_iff]
    exact or_congr (HeightOneSpectrum.ext_iff) (HeightOneSpectrum.ext_iff)
  have hTS : T ⊆ S := by
    intro v hv
    rw [hS]
    rw [Finset.mem_union] at hv
    rcases hv with hv | hv
    · exact Or.inl ((hS₀ v).mp hv)
    · simp only [Finset.mem_insert, Finset.mem_singleton] at hv
      rcases hv with rfl | rfl
      · exact Or.inr hu₁
      · exact Or.inr hu₂
  have hS₀T : S₀ ⊆ T := Finset.subset_union_left
  refine ⟨v₁, v₂, u₁, u₂, p, q, S, rfl, rfl, rfl, rfl,
    (fun h ↦ hIJ (congrArg HeightOneSpectrum.asIdeal h)),
    (fun h ↦ hKL (congrArg HeightOneSpectrum.asIdeal h)),
    hpq, hv₁, hv₂, hu₁, hu₂, ?_, ?_, hTS, ?_, ?_, ?_⟩
  · intro v w hv hw
    exact (hS₀ w).mpr (hw.trans ((hS₀ v).mp hv))
  · intro v w hv hw
    exact (hS w).mpr (((hS v).mp hv).imp (hw.trans ·) (hw.trans ·))
  · ext v
    rw [mem_sLocalPrimaryPlaces, hS₀, hS]
    exact ⟨And.right, fun h ↦ ⟨Or.inl h, h⟩⟩
  · ext v
    rw [mem_sLocalPrimaryPlaces, hS₀]
    exact ⟨And.right, fun h ↦ ⟨hS₀T ((hS₀ v).mpr h), h⟩⟩
  · ext v
    change v ∈ T \ S₀ ↔ v ∈ ({u₁, u₂} : Finset V₈)
    rw [Finset.mem_sdiff, Finset.mem_union]
    refine ⟨fun h ↦ h.1.resolve_left h.2, fun h ↦ ⟨Or.inr h, ?_⟩⟩
    intro hv
    have hvp := (hS₀ v).mp hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl
    · exact hpq (hvp.symm.trans hu₁)
    · exact hpq (hvp.symm.trans hu₂)

open scoped Classical in
/-- An integral generator of a nonzero prime ideal has exponent one at that place
and exponent zero at every other place. -/
theorem valuation_prime_ideal_generator (F : Type*) [Field F] [NumberField F]
    (v : HeightOneSpectrum (𝓞 F)) (x : 𝓞 F) (hx : v.asIdeal = Ideal.span {x}) :
    ∀ w : HeightOneSpectrum (𝓞 F),
      w.valuation F (algebraMap (𝓞 F) F x) =
        if w = v then WithZero.exp (-1 : ℤ) else 1 := by
  classical
  have hx₀ : x ≠ 0 := by
    intro h
    exact v.ne_bot (by simpa [h] using hx)
  intro w
  rw [w.valuation_of_algebraMap]
  by_cases h : w = v
  · subst w
    rw [ite_eq_left rfl, v.intValuation_singleton hx₀ hx]
  · rw [ite_eq_right h, HeightOneSpectrum.intValuation_eq_one_iff]
    intro hmem
    have hle : v.asIdeal ≤ w.asIdeal := hx ▸ (w.asIdeal.span_singleton_le_iff_mem.mpr hmem)
    exact h (HeightOneSpectrum.ext (v.isMaximal.eq_of_le w.isPrime.ne_top hle).symm)

end FiniteStages

/-! ## Secondary phases -/

/-- The squared angular phase of `1 + 4i` over the Gaussian field. -/
def quarticPhaseU : ℂ := ⟨161 / 289, -240 / 289⟩

/-- The angular phase of `3 + 2√(-2)` over the other quadratic field. -/
def quarticPhaseV : ℂ := ⟨1 / 17, (12 / 17) * Real.sqrt 2⟩

/-- The outside phase for the first choice of place over seventeen. -/
def quarticPhasePlus : ℂ := quarticPhaseU * quarticPhaseV

/-- The outside phase for the second choice of place over seventeen. -/
def quarticPhaseMinus : ℂ := quarticPhaseU / quarticPhaseV

theorem quarticPhaseU_eq :
    quarticPhaseU = ((1 + 4 * Complex.I) / (1 - 4 * Complex.I)) ^ 2 := by
  apply Complex.ext <;>
    norm_num [quarticPhaseU, pow_two, Complex.mul_re, Complex.mul_im, Complex.div_re,
      Complex.div_im, Complex.normSq_apply]

theorem quarticPhaseV_eq :
    quarticPhaseV = (3 + 2 * (Real.sqrt 2 : ℂ) * Complex.I) /
      (3 - 2 * (Real.sqrt 2 : ℂ) * Complex.I) := by
  have hd : (3 - 2 * (Real.sqrt 2 : ℂ) * Complex.I) ≠ 0 := by
    intro h
    have hRe := congrArg Complex.re h
    norm_num [Complex.mul_re] at hRe
  apply (eq_div_iff hd).2
  apply Complex.ext
  · norm_num [quarticPhaseV, Complex.mul_re, Complex.mul_im]
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
  · norm_num [quarticPhaseV, Complex.mul_re, Complex.mul_im]
    ring

theorem norm_quarticPhaseU : ‖quarticPhaseU‖ = 1 := by
  have hs : Complex.normSq quarticPhaseU = 1 := by
    norm_num [quarticPhaseU, Complex.normSq_apply]
  rw [Complex.normSq_eq_norm_sq] at hs
  nlinarith [norm_nonneg quarticPhaseU]

theorem norm_quarticPhaseV : ‖quarticPhaseV‖ = 1 := by
  have hs : Complex.normSq quarticPhaseV = 1 := by
    norm_num [quarticPhaseV, Complex.normSq_apply]
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
  rw [Complex.normSq_eq_norm_sq] at hs
  nlinarith [norm_nonneg quarticPhaseV]

theorem norm_quarticPhasePlus : ‖quarticPhasePlus‖ = 1 := by
  simp [quarticPhasePlus, norm_quarticPhaseU, norm_quarticPhaseV]

theorem norm_quarticPhaseMinus : ‖quarticPhaseMinus‖ = 1 := by
  simp [quarticPhaseMinus, norm_quarticPhaseU, norm_quarticPhaseV]

private theorem no_positive_pow_eq_one_of_trace {z : ℂ} (q : ℚ)
    (htrace : z + conj z = (q : ℂ)) (hden : ¬∃ k : ℤ, (k : ℚ) = q) {n : ℕ} (hn : n ≠ 0)
    (h : z ^ n = 1) : False := by
  have hz : IsIntegral ℤ z := IsIntegral.of_pow (Nat.pos_of_ne_zero hn) (h ▸ isIntegral_one)
  have hConj : (conj z) ^ n = 1 := by
    simpa only [map_pow, map_one] using congrArg (starRingEnd ℂ) h
  have hzConj : IsIntegral ℤ (conj z) :=
    IsIntegral.of_pow (Nat.pos_of_ne_zero hn) (hConj ▸ isIntegral_one)
  have hsum := hz.add hzConj
  obtain ⟨k, hk⟩ := hsum.mem_range_ratCast_iff.mp ⟨q, htrace.symm⟩
  have heq : (k : ℚ) = q := Rat.cast_injective (by push_cast; exact hk.trans htrace)
  exact hden ⟨k, heq⟩

private theorem zpow_eq_one_of_nonintegral_trace {z : ℂ} {q : ℚ}
    (htrace : z + conj z = (q : ℂ)) (hden : ¬∃ k : ℤ, (k : ℚ) = q) {m : ℤ}
    (hm : z ^ m = 1) : m = 0 := by
  cases m with
  | ofNat m =>
    by_contra hzero
    exact no_positive_pow_eq_one_of_trace _ htrace hden (n := m) (by simpa using hzero)
      (by simpa using hm)
  | negSucc m =>
    exact (no_positive_pow_eq_one_of_trace _ htrace hden (Nat.succ_ne_zero m)
      (by simpa [zpow_negSucc] using congrArg Inv.inv hm)).elim

private theorem quarticPhaseU_zpow_eq_one {m : ℤ} (hm : quarticPhaseU ^ m = 1) : m = 0 := by
  have htrace : quarticPhaseU + conj quarticPhaseU = ((322 / 289 : ℚ) : ℂ) := by
    apply Complex.ext <;> norm_num [quarticPhaseU]
  apply zpow_eq_one_of_nonintegral_trace htrace _ hm
  rintro ⟨k, hk⟩
  have he : k * 289 = 322 := by
    exact_mod_cast (eq_div_iff (by norm_num : (289 : ℚ) ≠ 0)).mp hk
  omega

private theorem quarticPhaseV_zpow_eq_one {m : ℤ} (hm : quarticPhaseV ^ m = 1) : m = 0 := by
  have htrace : quarticPhaseV + conj quarticPhaseV = ((2 / 17 : ℚ) : ℂ) := by
    apply Complex.ext <;> norm_num [quarticPhaseV]
  apply zpow_eq_one_of_nonintegral_trace htrace _ hm
  rintro ⟨k, hk⟩
  have he : k * 17 = 2 := by
    exact_mod_cast (eq_div_iff (by norm_num : (17 : ℚ) ≠ 0)).mp hk
  omega

private def QuadraticCoordinates (d : ℝ) (z : ℂ) : Prop :=
  ∃ a b : ℚ, z.re = a ∧ z.im = (b : ℝ) * d

private theorem QuadraticCoordinates.mul {d : ℝ} {D : ℚ} (hd : d * d = (D : ℝ))
    {z w : ℂ} (hz : QuadraticCoordinates d z) (hw : QuadraticCoordinates d w) :
    QuadraticCoordinates d (z * w) := by
  obtain ⟨a, b, hza, hzb⟩ := hz
  obtain ⟨c, e, hwc, hwe⟩ := hw
  refine ⟨a * c - b * e * D, a * e + b * c, ?_, ?_⟩
  · simp only [Complex.mul_re, hza, hzb, hwc, hwe, Rat.cast_sub, Rat.cast_mul]
    rw [← hd]
    ring
  · simp only [Complex.mul_im, hza, hzb, hwc, hwe, Rat.cast_add, Rat.cast_mul]
    ring

private theorem QuadraticCoordinates.zpow {d : ℝ} {D : ℚ} (hd : d * d = (D : ℝ))
    {z : ℂ} (hz : QuadraticCoordinates d z) (hnorm : ‖z‖ = 1) (m : ℤ) :
    QuadraticCoordinates d (z ^ m) := by
  have hpow (n : ℕ) : QuadraticCoordinates d (z ^ n) := by
    induction n with
    | zero => exact ⟨1, 0, by simp, by simp⟩
    | succ n hk => simpa only [pow_succ] using hk.mul hd hz
  cases m with
  | ofNat m => simpa using hpow m
  | negSucc m =>
    rw [zpow_negSucc, Complex.inv_eq_conj (by simp [norm_pow, hnorm])]
    obtain ⟨a, b, ha, hb⟩ := hpow (m + 1)
    exact ⟨a, -b, by rw [Complex.conj_re, ha], by rw [Complex.conj_im, hb, Rat.cast_neg, neg_mul]⟩

private theorem quarticPhaseU_coords : QuadraticCoordinates 1 quarticPhaseU :=
  ⟨161 / 289, -240 / 289, by norm_num [quarticPhaseU], by norm_num [quarticPhaseU]⟩

private theorem quarticPhaseV_coords : QuadraticCoordinates (Real.sqrt 2) quarticPhaseV :=
  ⟨1 / 17, 12 / 17, by norm_num [quarticPhaseV], by norm_num [quarticPhaseV]⟩

private theorem phase_zpow_sq_eq_one_of_im_eq_zero {z : ℂ} (hz : ‖z‖ = 1) {m : ℤ}
    (him : (z ^ m).im = 0) : z ^ (m * 2) = 1 := by
  have hnorm : ‖z ^ m‖ = 1 := by simp [norm_zpow, hz]
  have hinv : (z ^ m)⁻¹ = z ^ m := by
    rw [Complex.inv_eq_conj hnorm]
    exact Complex.ext (Complex.conj_re _) (by rw [Complex.conj_im, him, neg_zero])
  have hz₀ : z ^ m ≠ 0 := by intro h; simp [h] at hnorm
  have hz' : z ≠ 0 := by intro h; simp [h] at hz
  rw [show m * 2 = m + m by omega, zpow_add₀ hz']
  calc
    z ^ m * z ^ m = z ^ m * (z ^ m)⁻¹ := congrArg (_ * ·) hinv.symm
    _ = 1 := mul_inv_cancel₀ hz₀

private theorem quarticPhaseU_zpow_eq_quarticPhaseV_zpow {m n : ℤ}
    (h : quarticPhaseU ^ m = quarticPhaseV ^ n) : m = 0 ∧ n = 0 := by
  obtain ⟨_, b, _, hUb⟩ := quarticPhaseU_coords.zpow (D := 1) (by norm_num) norm_quarticPhaseU m
  obtain ⟨_, d, _, hVd⟩ := quarticPhaseV_coords.zpow (D := 2)
    (by rw [← pow_two]; simp) norm_quarticPhaseV n
  have him : (b : ℝ) = (d : ℝ) * Real.sqrt 2 := by simpa [hVd] using hUb.symm.trans (congrArg Complex.im h)
  have hd : d = 0 := by
    by_contra hd
    have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd
    exact irrational_sqrt_two ⟨b / d, by
      push_cast
      exact (div_eq_iff hd').2 (by rw [him, mul_comm])⟩
  have hVim : (quarticPhaseV ^ n).im = 0 := by simp [hVd, hd]
  have hUim : (quarticPhaseU ^ m).im = 0 := by rw [h, hVim]
  have hm := quarticPhaseU_zpow_eq_one (phase_zpow_sq_eq_one_of_im_eq_zero norm_quarticPhaseU hUim)
  have hn := quarticPhaseV_zpow_eq_one (phase_zpow_sq_eq_one_of_im_eq_zero norm_quarticPhaseV hVim)
  omega

/-- The two outside phases over seventeen are multiplicatively independent. -/
theorem quarticPhases_independent (m n : ℤ)
    (h : quarticPhasePlus ^ m * quarticPhaseMinus ^ n = 1) : m = 0 ∧ n = 0 := by
  have hU : quarticPhaseU ≠ 0 := norm_ne_zero_iff.mp (by rw [norm_quarticPhaseU]; exact one_ne_zero)
  have hV : quarticPhaseV ≠ 0 := norm_ne_zero_iff.mp (by rw [norm_quarticPhaseV]; exact one_ne_zero)
  simp only [quarticPhasePlus, quarticPhaseMinus, mul_zpow, div_zpow] at h
  have he : quarticPhaseU ^ (m + n) = quarticPhaseV ^ (n - m) := by
    rw [zpow_add₀ hU, zpow_sub₀ hV]
    apply (eq_div_iff (zpow_ne_zero _ hV)).2
    calc
      quarticPhaseU ^ m * quarticPhaseU ^ n * quarticPhaseV ^ m =
          quarticPhaseU ^ m * quarticPhaseV ^ m *
            (quarticPhaseU ^ n / quarticPhaseV ^ n) * quarticPhaseV ^ n := by
            field_simp [zpow_ne_zero n hV]
      _ = quarticPhaseV ^ n := by rw [h, one_mul]
  obtain ⟨hm, hn⟩ := quarticPhaseU_zpow_eq_quarticPhaseV_zpow he
  omega

private theorem algebraic_quarticPhaseU : IsAlgebraic ℚ quarticPhaseU := by
  rw [quarticPhaseU_eq]
  have hi := (Complex.isIntegral_I ℚ).isAlgebraic
  have haux := (isAlgebraic_algebraMap (4 : ℚ)).mul hi
  simpa [div_eq_mul_inv] using
    (((isAlgebraic_algebraMap (1 : ℚ)).add haux).mul
      ((isAlgebraic_algebraMap (1 : ℚ)).sub haux).inv).pow 2

private theorem algebraic_quarticPhaseV : IsAlgebraic ℚ quarticPhaseV := by
  rw [quarticPhaseV_eq]
  have hi := (Complex.isIntegral_I ℚ).isAlgebraic
  have hs : IsAlgebraic ℚ (Real.sqrt 2 : ℂ) := by
    apply IsAlgebraic.of_pow (n := 2) (by decide)
    rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    exact isAlgebraic_algebraMap (2 : ℚ)
  have haux := ((isAlgebraic_algebraMap (2 : ℚ)).mul hs).mul hi
  simpa [div_eq_mul_inv] using
    ((isAlgebraic_algebraMap (3 : ℚ)).add haux).mul ((isAlgebraic_algebraMap (3 : ℚ)).sub haux).inv

theorem algebraic_quarticPhasePlus : IsAlgebraic ℚ quarticPhasePlus :=
  algebraic_quarticPhaseU.mul algebraic_quarticPhaseV

theorem algebraic_quarticPhaseMinus : IsAlgebraic ℚ quarticPhaseMinus := by
  simpa [quarticPhaseMinus, div_eq_mul_inv] using algebraic_quarticPhaseU.mul algebraic_quarticPhaseV.inv

/-! ## Complex embeddings and the phases of the prime generators -/

section Embeddings

open IsCyclotomicExtension Polynomial

local instance quarticCyclotomic : IsCyclotomicExtension {8} ℚ F₈ :=
  CyclotomicField.isCyclotomicExtension 8 ℚ

local notation "ζ" => (zeta 8 ℚ F₈)


/-- The first-quadrant primitive eighth root of unity. -/
def complexEighthRoot : ℂ := ⟨Real.sqrt 2 / 2, Real.sqrt 2 / 2⟩

private theorem complexEighthRoot_sq : complexEighthRoot ^ 2 = Complex.I := by
  apply Complex.ext
  · simp [complexEighthRoot, pow_two, Complex.mul_re]
  · norm_num [complexEighthRoot, pow_two, Complex.mul_im]
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]

private theorem complexEighthRoot_fourth : complexEighthRoot ^ 4 = -1 := by
  rw [show (4 : ℕ) = 2 * 2 by decide, pow_mul, complexEighthRoot_sq, Complex.I_sq]

private theorem complexEighthRoot_add_cube :
    complexEighthRoot + complexEighthRoot ^ 3 = (Real.sqrt 2 : ℂ) * Complex.I := by
  rw [show (3 : ℕ) = 2 + 1 by decide, pow_succ, complexEighthRoot_sq]
  apply Complex.ext
  · norm_num [complexEighthRoot, Complex.mul_re]
  · norm_num [complexEighthRoot, Complex.mul_im]

private theorem cyclotomic_eight_rat : cyclotomic 8 ℚ = X ^ 4 + 1 := by
  rw [show (8 : ℕ) = 2 ^ (2 + 1) by decide,
    cyclotomic_prime_pow_eq_geom_sum (by decide : Nat.Prime 2)]
  norm_num [Finset.sum_range_succ]
  ring

private def quarticEmbeddingOfRoot (x : ℂ) (hx : x ^ 4 = -1) : F₈ →ₐ[ℚ] ℂ :=
  ((zeta_spec 8 ℚ F₈).powerBasis ℚ).lift x (by
    rw [(zeta_spec 8 ℚ F₈).powerBasis_gen ℚ,
      ← (zeta_spec 8 ℚ F₈).minpoly_eq_cyclotomic_of_irreducible
        (cyclotomic.irreducible_rat (by decide)), cyclotomic_eight_rat]
    simp [hx])

private theorem quarticEmbeddingOfRoot_zeta (x : ℂ) (hx : x ^ 4 = -1) :
    quarticEmbeddingOfRoot x hx ζ = x := by
  calc
    quarticEmbeddingOfRoot x hx ζ =
        quarticEmbeddingOfRoot x hx ((zeta_spec 8 ℚ F₈).powerBasis ℚ).gen :=
      congrArg (quarticEmbeddingOfRoot x hx) ((zeta_spec 8 ℚ F₈).powerBasis_gen ℚ).symm
    _ = x := PowerBasis.lift_gen _ _ _

/-- The archimedean embedding taking the chosen eighth root to the first-quadrant root. -/
@[no_expose] def quarticEmbeddingOne : F₈ →ₐ[ℚ] ℂ :=
  quarticEmbeddingOfRoot _ complexEighthRoot_fourth

/-- The archimedean embedding taking the chosen eighth root to its cube. -/
@[no_expose] def quarticEmbeddingThree : F₈ →ₐ[ℚ] ℂ :=
  quarticEmbeddingOfRoot (complexEighthRoot ^ 3) (by
    rw [← pow_mul, Nat.mul_comm, pow_mul, complexEighthRoot_fourth]
    norm_num)

/-- The two archimedean embeddings give opposite images of the Gaussian generator. -/
theorem quarticEmbeddings_gaussian :
    quarticEmbeddingOne (ζ ^ 2) = Complex.I ∧
      quarticEmbeddingThree (ζ ^ 2) = -Complex.I := by
  rw [map_pow, map_pow, quarticEmbeddingOne, quarticEmbeddingThree,
    quarticEmbeddingOfRoot_zeta, quarticEmbeddingOfRoot_zeta, complexEighthRoot_sq, ← pow_mul,
    show (3 : ℕ) * 2 = 4 + 2 by decide, pow_add, complexEighthRoot_fourth,
    complexEighthRoot_sq, neg_one_mul]
  exact ⟨rfl, rfl⟩

/-- The same two embeddings agree on the generator of the other quadratic subfield. -/
theorem quarticEmbeddings_negativeTwo :
    quarticEmbeddingOne (ζ + ζ ^ 3) = (Real.sqrt 2 : ℂ) * Complex.I ∧
      quarticEmbeddingThree (ζ + ζ ^ 3) = (Real.sqrt 2 : ℂ) * Complex.I := by
  have h8 : complexEighthRoot ^ 8 = 1 := by
    rw [show (8 : ℕ) = 4 * 2 by decide, pow_mul, complexEighthRoot_fourth]
    norm_num
  have h9 : complexEighthRoot ^ 9 = complexEighthRoot := by
    rw [show (9 : ℕ) = 8 + 1 by decide, pow_succ, h8, one_mul]
  rw [map_add, map_add, map_pow, map_pow, quarticEmbeddingOne, quarticEmbeddingThree,
    quarticEmbeddingOfRoot_zeta, quarticEmbeddingOfRoot_zeta, ← pow_mul,
    show (3 : ℕ) * 3 = 9 by decide, h9, add_comm (complexEighthRoot ^ 3),
    complexEighthRoot_add_cube]
  exact ⟨rfl, rfl⟩

/-- The two chosen quadratic generators above seventeen and their conjugates
have products equal to seventeen. -/
theorem quarticGenerator_products :
    (1 + 4 * ζ ^ 2) * (1 - 4 * ζ ^ 2) = (17 : F₈) ∧
    (3 + 2 * (ζ + ζ ^ 3)) * (3 - 2 * (ζ + ζ ^ 3)) = (17 : F₈) := by
  constructor <;> apply quarticEmbeddingOne.injective
  · rw [map_mul, map_add, map_sub]
    simp only [map_mul, map_one, map_ofNat]
    change (1 + 4 * quarticEmbeddingOne (ζ ^ 2)) * (1 - 4 * quarticEmbeddingOne (ζ ^ 2)) = 17
    rw [quarticEmbeddings_gaussian.1]
    linear_combination -16 * Complex.I_sq
  · rw [map_mul, map_add, map_sub]
    simp only [map_mul, map_ofNat]
    change (3 + 2 * quarticEmbeddingOne (ζ + ζ ^ 3)) *
      (3 - 2 * quarticEmbeddingOne (ζ + ζ ^ 3)) = 17
    rw [quarticEmbeddings_negativeTwo.1]
    have hs : (Real.sqrt 2 : ℂ) ^ 2 = 2 := by
      rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
      norm_num
    linear_combination -4 * (Real.sqrt 2 : ℂ) ^ 2 * Complex.I_sq + 4 * hs

/-- The explicit Gaussian phase is the image of the quotient of the two generators
in the quartic field. -/
theorem quarticPhaseU_eq_embedding :
    quarticPhaseU = quarticEmbeddingOne (((1 + 4 * ζ ^ 2) / (1 - 4 * ζ ^ 2)) ^ 2) := by
  rw [quarticPhaseU_eq, map_pow, map_div₀ quarticEmbeddingOne, map_add, map_sub]
  simp only [map_one, map_mul, map_ofNat]
  change _ = (((1 + 4 * quarticEmbeddingOne (ζ ^ 2)) /
    (1 - 4 * quarticEmbeddingOne (ζ ^ 2))) ^ 2)
  rw [quarticEmbeddings_gaussian.1]

/-- The explicit phase over the other subfield is the image of its corresponding
quotient in the quartic field. -/
theorem quarticPhaseV_eq_embedding :
    quarticPhaseV = quarticEmbeddingOne
      ((3 + 2 * (ζ + ζ ^ 3)) / (3 - 2 * (ζ + ζ ^ 3))) := by
  rw [quarticPhaseV_eq, map_div₀ quarticEmbeddingOne, map_add, map_sub]
  simp only [map_mul, map_ofNat]
  change _ = ((3 + 2 * quarticEmbeddingOne (ζ + ζ ^ 3)) /
    (3 - 2 * quarticEmbeddingOne (ζ + ζ ^ 3)))
  rw [quarticEmbeddings_negativeTwo.1]
  simp only [mul_assoc]

theorem quarticEmbeddingOne_zeta :
    quarticEmbeddingOne ζ = complexEighthRoot :=
  quarticEmbeddingOfRoot_zeta _ _

theorem quarticEmbeddingThree_zeta :
    quarticEmbeddingThree ζ = complexEighthRoot ^ 3 :=
  quarticEmbeddingOfRoot_zeta _ _

open NumberField

/-- The embeddings define genuinely different complex places of the quartic field. -/
theorem quarticEmbedding_places :
    let w₁ := InfinitePlace.mk quarticEmbeddingOne.toRingHom
    let w₃ := InfinitePlace.mk quarticEmbeddingThree.toRingHom
    w₁.IsComplex ∧ w₃.IsComplex ∧ w₁ ≠ w₃ := by
  have hn1 : ¬ ComplexEmbedding.IsReal quarticEmbeddingOne.toRingHom := by
    intro h
    have he := congrArg (fun f : F₈ →+* ℂ => f (ζ ^ 2))
      (ComplexEmbedding.isReal_iff.mp h)
    change star (quarticEmbeddingOne (ζ ^ 2)) = quarticEmbeddingOne (ζ ^ 2) at he
    rw [quarticEmbeddings_gaussian.1] at he
    have hh := congrArg Complex.im he
    norm_num at hh
  have hn3 : ¬ ComplexEmbedding.IsReal quarticEmbeddingThree.toRingHom := by
    intro h
    have he := congrArg (fun f : F₈ →+* ℂ => f (ζ ^ 2))
      (ComplexEmbedding.isReal_iff.mp h)
    change star (quarticEmbeddingThree (ζ ^ 2)) = quarticEmbeddingThree (ζ ^ 2) at he
    rw [quarticEmbeddings_gaussian.2] at he
    have hh := congrArg Complex.im he
    norm_num at hh
  refine ⟨InfinitePlace.isComplex_mk_iff.mpr hn1, InfinitePlace.isComplex_mk_iff.mpr hn3, ?_⟩
  intro h
  rcases InfinitePlace.mk_eq_iff.mp h with h13 | h13
  · have he := congrArg (fun f : F₈ →+* ℂ => f (ζ ^ 2)) h13
    change quarticEmbeddingOne (ζ ^ 2) = quarticEmbeddingThree (ζ ^ 2) at he
    rw [quarticEmbeddings_gaussian.1, quarticEmbeddings_gaussian.2] at he
    have hh := congrArg Complex.im he
    norm_num at hh
  · have he := congrArg (fun f : F₈ →+* ℂ => f (ζ + ζ ^ 3)) h13
    change star (quarticEmbeddingOne (ζ + ζ ^ 3)) = quarticEmbeddingThree (ζ + ζ ^ 3) at he
    rw [quarticEmbeddings_negativeTwo.1, quarticEmbeddings_negativeTwo.2] at he
    have hh := congrArg Complex.im he
    norm_num [Complex.mul_im] at hh
    exact (Real.sqrt_pos.2 (by norm_num : (0 : ℝ) < 2)).ne' (by linarith)

/-- The quotient of a complex number by its conjugate, used for the angular type
in the quartic example. -/
def quarticAngularRatio (z : ℂ) : ℂ := z / star z

private theorem quarticAngularRatio_mul (a b : ℂ) :
    quarticAngularRatio (a * b) = quarticAngularRatio a * quarticAngularRatio b := by
  simp only [quarticAngularRatio, star_mul, div_eq_mul_inv, mul_inv_rev]
  ac_rfl

private theorem quarticAngularRatio_div (a b : ℂ) :
    quarticAngularRatio a / quarticAngularRatio b = quarticAngularRatio (a * star b) := by
  simp only [quarticAngularRatio, star_mul, star_star, div_eq_mul_inv, mul_inv_rev, inv_inv]
  ring

private theorem complexEighthRoot_conj_cube :
    star (complexEighthRoot ^ 3) = -complexEighthRoot := by
  rw [show (3 : ℕ) = 2 + 1 by decide, pow_succ, complexEighthRoot_sq]
  apply Complex.ext <;> norm_num [complexEighthRoot, Complex.mul_re, Complex.mul_im]

private theorem quarticAngularRatio_gaussian :
    quarticAngularRatio (4 - Complex.I) ^ 2 = quarticPhaseU := by
  rw [quarticPhaseU_eq]
  have h₁ : (4 + Complex.I) ≠ 0 := by
    intro h
    have hh := congrArg Complex.re h
    norm_num at hh
  have h₂ : (1 - 4 * Complex.I) ≠ 0 := by
    intro h
    have hh := congrArg Complex.re h
    norm_num [Complex.mul_re] at hh
  have h : (4 - Complex.I) / (4 + Complex.I) = -((1 + 4 * Complex.I) / (1 - 4 * Complex.I)) := by
    field_simp
    linear_combination 8 * Complex.I_sq
  unfold quarticAngularRatio
  rw [show star (4 - Complex.I) = 4 + Complex.I by simp, h, neg_sq]

private theorem negativeTwoGenerator_conj :
    star (3 + 2 * ((Real.sqrt 2 : ℂ) * Complex.I)) =
      (3 - 2 * ((Real.sqrt 2 : ℂ) * Complex.I)) := by
  simp [star_mul, mul_assoc, sub_eq_add_neg]
  ring

private theorem quarticAngularRatio_negativeTwo :
    quarticAngularRatio (3 + 2 * ((Real.sqrt 2 : ℂ) * Complex.I)) = quarticPhaseV := by
  rw [quarticPhaseV_eq, quarticAngularRatio, negativeTwoGenerator_conj]
  simp only [mul_assoc]

private theorem quarticAngularRatio_negativeTwo_conj :
    quarticAngularRatio (3 - 2 * ((Real.sqrt 2 : ℂ) * Complex.I)) = quarticPhaseV⁻¹ := by
  rw [← quarticAngularRatio_negativeTwo, ← negativeTwoGenerator_conj]
  simp [quarticAngularRatio]
private theorem complexEighthRoot_norm : ‖complexEighthRoot‖ = 1 := by
  apply Complex.norm_eq_one_of_pow_eq_one (n := 8) _ (by decide)
  rw [show (8 : ℕ) = 4 * 2 by decide, pow_mul, complexEighthRoot_fourth]
  norm_num

private theorem quarticAngularRatio_two_add_sub_ne_zero (x : ℂ) (hx : ‖x‖ = 1) :
    quarticAngularRatio (2 + x) ≠ 0 ∧ quarticAngularRatio (2 - x) ≠ 0 := by
  have h₁ : 2 + x ≠ 0 := by
    intro h
    have hh : x = -2 := by linear_combination h
    rw [hh, norm_neg, Complex.norm_two] at hx
    norm_num at hx
  have h₂ : 2 - x ≠ 0 := by
    intro h
    rw [← sub_eq_zero.mp h, Complex.norm_two] at hx
    norm_num at hx
  exact ⟨div_ne_zero h₁ (star_ne_zero.mpr h₁), div_ne_zero h₂ (star_ne_zero.mpr h₂)⟩

private theorem quarticAngularRatio_cube_div (a b : ℂ) (hb : quarticAngularRatio b ≠ 0) :
    quarticAngularRatio a ^ 3 / quarticAngularRatio b =
      quarticAngularRatio (a * star b) ^ 2 * quarticAngularRatio (a * b) := by
  rw [← quarticAngularRatio_div, quarticAngularRatio_mul]
  field_simp

/-- Evaluation of the inverse archimedean angular type on the two generators
above seventeen. -/
theorem quarticAngularRatio_prime_generators :
    quarticAngularRatio (quarticEmbeddingOne (2 + ζ)) ^ 3 /
        quarticAngularRatio (quarticEmbeddingThree (2 + ζ)) = quarticPhasePlus ∧
    quarticAngularRatio (quarticEmbeddingOne (2 - ζ)) ^ 3 /
        quarticAngularRatio (quarticEmbeddingThree (2 - ζ)) = quarticPhaseMinus := by
  have hnorm : ‖complexEighthRoot ^ 3‖ = 1 := by simp [norm_pow, complexEighthRoot_norm]
  have hne := quarticAngularRatio_two_add_sub_ne_zero _ hnorm
  constructor
  · rw [map_add, map_add, map_ofNat, map_ofNat, quarticEmbeddingOne_zeta, quarticEmbeddingThree_zeta]
    rw [quarticAngularRatio_cube_div _ _ hne.1, star_add, star_ofNat, complexEighthRoot_conj_cube]
    rw [show (2 + complexEighthRoot) * (2 + -complexEighthRoot) = 4 - Complex.I by
      linear_combination -complexEighthRoot_sq, quarticAngularRatio_gaussian]
    rw [show (2 + complexEighthRoot) * (2 + complexEighthRoot ^ 3) =
        3 + 2 * ((Real.sqrt 2 : ℂ) * Complex.I) by
      linear_combination complexEighthRoot_fourth + 2 * complexEighthRoot_add_cube]
    rw [quarticAngularRatio_negativeTwo, quarticPhasePlus]
  · rw [map_sub, map_sub, map_ofNat, map_ofNat, quarticEmbeddingOne_zeta, quarticEmbeddingThree_zeta]
    rw [quarticAngularRatio_cube_div _ _ hne.2, star_sub, star_ofNat, complexEighthRoot_conj_cube]
    rw [show (2 - complexEighthRoot) * (2 - -complexEighthRoot) = 4 - Complex.I by
      linear_combination -complexEighthRoot_sq, quarticAngularRatio_gaussian]
    rw [show (2 - complexEighthRoot) * (2 - complexEighthRoot ^ 3) =
        3 - 2 * ((Real.sqrt 2 : ℂ) * Complex.I) by
      linear_combination complexEighthRoot_fourth - 2 * complexEighthRoot_add_cube]
    rw [quarticAngularRatio_negativeTwo_conj, quarticPhaseMinus, div_eq_mul_inv]

private theorem complexEighthRoot_sub_cube :
    complexEighthRoot - complexEighthRoot ^ 3 = (Real.sqrt 2 : ℂ) := by
  rw [show (3 : ℕ) = 2 + 1 by decide, pow_succ, complexEighthRoot_sq]
  apply Complex.ext <;> norm_num [complexEighthRoot, Complex.mul_re, Complex.mul_im]

private theorem quarticEmbeddings_positiveTwo :
    quarticEmbeddingOne (ζ - ζ ^ 3) = (Real.sqrt 2 : ℂ) ∧
      quarticEmbeddingThree (ζ - ζ ^ 3) = -(Real.sqrt 2 : ℂ) := by
  have h8 : complexEighthRoot ^ 8 = 1 := by
    rw [show (8 : ℕ) = 4 * 2 by decide, pow_mul, complexEighthRoot_fourth]
    norm_num
  have h9 : complexEighthRoot ^ 9 = complexEighthRoot := by
    rw [show (9 : ℕ) = 8 + 1 by decide, pow_succ, h8, one_mul]
  constructor
  · rw [map_sub, map_pow, quarticEmbeddingOne_zeta, complexEighthRoot_sub_cube]
  · rw [map_sub, map_pow, quarticEmbeddingThree_zeta, ← pow_mul,
      show (3 : ℕ) * 3 = 9 by decide, h9, ← neg_sub, complexEighthRoot_sub_cube]

/-- The inverse archimedean angular type is trivial on the two real generators
above seven. -/
theorem quarticAngularRatio_primary_generators :
    quarticAngularRatio (quarticEmbeddingOne (3 + (ζ - ζ ^ 3))) ^ 3 /
        quarticAngularRatio (quarticEmbeddingThree (3 + (ζ - ζ ^ 3))) = 1 ∧
    quarticAngularRatio (quarticEmbeddingOne (3 - (ζ - ζ ^ 3))) ^ 3 /
        quarticAngularRatio (quarticEmbeddingThree (3 - (ζ - ζ ^ 3))) = 1 := by
  have hs : Real.sqrt 2 < 3 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2), Real.sqrt_nonneg 2]
  have hp : (3 : ℂ) + ↑(Real.sqrt 2) ≠ 0 := by
    intro h
    have hh := congrArg Complex.re h
    norm_num at hh
    linarith [Real.sqrt_nonneg 2]
  have hm : (3 : ℂ) - ↑(Real.sqrt 2) ≠ 0 := by
    intro h
    have hh := congrArg Complex.re h
    norm_num at hh
    linarith
  have haa : quarticAngularRatio (3 + (Real.sqrt 2 : ℂ)) = 1 := by
    simp [quarticAngularRatio, hp]
  have hss : quarticAngularRatio (3 - (Real.sqrt 2 : ℂ)) = 1 := by
    simp [quarticAngularRatio, hm]
  constructor
  · rw [map_add, map_add, map_ofNat, map_ofNat,
      quarticEmbeddings_positiveTwo.1, quarticEmbeddings_positiveTwo.2, ← sub_eq_add_neg, haa, hss]
    norm_num
  · rw [map_sub quarticEmbeddingOne, map_sub quarticEmbeddingThree, map_ofNat, map_ofNat,
      quarticEmbeddings_positiveTwo.1, quarticEmbeddings_positiveTwo.2, sub_neg_eq_add, haa, hss]
    norm_num

local notation "ζ₀" => (IsPrimitiveRoot.toInteger (zeta_spec 8 ℚ F₈))

private theorem quarticAltRoot_product :
    (3 + (ζ₀ - ζ₀ ^ 3)) * (3 - (ζ₀ - ζ₀ ^ 3)) = (7 : 𝓞 F₈) := by
  apply (IsFractionRing.injective (𝓞 F₈) F₈)
  apply quarticEmbeddingOne.injective
  simp only [map_mul, map_ofNat, map_add, map_sub, map_pow]
  have he := quarticEmbeddings_positiveTwo.1
  rw [map_sub, map_pow] at he
  change (3 + (quarticEmbeddingOne ζ - quarticEmbeddingOne ζ ^ 3)) *
    (3 - (quarticEmbeddingOne ζ - quarticEmbeddingOne ζ ^ 3)) = 7
  rw [he]
  have hs : (Real.sqrt 2 : ℂ) ^ 2 = 2 := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  linear_combination -hs

private theorem quarticAltRoot_norms_eq :
    Algebra.norm ℤ (3 + (ζ₀ - ζ₀ ^ 3)) = Algebra.norm ℤ (3 - (ζ₀ - ζ₀ ^ 3)) := by
  apply Int.cast_injective (α := ℚ)
  rw [Algebra.coe_norm_int, Algebra.coe_norm_int]
  change Algebra.norm ℚ (3 + (ζ - ζ ^ 3)) = Algebra.norm ℚ (3 - (ζ - ζ ^ 3))
  let t : (ZMod 8)ˣ := Units.mkOfMulEqOne 3 3 (by decide)
  let hirr := cyclotomic.irreducible_rat (n := 8) (by decide)
  let e := (autEquivPow F₈ hirr).symm t
  have hz : e ζ = ζ ^ 3 := autEquivPow_symm_apply_zeta F₈ hirr t
  have h9 : ζ ^ 9 = ζ := by
    rw [show (9 : ℕ) = 8 + 1 by decide, pow_succ, (zeta_spec 8 ℚ F₈).pow_eq_one, one_mul]
  have he : e (3 + (ζ - ζ ^ 3)) = 3 - (ζ - ζ ^ 3) := by
    rw [map_add, map_ofNat, map_sub, map_pow, hz, ← pow_mul,
      show (3 : ℕ) * 3 = 9 by decide, h9]
    ring
  rw [← he, Algebra.norm_eq_of_algEquiv]

/-- The generators of the two prime ideals above seven have absolute norm forty-nine. -/
theorem quarticPrimaryGenerator_norms :
    (Ideal.span ({3 + (ζ₀ - ζ₀ ^ 3)} : Set (𝓞 F₈))).absNorm = 49 ∧
    (Ideal.span ({3 - (ζ₀ - ζ₀ ^ 3)} : Set (𝓞 F₈))).absNorm = 49 := by
  have hrank : Module.finrank ℤ (𝓞 F₈) = 4 := by
    rw [RingOfIntegers.rank, IsCyclotomicExtension.Rat.finrank 8 F₈]
    decide
  have hmul : Algebra.norm ℤ (3 + (ζ₀ - ζ₀ ^ 3)) *
      Algebra.norm ℤ (3 - (ζ₀ - ζ₀ ^ 3)) = 2401 := by
    rw [← map_mul, quarticAltRoot_product]
    simpa [hrank] using (Algebra.norm_natCast (R := ℤ) (S := 𝓞 F₈) 7)
  have h := congrArg Int.natAbs hmul
  rw [← quarticAltRoot_norms_eq, Int.natAbs_mul, ← pow_two] at h
  have h' : (Algebra.norm ℤ (3 + (ζ₀ - ζ₀ ^ 3))).natAbs = 49 :=
    Nat.pow_left_injective (by decide : (2 : ℕ) ≠ 0) h
  simpa only [Ideal.absNorm_span_singleton, ← quarticAltRoot_norms_eq] using And.intro h' h'

private theorem quarticPrimarySpan_mem_primesOver (g : 𝓞 F₈)
    (hnorm : (Ideal.span {g}).absNorm = 49)
    (hseven : (7 : 𝓞 F₈) ∈ Ideal.span {g})
    (hQnorm : ∀ Q ∈ (Ideal.span {(7 : ℤ)}).primesOver (𝓞 F₈), Q.absNorm = 49) :
    Ideal.span {g} ∈ (Ideal.span {(7 : ℤ)}).primesOver (𝓞 F₈) := by
  let P : Ideal ℤ := Ideal.span {(7 : ℤ)}
  let I : Ideal (𝓞 F₈) := Ideal.span {g}
  have hproper : I ≠ ⊤ := by
    intro h
    change I.absNorm = 49 at hnorm
    rw [h, Ideal.absNorm_top] at hnorm
    omega
  obtain ⟨M, hM, hIM⟩ := I.exists_le_maximal hproper
  have : Fact (Nat.Prime 7) := ⟨by decide⟩
  have hP : P.IsMaximal := Int.ideal_span_isMaximal_of_prime 7
  have hPM : P ≤ M.comap (algebraMap ℤ (𝓞 F₈)) := by
    apply (Ideal.span_singleton_le_iff_mem _).mpr
    change (algebraMap ℤ (𝓞 F₈)) 7 ∈ M
    simp only [map_ofNat]
    exact hIM hseven
  have hcomap : P = M.comap (algebraMap ℤ (𝓞 F₈)) :=
    ((IsCoatom.le_iff_eq hP.out (Ideal.comap_ne_top _ hM.ne_top)).mp hPM).symm
  have hM' : M ∈ P.primesOver (𝓞 F₈) := ⟨hM.isPrime, ⟨hcomap⟩⟩
  have hMnorm := hQnorm M hM'
  obtain ⟨J, hJ⟩ := Ideal.dvd_iff_le.mpr hIM
  have hJnorm : J.absNorm = 1 := by
    have hx := congrArg Ideal.absNorm hJ
    rw [map_mul, hMnorm] at hx
    change I.absNorm = 49 at hnorm
    rw [hnorm] at hx
    omega
  rw [Ideal.absNorm_eq_one_iff.mp hJnorm, Ideal.mul_top] at hJ
  change I ∈ P.primesOver (𝓞 F₈)
  rwa [hJ]

/-- The explicit real generators give the two distinct places above seven. -/
theorem quarticPrimaryGenerator_ideals :
    let P := (Ideal.span {(7 : ℤ)}).primesOver (𝓞 F₈)
    let I : Ideal (𝓞 F₈) := Ideal.span {3 + (ζ₀ - ζ₀ ^ 3)}
    let J : Ideal (𝓞 F₈) := Ideal.span {3 - (ζ₀ - ζ₀ ^ 3)}
    I ∈ P ∧ J ∈ P ∧ I ≠ J := by
  dsimp only
  let a : 𝓞 F₈ := 3 + (ζ₀ - ζ₀ ^ 3)
  let b : 𝓞 F₈ := 3 - (ζ₀ - ζ₀ ^ 3)
  have hab : a * b = 7 := quarticAltRoot_product
  have ha : (7 : 𝓞 F₈) ∈ Ideal.span {a} :=
    Ideal.mem_span_singleton.mpr ⟨b, hab.symm⟩
  have hb : (7 : 𝓞 F₈) ∈ Ideal.span {b} :=
    Ideal.mem_span_singleton.mpr ⟨a, (mul_comm b a).trans hab |>.symm⟩
  have hQnorm := quarticBenchmark_primes_over_seven.2
  have hI := quarticPrimarySpan_mem_primesOver a quarticPrimaryGenerator_norms.1 ha hQnorm
  have hJ := quarticPrimarySpan_mem_primesOver b quarticPrimaryGenerator_norms.2 hb hQnorm
  refine ⟨hI, hJ, ?_⟩
  change Ideal.span {a} ≠ Ideal.span {b}
  intro heq
  have ha' : a ∈ Ideal.span {a} := Ideal.mem_span_singleton_self a
  have hb' : b ∈ Ideal.span {a} := heq ▸ Ideal.mem_span_singleton_self b
  have h6 : (6 : 𝓞 F₈) ∈ Ideal.span {a} := by
    have h6' := (Ideal.span {a}).add_mem ha' hb'
    have hab6 : a + b = 6 := by dsimp [a, b]; ring
    rwa [hab6] at h6'
  have h1 : (1 : 𝓞 F₈) ∈ Ideal.span {a} := by
    have h := (Ideal.span {a}).sub_mem ha h6
    norm_num at h
    exact h
  exact hI.1.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

end Embeddings

/-! ## The global angular character -/

section GlobalCharacter

local instance quarticBenchmark_isCyclotomicExtension : IsCyclotomicExtension {8} ℚ F₈ :=
  CyclotomicField.isCyclotomicExtension 8 ℚ

private theorem quarticBenchmark_complex_conjugation :
    ∃ c : F₈ →+* F₈, ∀ (e : F₈ →+* ℂ) x, e (c x) = star (e x) := by
  let ζ := IsCyclotomicExtension.zeta 8 ℚ F₈
  have hζ : IsPrimitiveRoot ζ 8 := IsCyclotomicExtension.zeta_spec 8 ℚ F₈
  let t : (ZMod 8)ˣ := ZMod.unitOfCoprime 7 (by decide)
  let c := (IsCyclotomicExtension.autEquivPow F₈ (Polynomial.cyclotomic.irreducible_rat
    (by decide : 0 < 8))).symm t
  have hc : c ζ = ζ ^ 7 :=
    IsCyclotomicExtension.autEquivPow_symm_apply_zeta F₈ _ t
  refine ⟨c.toRingHom, fun e x ↦ ?_⟩
  have he := hζ.map_of_injective e.injective
  have hh : e (c ζ) = star (e ζ) := by
    rw [hc, map_pow]
    apply mul_left_cancel₀ (he.ne_zero (by decide))
    rw [← pow_succ', he.pow_eq_one]
    change (1 : ℂ) = e ζ * (starRingEnd ℂ) (e ζ)
    rw [RCLike.mul_conj, he.norm'_eq_one (by decide)]
    simp
  have hconj : e.toRatAlgHom.comp c.toAlgHom =
      (starRingEnd ℂ).toRatAlgHom.comp e.toRatAlgHom := by
    apply (hζ.powerBasis ℚ).algHom_ext
    rw [IsPrimitiveRoot.powerBasis_gen]
    exact hh
  exact DFunLike.congr_fun hconj x

/-- The two angular weights in the quartic benchmark cancel on every integral unit. -/
theorem quarticBenchmark_unit_angular_weights (e₁ e₂ : F₈ →+* ℂ)
    (he : e₂ (IsCyclotomicExtension.zeta 8 ℚ F₈) =
      e₁ (IsCyclotomicExtension.zeta 8 ℚ F₈) ^ 3) (u : (𝓞 F₈)ˣ) :
    (e₁ (u : F₈) / star (e₁ (u : F₈))) ^ 3 =
      e₂ (u : F₈) / star (e₂ (u : F₈)) := by
  obtain ⟨c, hc⟩ := quarticBenchmark_complex_conjugation
  let C := Units.map (RingOfIntegers.mapRingHom c).toMonoidHom
  let v : (𝓞 F₈)ˣ := u / C u
  have hv₁ (e : F₈ →+* ℂ) : e (v : F₈) = e (u : F₈) / star (e (u : F₈)) := by
    have hC : (C u : F₈) = c (u : F₈) := rfl
    have hv : (v : F₈) = (u : F₈) / (C u : F₈) := by
      let D := (Units.coeHom F₈).comp (Units.map (algebraMap (𝓞 F₈) F₈).toMonoidHom)
      exact map_div D u (C u)
    rw [hv, hC, map_div₀, hc]
  have hvT : v ∈ NumberField.Units.torsion F₈ := (NumberField.Units.mem_torsion F₈).2 fun w ↦ by
    rw [← NumberField.InfinitePlace.norm_embedding_eq, hv₁, norm_div, norm_star,
      div_self (norm_ne_zero_iff.mpr ((map_ne_zero w.embedding).mpr (NumberField.Units.coe_ne_zero u)))]
  have hord : NumberField.Units.torsionOrder F₈ = 8 := by
    rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := 8)]
    decide
  have hv8 := NumberField.Units.pow_torsionOrder_eq_one F₈ hvT
  rw [hord] at hv8
  have hv8' : (v : F₈) ^ 8 = 1 := by
    simpa only [NumberField.Units.coe_pow, NumberField.Units.coe_one] using
      congrArg (fun x : (𝓞 F₈)ˣ ↦ (x : F₈)) hv8
  obtain ⟨k, _, hk⟩ :=
    (IsCyclotomicExtension.zeta_spec 8 ℚ F₈).eq_pow_of_pow_eq_one hv8'
  rw [← hv₁ e₁, ← hv₁ e₂, ← hk, map_pow, map_pow, he, pow_right_comm]

local notation "I₀" => (SAdeleRing F₈ ∅)ˣ
local notation "J₀" => SIdeleQuotient F₈ ∅
local notation "J₁₀" => MonoidHom.ker (sIdeleQuotientNorm F₈ ∅)
local notation "C₁" => MonoidHom.ker (ideleClassNorm F₈)

private theorem quarticBenchmark_extend_embedding (e : F₈ →+* ℂ) :
    let w := InfinitePlace.mk e
    ∃ f : w.Completion →+* ℂ, Isometry f ∧ Function.Surjective f ∧
      ∀ x : F₈, f (algebraMap F₈ _ x) = e x := by
  let w := InfinitePlace.mk e
  let E := InfinitePlace.Completion.extensionEmbedding w
  have hE : Isometry E := InfinitePlace.Completion.isometry_extensionEmbedding w
  have hw := (IsCyclotomicExtension.Rat.isTotallyComplex F₈ (n := 8) (by decide)).isComplex w
  have hEs : Function.Surjective E :=
    InfinitePlace.Completion.surjective_extensionEmbedding_of_isComplex hw
  have hvalue (x : F₈) : E (algebraMap F₈ w.Completion x) = w.embedding x := by
    rw [AbsoluteValue.Completion.algebraMap_def, InfinitePlace.Completion.extensionEmbedding_coe]
    rfl
  rcases InfinitePlace.embedding_mk_eq e with he | he
  · exact ⟨E, hE, hEs, fun x ↦ hvalue x |>.trans (DFunLike.congr_fun he x)⟩
  · refine ⟨(starRingEnd ℂ).comp E, Complex.conjLIE.isometry.comp hE,
      Complex.conjLIE.surjective.comp hEs, fun x ↦ ?_⟩
    change star (E (algebraMap F₈ w.Completion x)) = e x
    rw [hvalue, DFunLike.congr_fun he x]
    exact star_star _

private theorem quarticBenchmark_angular_map (e : SAdeleRing F₈ ∅ →+* ℂ) (he : Continuous e) :
    ∃ χ : PontryaginDual I₀, ∀ g, (χ g : ℂ) = e g.val / star (e g.val) := by
  let value (g : I₀) := e g.val / star (e g.val)
  have hnonzero (g : I₀) : e g.val ≠ 0 := (g.isUnit.map e).ne_zero
  have hv (g : I₀) : value g ∈ Submonoid.unitSphere ℂ := by
    apply mem_sphere_zero_iff_norm.mpr
    change ‖e g.val / star (e g.val)‖ = 1
    rw [norm_div, norm_star, div_self (norm_ne_zero_iff.mpr (hnonzero g))]
  have hc : Continuous value :=
    (he.comp Units.continuous_val).div (continuous_star.comp (he.comp Units.continuous_val))
      (fun g ↦ star_ne_zero.mpr (hnonzero g))
  refine ⟨{ toFun := fun g ↦ ⟨value g, hv g⟩
            map_one' := Circle.ext (by simp [value])
            map_mul' := fun a b ↦ Circle.ext (by
              change value (a * b) = value a * value b
              simp only [value, Units.val_mul, map_mul, star_mul', mul_div_mul_comm])
            continuous_toFun := hc.subtype_mk hv }, fun _ ↦ rfl⟩

private theorem quarticBenchmark_descend (χ : PontryaginDual I₀)
    (hχ : ∀ g : I₀, (QuotientGroup.mk g : J₀) = 1 → χ g = 1) :
    ∃ (c : unramifiedOutside F₈ ∅) (ηG : PontryaginDual C₁)
      (hη : ∀ x : C₁, c.val x.val = (ηG x : ℂ)),
      (∀ (g : I₀) (y : J₁₀), y.val = QuotientGroup.mk g →
        χ g = sLocalNormOneCharacter ∅ ηG ⟨c, hη⟩ y) ∧
      ∀ (u : (integralAdelesOutside F₈ ∅)ˣ),
        let g := Units.map (adeleProjection F₈ ∅).toMonoidHom (integralIdeleInsertion F₈ ∅ u)
        c.val (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u)) = (χ g : ℂ) := by
  let η : PontryaginDual J₀ :=
    ⟨QuotientGroup.lift _ χ.toMonoidHom (fun g hg ↦ hχ g ((QuotientGroup.eq_one_iff g).mpr hg)),
      (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr χ.continuous⟩
  let coeCircle : Circle →ₜ* ℂ := ⟨Circle.coeHom, continuous_subtype_val⟩
  obtain ⟨c, hc⟩ := sIdeleRestriction_surjective F₈ ∅ (coeCircle.comp η)
  let C := IdeleClassGroup (𝓞 F₈) F₈
  let : T2Space C := (ideleGroup_quotient.{_, 0} F₈).2.2.2.2.2.1
  let : LocallyCompactSpace C := (ideleGroup_quotient.{_, 0} F₈).2.2.2.2.2.2.1
  have hn (x : C₁) : ‖c.val x.val‖ = 1 := by
    have hnorm := norm_quasiCharacter_eq_rpow_abscissa (G := C) (ideleClassNorm F₈)
      (isProperMap_ideleClassNorm F₈) (ideleClassNorm_ne_one (F := F₈)) c.val x.val
    simpa [MonoidHom.mem_ker.mp x.property] using hnorm
  let w : PontryaginDual C₁ :=
    { toFun := fun x ↦ ⟨c.val x.val, mem_sphere_zero_iff_norm.mpr (hn x)⟩
      map_one' := Circle.ext (map_one c.val)
      map_mul' := fun x y ↦ Circle.ext (map_mul c.val x.val y.val)
      continuous_toFun := (c.val.continuous.comp continuous_subtype_val).subtype_mk
        (fun x ↦ mem_sphere_zero_iff_norm.mpr (hn x)) }
  refine ⟨c, w, (fun _ ↦ rfl), (fun g y hy ↦ Circle.ext ?_), ?_⟩
  · rw [sLocalNormOneCharacter_eq_sIdeleRestriction w c (fun _ ↦ rfl), hc, hy]
    rfl
  · intro u
    let g := Units.map (adeleProjection F₈ ∅).toMonoidHom (integralIdeleInsertion F₈ ∅ u)
    change c.val (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u)) = (χ g : ℂ)
    rw [normOneCharacterUnramifiedOutside_iff_reinsert c u, ← sIdeleRestriction_mk, hc]
    rfl

private theorem quarticBenchmark_angular_infinite_order {w₁ w₂ : InfinitePlace F₈}
    (hplaces : w₁ ≠ w₂) (E₁ : w₁.Completion →+* ℂ) (E₂ : w₂.Completion →+* ℂ)
    (hE₁ : Isometry E₁) (hEs₁ : Function.Surjective E₁) (η : PontryaginDual C₁)
    (hη : ∀ (u : (integralAdelesOutside F₈ ∅)ˣ) (x : C₁),
      x.val = QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u) →
      let z₁ := E₁ (u.val.val.1 w₁)
      let z₂ := E₂ (u.val.val.1 w₂)
      (η x : ℂ) = (z₂ / star z₂) / (z₁ / star z₁) ^ 3) : ¬ IsOfFinOrder η := by
  classical
  intro h
  obtain ⟨n, hn, hpow⟩ := isOfFinOrder_iff_pow_eq_one.mp h
  let z := Complex.exp (2 * Real.pi * Complex.I / (12 * n : ℕ))
  have hz : IsPrimitiveRoot z (12 * n) := Complex.isPrimitiveRoot_exp _ (by omega)
  have hzNorm : ‖z‖ = 1 := hz.norm'_eq_one (by omega)
  have horder : (1 / (z / star z) ^ 3) ^ n ≠ 1 := by
    change (1 / (z / (starRingEnd ℂ) z) ^ 3) ^ n ≠ 1
    rw [← Complex.inv_eq_conj hzNorm]
    rw [show z / z⁻¹ = z ^ 2 by simp [div_eq_mul_inv, pow_two]]
    rw [one_div, inv_pow, ← pow_mul, ← pow_mul]
    intro hroot
    exact hz.pow_ne_one_of_pos_of_lt (l := 2 * (3 * n)) (by omega) (by omega)
      (by simpa using congrArg Inv.inv hroot)
  obtain ⟨t, ht⟩ := hEs₁ z
  have htNorm : ‖t‖ = 1 := by
    rw [← dist_zero_right, ← hE₁.dist_eq t 0, map_zero, ht, dist_zero_right, hzNorm]
  let tUnit := Units.mk0 t (norm_ne_zero_iff.mp (by simp [htNorm]))
  let a := IdeleGroup.ofCompletion (𝓞 F₈) F₈ w₁ tUnit
  have haNorm : ideleNorm F₈ a = 1 := by
    apply Units.ext
    apply NNReal.eq
    rw [((ideleNorm_spec F₈).1 a).2]
    change (∏ w : InfinitePlace F₈, ‖Pi.mulSingle w₁ t w‖ ^ w.mult) *
      ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (𝓞 F₈), ‖(1 : v.adicCompletion F₈)‖ = 1
    simp only [norm_one, finprod_one, mul_one]
    apply Finset.prod_eq_one
    intro w _
    rcases eq_or_ne w w₁ with rfl | h
    · rw [Pi.mulSingle_eq_same, htNorm, one_pow]
    · rw [Pi.mulSingle_eq_of_ne h, norm_one, one_pow]
  have haUnit : a ∈ Set.range (integralIdeleInsertion F₈ ∅) := by
    apply (mem_range_integralIdeleInsertion F₈ ∅ a).2
    intro v _
    exact ⟨one_mem _, one_mem _⟩
  obtain ⟨u, hu⟩ := haUnit
  let x : C₁ := ⟨QuotientGroup.mk a, haNorm⟩
  have hval (w : InfinitePlace F₈) : u.val.val.1 w = Pi.mulSingle w₁ t w :=
    congrArg (fun g : IdeleGroup (𝓞 F₈) F₈ ↦ g.val.1 w) hu
  have hx := hη u x (by change QuotientGroup.mk a = _; rw [hu])
  simp only [hval w₁, Pi.mulSingle_eq_same, ht, hval w₂, Pi.mulSingle_eq_of_ne hplaces.symm,
    map_one, star_one, div_one] at hx
  have hEq' := DFunLike.congr_fun hpow x
  change ((η : C₁ →ₜ* Circle) ^ n) x = 1 at hEq'
  have hEq'' := (ContinuousMonoidHom.pow_apply (η : C₁ →ₜ* Circle) n x).symm.trans hEq'
  have hEq : (η x : ℂ) ^ n = 1 :=
    (Circle.coe_pow (η x) n).symm.trans
      ((congrArg (fun s : Circle ↦ (s : ℂ)) hEq'').trans Circle.coe_one)
  exact horder ((congrArg (fun s : ℂ ↦ s ^ n) hx).symm.trans hEq)

/-- The angular character of the quartic benchmark extends to the global norm-one idèle
class group and is unramified at every finite place. -/
theorem quarticBenchmark_global_character (e₁ e₂ : F₈ →+* ℂ)
    (he : e₂ (IsCyclotomicExtension.zeta 8 ℚ F₈) =
      e₁ (IsCyclotomicExtension.zeta 8 ℚ F₈) ^ 3) :
    let w₁ := InfinitePlace.mk e₁
    let w₂ := InfinitePlace.mk e₂
    ∃ (E₁ : w₁.Completion →+* ℂ) (E₂ : w₂.Completion →+* ℂ)
      (c : unramifiedOutside F₈ ∅) (η : PontryaginDual C₁)
      (hη : ∀ x : C₁, c.val x.val = (η x : ℂ)),
      Isometry E₁ ∧ Isometry E₂ ∧
      (∀ x : F₈, E₁ (algebraMap F₈ _ x) = e₁ x) ∧
      (∀ x : F₈, E₂ (algebraMap F₈ _ x) = e₂ x) ∧
      (∀ (g : I₀) (y : J₁₀), y.val = QuotientGroup.mk g →
        let z₁ := E₁ (g.val.1 w₁)
        let z₂ := E₂ (g.val.1 w₂)
        (sLocalNormOneCharacter ∅ η ⟨c, hη⟩ y : ℂ) = (z₂ / star z₂) / (z₁ / star z₁) ^ 3) ∧
      (∀ (u : (integralAdelesOutside F₈ ∅)ˣ),
        let z₁ := E₁ (u.val.val.1 w₁)
        let z₂ := E₂ (u.val.val.1 w₂)
        c.val (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u)) =
          (z₂ / star z₂) / (z₁ / star z₁) ^ 3) ∧
      (w₁ ≠ w₂ → ¬ IsOfFinOrder η) := by
  let w₁ := InfinitePlace.mk e₁
  let w₂ := InfinitePlace.mk e₂
  obtain ⟨E₁, hE₁, hEs₁, hv₁⟩ := quarticBenchmark_extend_embedding e₁
  obtain ⟨E₂, hE₂, _, hv₂⟩ := quarticBenchmark_extend_embedding e₂
  let A₁ : SAdeleRing F₈ ∅ →+* ℂ :=
    E₁.comp ((Pi.evalRingHom (fun w : InfinitePlace F₈ ↦ w.Completion) w₁).comp (RingHom.fst _ _))
  let A₂ : SAdeleRing F₈ ∅ →+* ℂ :=
    E₂.comp ((Pi.evalRingHom (fun w : InfinitePlace F₈ ↦ w.Completion) w₂).comp (RingHom.fst _ _))
  obtain ⟨χ₁, hχ₁⟩ := quarticBenchmark_angular_map A₁
    (hE₁.continuous.comp ((continuous_apply w₁).comp continuous_fst))
  obtain ⟨χ₂, hχ₂⟩ := quarticBenchmark_angular_map A₂
    (hE₂.continuous.comp ((continuous_apply w₂).comp continuous_fst))
  let χ : PontryaginDual I₀ := χ₂ / χ₁ ^ 3
  have hχval (g : I₀) : (χ g : ℂ) =
      (A₂ g.val / star (A₂ g.val)) / (A₁ g.val / star (A₁ g.val)) ^ 3 := by
    change ((χ₂ g / χ₁ g ^ 3 : Circle) : ℂ) = _
    rw [Circle.coe_div, Circle.coe_pow, hχ₁, hχ₂]
  have hχ (g : I₀) (hg : (QuotientGroup.mk g : J₀) = 1) : χ g = 1 := by
    obtain ⟨u, hu⟩ := (sIdeleQuotient_mk_eq_one F₈ ∅ g).mp hg
    let S : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F₈)) := ∅
    let B := Set.integer (S : Set (IsDedekindDomain.HeightOneSpectrum (𝓞 F₈))) F₈
    have hintegral (x : B) : IsIntegral ℤ (x : F₈) := by
      have hx := x.property
      simp only [B, S, Finset.coe_empty, IsDedekindDomain.integer_empty, Algebra.mem_bot] at hx
      obtain ⟨b, hb⟩ := hx
      rw [← hb]
      exact b.isIntegral_coe
    let D : B →+* (𝓞 F₈) :=
      { toFun := fun x ↦ ⟨x.val, hintegral x⟩
        map_one' := Subtype.ext rfl
        map_mul' := fun _ _ ↦ Subtype.ext rfl
        map_zero' := Subtype.ext rfl
        map_add' := fun _ _ ↦ Subtype.ext rfl }
    let u' : (𝓞 F₈)ˣ := Units.map D.toMonoidHom u
    have hgval (w : InfinitePlace F₈) : g.val.1 w = algebraMap F₈ w.Completion (u' : F₈) :=
      congrArg (fun x : I₀ ↦ x.val.1 w) hu
    have hz₁ : A₁ g.val = e₁ (u' : F₈) := by
      change E₁ (g.val.1 w₁) = _
      rw [hgval, hv₁]
    have hz₂ : A₂ g.val = e₂ (u' : F₈) := by
      change E₂ (g.val.1 w₂) = _
      rw [hgval, hv₂]
    have hz : e₂ (u' : F₈) ≠ 0 :=
      (map_ne_zero e₂).mpr (NumberField.Units.coe_ne_zero u')
    apply Circle.ext
    rw [hχval, hz₁, hz₂, quarticBenchmark_unit_angular_weights e₁ e₂ he u']
    exact div_self (div_ne_zero hz (star_ne_zero.mpr hz))
  obtain ⟨c, η, hη, hηvalue, hcvalue⟩ := quarticBenchmark_descend χ hχ
  have hcglobal (u : (integralAdelesOutside F₈ ∅)ˣ) :
      let z₁ := E₁ (u.val.val.1 w₁)
      let z₂ := E₂ (u.val.val.1 w₂)
      c.val (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u)) =
        (z₂ / star z₂) / (z₁ / star z₁) ^ 3 := by
    let g := Units.map (adeleProjection F₈ ∅).toMonoidHom (integralIdeleInsertion F₈ ∅ u)
    exact (hcvalue u).trans (hχval g)
  refine ⟨E₁, E₂, c, η, hη, hE₁, hE₂, hv₁, hv₂, (fun g y hy ↦
    (congrArg (fun z : Circle ↦ (z : ℂ)) (hηvalue g y hy)).symm.trans (hχval g)),
    hcglobal, fun hw ↦ quarticBenchmark_angular_infinite_order hw E₁ E₂ hE₁ hEs₁ η ?_⟩
  intro u x hx
  rw [← hη x, hx]
  exact hcglobal u

/-- A diagonal element with the same finite valuations as an idèle moves its class into
the stage with all finite components units. The infinite coordinates are divided by the
diagonal element. -/
theorem quarticBenchmark_principal_quotient (a : IdeleGroup (𝓞 F₈) F₈) (z : F₈ˣ)
    (hz : ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 F₈),
      Valued.v (a.val.2 v) = v.valuation F₈ (z : F₈)) :
    ∃ u : (integralAdelesOutside F₈ ∅)ˣ,
      (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u) : IdeleClassGroup (𝓞 F₈) F₈) =
        QuotientGroup.mk a ∧
      ∀ w : InfinitePlace F₈, u.val.val.1 w =
        a.val.1 w / algebraMap F₈ w.Completion (z : F₈) := by
  let p := IdeleGroup.unitEmbedding (𝓞 F₈) F₈ z
  let b := a / p
  have hp : (QuotientGroup.mk' (IdeleGroup.principalSubgroup (𝓞 F₈) F₈)) p = 1 :=
    (QuotientGroup.eq_one_iff p).2 ⟨z, rfl⟩
  have hb : b ∈ Set.range (integralIdeleInsertion F₈ ∅) := by
    apply (mem_range_integralIdeleInsertion F₈ ∅ b).mpr
    intro v _
    let V := v.adicCompletion F₈
    let r : NumberField.AdeleRing (𝓞 F₈) F₈ →+* V :=
      (RestrictedProduct.evalRingHom _ v).comp (RingHom.snd _ _)
    let R := Units.map r.toMonoidHom
    have hRV : Valued.v ((R b : Vˣ) : V) = 1 := by
      have hRz : ((R p : Vˣ) : V) = ((z : F₈) : v.adicCompletion F₈) :=
        AdeleRing.algebraMap_snd_apply (𝓞 F₈) F₈ (z : F₈) v
      change Valued.v (((R (a / p) : Vˣ) : V)) = 1
      rw [map_div, Units.val_div_eq_div_val, Valuation.map_div, hRz,
        IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
      change Valued.v (a.val.2 v) / v.valuation F₈ (z : F₈) = 1
      rw [hz, div_self ((Valuation.ne_zero_iff _).mpr z.ne_zero)]
    exact (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one.mpr
      hRV)
  obtain ⟨u, hu⟩ := hb
  refine ⟨u, ?_, fun w ↦ ?_⟩
  · rw [hu]
    change (QuotientGroup.mk' _) (a / p) = _
    rw [map_div, hp, div_one]
    rfl
  · calc
      _ = b.val.1 w := congrArg (fun g : IdeleGroup (𝓞 F₈) F₈ ↦ g.val.1 w) hu
      _ = _ := by
        let r : AdeleRing (𝓞 F₈) F₈ →+* w.Completion :=
          (Pi.evalRingHom (fun v : InfinitePlace F₈ ↦ v.Completion) w).comp (RingHom.fst _ _)
        let R := Units.map r.toMonoidHom
        change (R (a / p)).val = _
        rw [map_div, Units.val_div_eq_div_val]
        rw [AbsoluteValue.Completion.algebraMap_def]
        exact congrArg (fun y : w.Completion ↦ a.val.1 w / y)
          (AdeleRing.algebraMap_fst_apply (𝓞 F₈) F₈ (z : F₈) w)

private theorem quarticBenchmark_angular_real_div (a z : ℂ) (ha : star a = a)
    (ha₀ : a ≠ 0) (hz : z ≠ 0) : (a / z) / star (a / z) = (z / star z)⁻¹ := by
  have hzc : star z ≠ 0 := star_ne_zero.mpr hz
  rw [star_div₀, ha]
  field_simp

/-- A finite valuation profile represented by a diagonal element has the inverse of
its archimedean angular value, when the chosen normalization of the idèle is real. -/
theorem quarticBenchmark_principal_phase {w₁ w₂ : InfinitePlace F₈}
    (E₁ : w₁.Completion →+* ℂ) (E₂ : w₂.Completion →+* ℂ) (c : unramifiedOutside F₈ ∅)
    (hc : ∀ (u : (integralAdelesOutside F₈ ∅)ˣ),
      let z₁ := E₁ (u.val.val.1 w₁)
      let z₂ := E₂ (u.val.val.1 w₂)
      c.val (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u)) =
        (z₂ / star z₂) / (z₁ / star z₁) ^ 3)
    (a : IdeleGroup (𝓞 F₈) F₈) (z : F₈ˣ)
    (hz : ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 F₈),
      Valued.v (a.val.2 v) = v.valuation F₈ (z : F₈))
    (hr₁ : star (E₁ (a.val.1 w₁)) = E₁ (a.val.1 w₁))
    (hr₂ : star (E₂ (a.val.1 w₂)) = E₂ (a.val.1 w₂)) :
    let z₁ := E₁ (algebraMap F₈ w₁.Completion (z : F₈))
    let z₂ := E₂ (algebraMap F₈ w₂.Completion (z : F₈))
    c.val (QuotientGroup.mk a) = (z₁ / star z₁) ^ 3 / (z₂ / star z₂) := by
  obtain ⟨u, hu, hcoord⟩ := quarticBenchmark_principal_quotient a z hz
  have h := hc u
  have hnonzero (w : InfinitePlace F₈) (E : w.Completion →+* ℂ) :
      E (a.val.1 w) ≠ 0 :=
    (a.isUnit.map (E.comp ((Pi.evalRingHom (fun v : InfinitePlace F₈ ↦ v.Completion) w).comp
      (RingHom.fst (InfiniteAdeleRing F₈) _)))).ne_zero
  have hznonzero (w : InfinitePlace F₈) (E : w.Completion →+* ℂ) :
      E (algebraMap F₈ w.Completion (z : F₈)) ≠ 0 :=
    (map_ne_zero (E.comp (algebraMap F₈ w.Completion))).mpr z.ne_zero
  dsimp only at h
  rw [hu, hcoord w₁, hcoord w₂, map_div₀, map_div₀,
    quarticBenchmark_angular_real_div _ _ hr₁ (hnonzero w₁ E₁) (hznonzero w₁ E₁),
    quarticBenchmark_angular_real_div _ _ hr₂ (hnonzero w₂ E₂) (hznonzero w₂ E₂),
    inv_pow, inv_div_inv] at h
  exact h

/-- The value at a finite uniformizer can be read from any global generator with the
same valuation there and valuation one at every other finite place. -/
theorem quarticBenchmark_uniformizer_phase {w₁ w₂ : InfinitePlace F₈}
    (E₁ : w₁.Completion →+* ℂ) (E₂ : w₂.Completion →+* ℂ) (c : unramifiedOutside F₈ ∅)
    (hc : ∀ (u : (integralAdelesOutside F₈ ∅)ˣ),
      let z₁ := E₁ (u.val.val.1 w₁)
      let z₂ := E₂ (u.val.val.1 w₂)
      c.val (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u)) =
        (z₂ / star z₂) / (z₁ / star z₁) ^ 3)
    (v : IsDedekindDomain.HeightOneSpectrum (𝓞 F₈)) (t : (v.adicCompletion F₈)ˣ) (z : F₈ˣ)
    (ht : Valued.v (t.val : v.adicCompletion F₈) = v.valuation F₈ (z : F₈))
    (hz : ∀ w : IsDedekindDomain.HeightOneSpectrum (𝓞 F₈), w ≠ v →
      w.valuation F₈ (z : F₈) = 1) :
    let z₁ := E₁ (algebraMap F₈ w₁.Completion (z : F₈))
    let z₂ := E₂ (algebraMap F₈ w₂.Completion (z : F₈))
    c.val.restrict v t.val = (z₁ / star z₁) ^ 3 / (z₂ / star z₂) := by
  classical
  let a := IdeleGroup.ofAdicCompletion (𝓞 F₈) F₈ v t
  have hval (w : IsDedekindDomain.HeightOneSpectrum (𝓞 F₈)) :
      Valued.v (a.val.2 w) = w.valuation F₈ (z : F₈) := by
    change Valued.v (RestrictedProduct.mulSingle (fun x ↦ x.adicCompletionIntegers F₈)
      v t.val w) = _
    rcases eq_or_ne w v with rfl | hw
    · rw [RestrictedProduct.mulSingle_eq_same]
      exact ht
    · rw [RestrictedProduct.mulSingle_eq_of_ne _ _ hw, map_one, hz w hw]
  have hr (w : InfinitePlace F₈) (E : w.Completion →+* ℂ) :
      star (E (a.val.1 w)) = E (a.val.1 w) := by
    change star (E 1) = E 1
    rw [map_one, star_one]
  rw [HeckeCharacter.restrict, MulChar.ofUnitHom_coe]
  exact quarticBenchmark_principal_phase E₁ E₂ c hc a z hval (hr w₁ E₁) (hr w₂ E₂)

private theorem canonicalNormSection_real {F : Type*} [Field F] [NumberField F]
    {w : InfinitePlace F} (hw : w.IsComplex) (E : w.Completion →+* ℂ) (hE : Isometry E)
    (t : ℝ≥0ˣ) :
    E ((canonicalIdeleNormSection F t).val.1 w) =
      (((t.val : ℝ) ^ (Module.finrank ℚ F : ℝ)⁻¹ : ℝ) : ℂ) := by
  let e := InfinitePlace.Completion.ringEquivComplexOfIsComplex hw
  let f := E.comp e.symm.toRingHom
  have hf : Continuous f :=
    hE.continuous.comp (InfinitePlace.Completion.isometryEquivComplexOfIsComplex hw).symm.continuous
  let a := (canonicalIdeleNormSection F t).val.1 w
  have h := Complex.ringHom_eq_id_or_conj_of_continuous hf
  have ha : e a = (((t.val : ℝ) ^ (Module.finrank ℚ F : ℝ)⁻¹ : ℝ) : ℂ) :=
    canonicalIdeleNormSection_infinite F t w
  have he : f (e a) = E a := congrArg E (e.symm_apply_apply a)
  rcases h with h | h
  · rwa [← he, h, RingHom.id_apply]
  · rw [← he, h, ha]
    exact Complex.conj_ofReal _

/-- The positive-real archimedean norm section has trivial angular character. -/
theorem quarticBenchmark_normSection {F : Type*} [Field F] [NumberField F]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) (c : unramifiedOutside F T)
    (w₁ w₂ : InfinitePlace F) (hw₁ : w₁.IsComplex) (hw₂ : w₂.IsComplex)
    (E₁ : w₁.Completion →+* ℂ) (E₂ : w₂.Completion →+* ℂ)
    (hE₁ : Isometry E₁) (hE₂ : Isometry E₂)
    (hc : ∀ u : (integralAdelesOutside F ∅)ˣ,
      let z₁ := E₁ (u.val.val.1 w₁)
      let z₂ := E₂ (u.val.val.1 w₂)
      c.val (QuotientGroup.mk (integralIdeleInsertion F ∅ u)) =
        (z₂ / star z₂) / (z₁ / star z₁) ^ 3) :
    ∃ τ : ℝ≥0ˣ →ₜ* SIdeleQuotient F T,
      Function.RightInverse τ (sIdeleQuotientNorm F T) ∧
      ∀ t, sIdeleRestriction F T c (τ t) = 1 := by
  let s := canonicalIdeleNormSection F
  let p := Units.map (adeleProjection F T).toMonoidHom
  have hp : Continuous p := (continuous_fst.prodMk (continuous_pi fun v : T ↦
    (RestrictedProduct.continuous_eval v.val).comp continuous_snd)).units_map _
  let q : (SAdeleRing F T)ˣ →* SIdeleQuotient F T := QuotientGroup.mk' _
  let τ : ℝ≥0ˣ →ₜ* SIdeleQuotient F T :=
    ⟨q.comp (p.comp s), QuotientGroup.continuous_mk.comp
      (hp.comp (canonicalIdeleNormSection_continuous F))⟩
  refine ⟨τ, ?_, ?_⟩
  · intro t
    change sIdeleQuotientNorm F T (QuotientGroup.mk (p (s t))) = t
    rw [sIdeleQuotientNorm_mk]
    obtain ⟨u, hu⟩ : s t ∈ Set.range (integralIdeleInsertion F T) := by
      apply (mem_range_integralIdeleInsertion F T _).2
      intro v _
      change (s t).val.2 v ∈ _ ∧ ((s t)⁻¹).val.2 v ∈ _
      rw [← map_inv]
      simp only [s, canonicalIdeleNormSection_finite]
      exact ⟨one_mem _, one_mem _⟩
    rw [← hu]
    calc
      _ = ideleNorm F (integralIdeleInsertion F T u) := ((sIdeleNorm_spec F T).1 u).symm
      _ = t := by rw [hu]; exact canonicalIdeleNormSection_rightInverse F t
  · intro t
    change sIdeleRestriction F T c (QuotientGroup.mk (p (s t))) = 1
    rw [sIdeleRestriction_mk]
    have hIns : sIdeleInsertion F T (p (s t)) = s t := by
      obtain ⟨ha, hf, hout⟩ := sIdeleInsertion_apply F T (p (s t))
      apply Units.ext
      apply Prod.ext
      · exact ha
      · apply RestrictedProduct.ext
        intro v
        by_cases hv : v ∈ T
        · exact hf ⟨v, hv⟩
        · change (sIdeleInsertion F T (p (s t))).val.2 v = (s t).val.2 v
          rw [hout v hv, show (s t).val.2 = 1 from canonicalIdeleNormSection_finite F t]
          rfl
    rw [hIns]
    obtain ⟨u, hu⟩ : s t ∈ Set.range (integralIdeleInsertion F ∅) := by
      apply (mem_range_integralIdeleInsertion F ∅ _).2
      intro v _
      change (s t).val.2 v ∈ _ ∧ ((s t)⁻¹).val.2 v ∈ _
      rw [← map_inv]
      simp only [s, canonicalIdeleNormSection_finite]
      exact ⟨one_mem _, one_mem _⟩
    have hval (w : InfinitePlace F) : u.val.val.1 w = (s t).val.1 w :=
      congrArg (fun a : IdeleGroup (𝓞 F) F ↦ a.val.1 w) hu
    have hprob := hc u
    rw [hu, hval w₁, hval w₂, canonicalNormSection_real hw₁ E₁ hE₁,
      canonicalNormSection_real hw₂ E₂ hE₂] at hprob
    have hpos : 0 < (t.val : ℝ) ^ (Module.finrank ℚ F : ℝ)⁻¹ :=
      Real.rpow_pos_of_pos (NNReal.coe_pos.mpr t.ne_zero.bot_lt) _
    simpa [Complex.ofReal_ne_zero.mpr hpos.ne'] using hprob

end GlobalCharacter

/-! ## Repeated poles and the common shift -/

/-- The secondary-to-primary ratio of the logarithms of the residue sizes. -/
def quarticLogRatio : ℝ := Real.log 17 / Real.log 49

private theorem quartic_primary_log_ne_zero : (Real.log 49 : ℂ) ≠ 0 :=
  Complex.ofReal_ne_zero.mpr (Real.log_pos (by norm_num : (1 : ℝ) < 49)).ne'

theorem quarticLogRatio_irrational : Irrational quarticLogRatio := by
  intro ⟨r, hr⟩
  have h49 : 0 < Real.log 49 := Real.log_pos (by norm_num)
  have h17 : 0 < Real.log 17 := Real.log_pos (by norm_num)
  have hrpos : 0 < (r : ℝ) := hr ▸ div_pos h17 h49
  have hrden : 0 < (r.den : ℝ) := by exact_mod_cast r.den_pos
  have hnum : 0 ≤ r.num := by
    have : 0 < (r.num : ℝ) := by
      rw [Rat.cast_def] at hrpos
      simpa only [zero_mul] using (lt_div_iff₀ hrden).mp hrpos
    exact_mod_cast this.le
  let m := r.num.toNat
  have hm : (m : ℝ) = (r.num : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg hnum
  have hlogs : (r.den : ℝ) * Real.log 17 = (m : ℝ) * Real.log 49 := by
    rw [Rat.cast_def, quarticLogRatio, ← hm] at hr
    have hx := (div_eq_div_iff hrden.ne' h49.ne').mp hr
    linarith
  have hpowers := congrArg Real.exp hlogs
  rw [Real.exp_nat_mul, Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 17),
    Real.exp_log (by norm_num : (0 : ℝ) < 49)] at hpowers
  have hpowNat : (17 : ℕ) ^ r.den = 49 ^ m := by exact_mod_cast hpowers
  have hdvd : 17 ∣ (49 : ℕ) ^ m := hpowNat ▸ dvd_pow_self 17 r.den_pos.ne'
  exact (by decide : ¬ (17 : ℕ) ∣ 49) ((by decide : Nat.Prime 17).dvd_of_dvd_pow hdvd)

/-- The repeated primary pole height when the two places of norm 49 have phase one. -/
def quarticPoleHeight (n : ℤ) : ℂ :=
  (n : ℂ) * (2 * Real.pi * Complex.I) / (Real.log 49 : ℂ)

/-- Distinct integers label distinct centers of the repeated primary poles. -/
theorem quarticPoleHeight_injective : Function.Injective quarticPoleHeight := by
  intro m n h
  have hperiod : (2 * Real.pi * Complex.I : ℂ) ≠ 0 :=
    mul_ne_zero (mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
      Complex.I_ne_zero
  have heq : (m : ℂ) * ((2 * Real.pi * Complex.I) / (Real.log 49 : ℂ)) =
      (n : ℂ) * ((2 * Real.pi * Complex.I) / (Real.log 49 : ℂ)) := by
    simpa only [quarticPoleHeight, mul_div_assoc] using h
  exact_mod_cast mul_right_cancel₀ (div_ne_zero hperiod quartic_primary_log_ne_zero) heq

/-- Rotation from one primary pole to the next at a place of norm 17. -/
def quarticRotation : Circle := AddCircle.toCircle ((-quarticLogRatio : ℝ) : AddCircle (1 : ℝ))

theorem quarticRotation_coe : (quarticRotation : ℂ) =
    Complex.exp (-((quarticLogRatio : ℂ) * (2 * Real.pi * Complex.I))) := by
  rw [quarticRotation, AddCircle.toCircle_apply_mk, Circle.coe_exp]
  congr 1
  push_cast
  ring

theorem quartic_pole (n : ℤ) : Complex.exp (-(Real.log 49 : ℂ) * quarticPoleHeight n) = 1 := by
  rw [show -(Real.log 49 : ℂ) * quarticPoleHeight n =
      (-(n : ℤ) : ℂ) * (2 * Real.pi * Complex.I) by
    unfold quarticPoleHeight
    rw [← mul_div_assoc]
    apply (div_eq_iff quartic_primary_log_ne_zero).mpr
    ring]
  simpa only [Int.cast_neg] using Complex.exp_int_mul_two_pi_mul_I (-n)

/-- The outside-prime value at the `n`th primary pole, starting at phase `a`. -/
def quarticPoleValue (a : ℂ) (n : ℤ) : ℂ := a * (quarticRotation : ℂ) ^ n

theorem quarticPoleValue_eq (a : ℂ) (n : ℤ) : quarticPoleValue a n =
    a * Complex.exp (-(Real.log 17 : ℂ) * quarticPoleHeight n) := by
  rw [quarticPoleValue, quarticRotation_coe, ← Complex.exp_int_mul]
  congr 2
  unfold quarticLogRatio quarticPoleHeight
  push_cast
  ring

/-- The strict Euler-factor cutoff in the gap statement, at the nonzero offset of a double pole. -/
def QuarticEligible (a : ℂ) (n : ℤ) : Prop := 1 < ‖(1 - quarticPoleValue a n)⁻¹‖

/-- The common-shift exception in #7336 restricted to the quartic pole sequence. -/
def QuarticCommonShift (a : ℂ) : Prop :=
  ∃ σ : ℂ, ∃ N : ℕ, 0 < N ∧ ∀ n, QuarticEligible a n →
    Complex.exp (N * (-(Real.log 49 : ℂ) * (quarticPoleHeight n - σ))) = 1 ∧
    quarticPoleValue a n ^ N =
      Complex.exp (N * (-(Real.log 17 : ℂ) * (quarticPoleHeight n - σ)))

private theorem exp_shifted_pole (L σ : ℂ) (n : ℤ) (N : ℕ) :
    Complex.exp (N * (-L * (quarticPoleHeight n - σ))) =
      Complex.exp (N * (L * σ)) * Complex.exp (-L * quarticPoleHeight n) ^ N := by
  rw [← Complex.exp_nat_mul, ← Complex.exp_add]
  congr 1
  ring

private theorem quartic_commonShift_power (a : ℂ) (h : QuarticCommonShift a)
    (hne : ∃ n, QuarticEligible a n) : ∃ N : ℕ, 0 < N ∧ ∃ k : ℤ,
    a ^ N = Complex.exp ((quarticLogRatio : ℂ) * (2 * Real.pi * Complex.I)) ^ k := by
  obtain ⟨σ, N, hN, hclear⟩ := h
  obtain ⟨n, hn⟩ := hne
  obtain ⟨hP, hQ⟩ := hclear n hn
  rw [exp_shifted_pole, quartic_pole, one_pow, mul_one] at hP
  rw [quarticPoleValue_eq, mul_pow, exp_shifted_pole] at hQ
  have hphase := mul_right_cancel₀ (pow_ne_zero N (Complex.exp_ne_zero _)) hQ
  obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.mp hP
  have hshift : (N : ℂ) * ((Real.log 17 : ℂ) * σ) =
      (k : ℂ) * ((quarticLogRatio : ℂ) * (2 * Real.pi * Complex.I)) := by
    unfold quarticLogRatio
    push_cast
    rw [div_mul_eq_mul_div, ← mul_div_assoc]
    apply (eq_div_iff quartic_primary_log_ne_zero).mpr
    linear_combination (Real.log 17 : ℂ) * hk
  refine ⟨N, hN, k, ?_⟩
  rw [← Complex.exp_int_mul, ← hshift]
  exact hphase

/-- Two multiplicatively independent phases cannot both have a common shift on the same
pair of pole lattices. -/
theorem not_both_quarticCommonShift (a b : ℂ) (hb : b ≠ 0)
    (hind : ∀ m n : ℤ, a ^ m * b ^ n = 1 → m = 0 ∧ n = 0)
    (haEligible : ∃ n, QuarticEligible a n) (hbEligible : ∃ n, QuarticEligible b n) :
    ¬ (QuarticCommonShift a ∧ QuarticCommonShift b) := by
  rintro ⟨ha, hbShift⟩
  obtain ⟨M, hM, k, hk⟩ := quartic_commonShift_power a ha haEligible
  obtain ⟨N, hN, l, hl⟩ := quartic_commonShift_power b hbShift hbEligible
  have hpowers : a ^ ((M : ℤ) * l) = b ^ ((N : ℤ) * k) := by
    rw [zpow_mul, zpow_mul, zpow_natCast, zpow_natCast, hk, hl, ← zpow_mul, ← zpow_mul,
      mul_comm k l]
  have hmix : a ^ ((M : ℤ) * l) * b ^ (-((N : ℤ) * k)) = 1 := by
    rw [hpowers, zpow_neg, mul_inv_cancel₀ (zpow_ne_zero _ hb)]
  have hl₀ : l = 0 := (mul_eq_zero.mp (hind _ _ hmix).1).resolve_left (by exact_mod_cast hM.ne')
  have hN₀ : (N : ℤ) = 0 := (hind 0 N (by simpa [hl₀] using hl)).2
  exact hN.ne' (by exact_mod_cast hN₀)

private theorem quarticCommonShift_of_coincidence (a : ℂ) (n : ℤ)
    (h : quarticPoleValue a n = 1) : QuarticCommonShift a := by
  have ha : a = Complex.exp ((Real.log 17 : ℂ) * quarticPoleHeight n) := by
    apply mul_right_cancel₀ (Complex.exp_ne_zero (-(Real.log 17 : ℂ) * quarticPoleHeight n))
    rw [← quarticPoleValue_eq, h, ← Complex.exp_add]
    simp
  refine ⟨quarticPoleHeight n, 1, by decide, fun m _ ↦ ⟨?_, ?_⟩⟩
  · rw [exp_shifted_pole, Nat.cast_one, one_mul, quartic_pole, one_pow, mul_one]
    have hneg := quartic_pole n
    rw [neg_mul, Complex.exp_neg] at hneg
    simpa using congrArg (fun x : ℂ ↦ x⁻¹) hneg
  · rw [exp_shifted_pole]
    simp only [Nat.cast_one, one_mul, pow_one, quarticPoleValue_eq, ha]

theorem quarticPoleValue_ne_one_of_noCommonShift (a : ℂ) (h : ¬ QuarticCommonShift a)
    (n : ℤ) : quarticPoleValue a n ≠ 1 := fun he ↦ h (quarticCommonShift_of_coincidence a n he)

private theorem quarticRotation_dense : DenseRange (fun n : ℤ ↦ quarticRotation ^ n) := by
  let e := AddCircle.homeomorphCircle (T := (1 : ℝ)) one_ne_zero
  have h : DenseRange (fun n : ℤ ↦ n • ((-quarticLogRatio : ℝ) : AddCircle (1 : ℝ))) :=
    AddCircle.denseRange_zsmul_coe_iff.mpr (by simpa using quarticLogRatio_irrational.neg)
  have hc := e.surjective.denseRange.comp h e.continuous
  change DenseRange (fun n : ℤ ↦ e (n • ((-quarticLogRatio : ℝ) : AddCircle (1 : ℝ)))) at hc
  simpa only [e, AddCircle.homeomorphCircle_apply, AddCircle.toCircle_zsmul, quarticRotation]
    using hc

/-- The dense rotation at norm 17 approaches the pole without hitting it at the
chosen indices, regardless of whether an exact coincidence occurs elsewhere. -/
theorem quarticPoleValue_approaches_one (a : ℂ) (ha : ‖a‖ = 1) (ε : ℝ) (hε : 0 < ε) :
    ∃ n : ℤ, 0 < ‖1 - quarticPoleValue a n‖ ∧ ‖1 - quarticPoleValue a n‖ < ε := by
  let u : Circle := ⟨a, by
    change a ∈ Metric.sphere (0 : ℂ) 1
    exact mem_sphere_zero_iff_norm.mpr ha⟩
  have hmul : Function.Surjective (fun z : Circle ↦ u * z) := by
    intro z
    exact ⟨u⁻¹ * z, by simp⟩
  have hd : DenseRange (fun n : ℤ ↦ u * quarticRotation ^ n) :=
    hmul.denseRange.comp quarticRotation_dense (continuous_const.mul continuous_id)
  have hcontinuous : Continuous (fun x : ℝ ↦ dist (Circle.exp x) (1 : Circle)) :=
    Circle.exp.continuous.dist continuous_const
  have hnear : ∀ᶠ x in 𝓝 (0 : ℝ), dist (Circle.exp x) (1 : Circle) < ε :=
    hcontinuous.continuousAt.eventually_lt continuousAt_const (by simpa using hε)
  have hpos : (0 : ℝ) < 2 * Real.pi := by positivity
  obtain ⟨x, hx, hi⟩ :=
    ((hnear.filter_mono nhdsWithin_le_nhds).and (Ioo_mem_nhdsGT hpos)).exists
  have hne : Circle.exp x ≠ 1 := by
    intro he
    have hinj := Circle.exp_injOn_Ico (a := 0) (b := 2 * Real.pi) (by simp)
    have hx₀ := hinj (Ioo_subset_Ico_self hi) ⟨le_rfl, hpos⟩ (he.trans Circle.exp_zero.symm)
    exact hi.1.ne' hx₀
  let W : Set Circle := Metric.ball 1 ε \ {1}
  have hW : IsOpen W := Metric.isOpen_ball.sdiff isClosed_singleton
  have hWne : W.Nonempty := ⟨Circle.exp x, hx, hne⟩
  obtain ⟨z, hz, ⟨n, rfl⟩⟩ := Dense.inter_open_nonempty hd W hW hWne
  have hval : ((u * quarticRotation ^ n : Circle) : ℂ) = quarticPoleValue a n := by
    rw [Circle.coe_mul, Circle.coe_zpow, quarticPoleValue]
  have hn : quarticPoleValue a n ≠ 1 := fun h ↦ hz.2 (Circle.ext (by
    rwa [hval, Circle.coe_one]))
  refine ⟨n, norm_pos_iff.mpr (sub_ne_zero.mpr hn.symm), ?_⟩
  have hdist : dist (u * quarticRotation ^ n) (1 : Circle) < ε := hz.1
  change dist ((u * quarticRotation ^ n : Circle) : ℂ) ((1 : Circle) : ℂ) < ε at hdist
  rw [norm_sub_rev]
  simpa only [hval, Circle.coe_one, dist_eq_norm] using hdist

theorem quarticEligible_exists (a : ℂ) (ha : ‖a‖ = 1) : ∃ n, QuarticEligible a n := by
  obtain ⟨n, hn, hn'⟩ := quarticPoleValue_approaches_one a ha 1 zero_lt_one
  exact ⟨n, by rwa [QuarticEligible, norm_inv, one_lt_inv₀ hn]⟩

/-- The Euler values at eligible double primary poles are unbounded. -/
theorem quarticEligible_euler_unbounded (a : ℂ) (ha : ‖a‖ = 1) :
    ¬ BddAbove ((fun n : ℤ ↦ ‖(1 - quarticPoleValue a n)⁻¹‖) '' {n | QuarticEligible a n}) := by
  rintro ⟨M, hM⟩
  have hM' : 1 ≤ max M 1 := le_max_right _ _
  have hMpos : 0 < max M 1 := zero_lt_one.trans_le hM'
  obtain ⟨n, hn, hn'⟩ := quarticPoleValue_approaches_one a ha _ (inv_pos.mpr hMpos)
  have hlt : max M 1 < ‖(1 - quarticPoleValue a n)⁻¹‖ := by
    rw [norm_inv]
    simpa only [inv_inv] using (inv_lt_inv₀ (inv_pos.mpr hMpos) hn).mpr hn'
  have he : QuarticEligible a n := hM'.trans_lt hlt
  exact (not_lt_of_ge (hM (mem_image_of_mem _ he))) ((le_max_left _ _).trans_lt hlt)

theorem quarticEligible_infinite (a : ℂ) (ha : ‖a‖ = 1) :
    {n : ℤ | QuarticEligible a n}.Infinite := by
  intro hfin
  exact quarticEligible_euler_unbounded a ha (hfin.image _).bddAbove

/-- The two secondary phases cannot both admit the common shift of #7336. -/
theorem quarticBenchmark_noCommonShift :
    ¬ QuarticCommonShift quarticPhasePlus ∨ ¬ QuarticCommonShift quarticPhaseMinus := by
  by_cases h : QuarticCommonShift quarticPhasePlus
  · right
    intro hb
    have hb₀ : quarticPhaseMinus ≠ 0 := norm_ne_zero_iff.mp (by simp [norm_quarticPhaseMinus])
    exact not_both_quarticCommonShift _ _ hb₀ quarticPhases_independent
      (quarticEligible_exists _ norm_quarticPhasePlus)
      (quarticEligible_exists _ norm_quarticPhaseMinus) ⟨h, hb⟩
  · exact Or.inl h

/-- At least one of the two phases gives infinitely many eligible pole heights, unbounded Euler
values, and no clearing shift or exact coincidence. -/
theorem quarticBenchmark_shiftedExample :
    ∃ a ∈ ({quarticPhasePlus, quarticPhaseMinus} : Set ℂ),
      (quarticPoleHeight '' {n : ℤ | QuarticEligible a n}).Infinite ∧
      ¬ BddAbove ((fun n : ℤ ↦ ‖(1 - quarticPoleValue a n)⁻¹‖) '' {n | QuarticEligible a n}) ∧
      ¬ QuarticCommonShift a ∧ ∀ n, quarticPoleValue a n ≠ 1 := by
  have hexample (a : ℂ) (ha : ‖a‖ = 1) (hshift : ¬ QuarticCommonShift a) :
      (quarticPoleHeight '' {n : ℤ | QuarticEligible a n}).Infinite ∧
      ¬ BddAbove ((fun n : ℤ ↦ ‖(1 - quarticPoleValue a n)⁻¹‖) '' {n | QuarticEligible a n}) ∧
      ¬ QuarticCommonShift a ∧ ∀ n, quarticPoleValue a n ≠ 1 :=
    ⟨(Set.infinite_image_iff quarticPoleHeight_injective.injOn).mpr (quarticEligible_infinite a ha),
      quarticEligible_euler_unbounded a ha,
      hshift, quarticPoleValue_ne_one_of_noCommonShift a hshift⟩
  rcases quarticBenchmark_noCommonShift with h | h
  · exact ⟨quarticPhasePlus, by simp, hexample _ norm_quarticPhasePlus h⟩
  · exact ⟨quarticPhaseMinus, by simp, hexample _ norm_quarticPhaseMinus h⟩

/-! ## Squared-height records -/

private theorem norm_one_sub_exp_turn (x : ℝ) :
    ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (x : ℂ))‖ =
      2 * |Real.sin (Real.pi * x)| := by
  have hx : (2 * (Real.pi : ℂ) * Complex.I) * (x : ℂ) =
      Complex.I * ((2 * Real.pi * x : ℝ) : ℂ) := by
    push_cast
    ring
  rw [norm_sub_rev, hx, Complex.norm_exp_I_mul_ofReal_sub_one, Real.norm_eq_abs, abs_mul,
    abs_of_pos (by norm_num : (0 : ℝ) < 2), show 2 * Real.pi * x / 2 = Real.pi * x by ring]

private theorem norm_one_sub_exp_turn_le (x : ℝ) :
    ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (x : ℂ))‖ ≤ 2 * Real.pi * |x| := by
  rw [norm_one_sub_exp_turn]
  calc
    _ ≤ 2 * |Real.pi * x| := mul_le_mul_of_nonneg_left Real.abs_sin_le_abs (by norm_num)
    _ = _ := by rw [abs_mul, abs_of_pos Real.pi_pos, mul_assoc]

private theorem norm_one_sub_exp_turn_eq_sin_abs {x : ℝ} (hx : |x| ≤ 1 / 2) :
    ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (x : ℂ))‖ =
      2 * Real.sin (Real.pi * |x|) := by
  have hπ : |Real.pi * x| ≤ Real.pi := by
    rw [abs_mul, abs_of_pos Real.pi_pos]
    exact mul_le_of_le_one_right Real.pi_pos.le (hx.trans (by norm_num))
  rw [norm_one_sub_exp_turn, Real.abs_sin_eq_sin_abs_of_abs_le_pi hπ, abs_mul,
    abs_of_pos Real.pi_pos]

private theorem norm_one_sub_exp_turn_mono {x y : ℝ} (hy : |y| ≤ 1 / 2) (hxy : |x| ≤ |y|) :
    ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (x : ℂ))‖ ≤
      ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (y : ℂ))‖ := by
  rw [norm_one_sub_exp_turn_eq_sin_abs (hxy.trans hy), norm_one_sub_exp_turn_eq_sin_abs hy]
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  apply Real.sin_le_sin_of_le_of_le_pi_div_two
  · linarith [Real.pi_pos, mul_nonneg Real.pi_pos.le (abs_nonneg x)]
  · simpa only [mul_one_div] using mul_le_mul_of_nonneg_left hy Real.pi_pos.le
  · exact mul_le_mul_of_nonneg_left hxy Real.pi_pos.le

private theorem abs_add_or_sub_le_of_abs_le_two_mul {x y : ℝ} (hy : |y| ≤ 2 * |x|) :
    |x + y| ≤ |x| ∨ |x - y| ≤ |x| := by
  by_cases hx : 0 ≤ x
  · rw [abs_of_nonneg hx] at hy ⊢
    by_cases hy₀ : 0 ≤ y
    · rw [abs_of_nonneg hy₀] at hy
      exact Or.inr (abs_le.mpr ⟨by linarith, by linarith⟩)
    · rw [abs_of_nonpos (le_of_not_ge hy₀)] at hy
      exact Or.inl (abs_le.mpr ⟨by linarith, by linarith⟩)
  · rw [abs_of_nonpos (le_of_not_ge hx)] at hy ⊢
    by_cases hy₀ : 0 ≤ y
    · rw [abs_of_nonneg hy₀] at hy
      exact Or.inl (abs_le.mpr ⟨by linarith, by linarith⟩)
    · rw [abs_of_nonpos (le_of_not_ge hy₀)] at hy
      exact Or.inr (abs_le.mpr ⟨by linarith, by linarith⟩)

private theorem norm_one_sub_exp_turn_signed_step {x y : ℝ}
    (hx : |x| ≤ 1 / 2) (hy : |y| ≤ 2 * |x|) :
    ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (↑(x + y) : ℂ))‖ ≤
        ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (x : ℂ))‖ ∨
      ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (↑(x - y) : ℂ))‖ ≤
        ‖1 - Complex.exp ((2 * Real.pi * Complex.I) * (x : ℂ))‖ :=
  (abs_add_or_sub_le_of_abs_le_two_mul hy).imp
    (norm_one_sub_exp_turn_mono hx) (norm_one_sub_exp_turn_mono hx)

private theorem exists_turn_of_norm_eq_one {z : ℂ} (hz : ‖z‖ = 1) :
    ∃ x : ℝ, |x| ≤ 1 / 2 ∧ Complex.exp ((2 * Real.pi * Complex.I) * (x : ℂ)) = z := by
  have hπ : 0 < 2 * Real.pi := by positivity
  refine ⟨z.arg / (2 * Real.pi), ?_, ?_⟩
  · rw [abs_div, abs_of_pos hπ, div_le_iff₀ hπ]
    linarith [Complex.abs_arg_le_pi z]
  · have harg : ((2 * Real.pi * Complex.I) * (↑(z.arg / (2 * Real.pi)) : ℂ)) =
        (z.arg : ℂ) * Complex.I := by
      push_cast
      field_simp [Complex.ofReal_ne_zero.mpr Real.pi_ne_zero]
    rw [harg]
    simpa only [hz, Complex.ofReal_one, one_mul] using Complex.norm_mul_exp_arg_mul_I z

private theorem quarticPoleValue_add_exp (a : ℂ) (n k p : ℤ) :
    quarticPoleValue a (n + k) = quarticPoleValue a n *
      Complex.exp ((2 * Real.pi * Complex.I) * (((p : ℝ) - (k : ℝ) * quarticLogRatio : ℝ) : ℂ)) := by
  unfold quarticPoleValue
  rw [zpow_add₀ (Circle.coe_ne_zero quarticRotation), ← mul_assoc]
  congr 1
  rw [quarticRotation_coe, ← Complex.exp_int_mul]
  have he : (2 * Real.pi * Complex.I) * (((p : ℝ) - (k : ℝ) * quarticLogRatio : ℝ) : ℂ) =
      (p : ℂ) * (2 * Real.pi * Complex.I) + (k : ℂ) * (-((quarticLogRatio : ℂ) * (2 * Real.pi * Complex.I))) := by
    push_cast
    ring
  rw [he, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, one_mul]

private theorem quarticPoleValue_dirichlet {Q : ℕ} (hQ : 0 < Q) (a : ℂ) (n : ℤ) :
    ∃ q : ℕ, 0 < q ∧ q ≤ Q ∧ ∃ y : ℝ, |y| ≤ 1 / ((Q : ℝ) + 1) ∧
      quarticPoleValue a (n + q) =
        quarticPoleValue a n * Complex.exp ((2 * Real.pi * Complex.I) * (-(y : ℂ))) ∧
      quarticPoleValue a (n - q) =
        quarticPoleValue a n * Complex.exp ((2 * Real.pi * Complex.I) * (y : ℂ)) := by
  obtain ⟨q, hq, hqQ, hr⟩ := Real.exists_nat_abs_mul_sub_round_le quarticLogRatio hQ
  let p : ℤ := round ((q : ℝ) * quarticLogRatio)
  refine ⟨q, hq, hqQ, (q : ℝ) * quarticLogRatio - (p : ℝ), hr, ?_, ?_⟩
  · rw [quarticPoleValue_add_exp a n q p]
    push_cast
    ring_nf
  · rw [sub_eq_add_neg, quarticPoleValue_add_exp a n (-(q : ℤ)) (-p)]
    push_cast
    ring_nf

/-- A quartic pole is a record when its outside Euler denominator is strictly smaller
than at every other eligible center through squared height. -/
def QuarticSquaredHeightRecord (a : ℂ) (n : ℤ) : Prop :=
  QuarticEligible a n ∧ ∀ m : ℤ, m ≠ n → QuarticEligible a m →
    2 + ‖quarticPoleHeight m‖ ≤ (2 + ‖quarticPoleHeight n‖) ^ 2 →
    ‖1 - quarticPoleValue a n‖ < ‖1 - quarticPoleValue a m‖

private theorem quarticPoleHeight_norm (n : ℤ) :
    ‖quarticPoleHeight n‖ = (2 * Real.pi / Real.log 49) * |(n : ℝ)| := by
  have hlog : 0 < Real.log 49 := Real.log_pos (by norm_num)
  rw [quarticPoleHeight, norm_div, norm_mul, norm_mul, norm_mul, Complex.norm_intCast,
    Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs, abs_of_pos Real.pi_pos,
    Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hlog]
  ring

/-- A nonzero squared-height record for a quartic phase with no clearing shift has
Euler denominator strictly smaller than \(\log(49)/(2n^2)\). -/
theorem quarticSquaredHeightRecord_bound (a : ℂ) (ha : ‖a‖ = 1) (hclear : ¬ QuarticCommonShift a)
    (n : ℤ) (hn : n ≠ 0) (hr : QuarticSquaredHeightRecord a n) :
    ‖1 - quarticPoleValue a n‖ < Real.log 49 / (2 * (n : ℝ) ^ 2) := by
  let c := 2 * Real.pi / Real.log 49
  -- The comparison window leaves room for this step in both directions.
  let limit := c * (n : ℝ) ^ 2 + 3 * |(n : ℝ)| + 2 / c
  let Q := ⌊limit⌋₊
  have hlog : 0 < Real.log 49 := Real.log_pos (by norm_num)
  have hc : 0 < c := div_pos (by positivity) hlog
  have hnReal : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  have hnAbs : 1 ≤ |(n : ℝ)| := by exact_mod_cast Int.one_le_abs hn
  have limit_ge_one : 1 ≤ limit := by
    dsimp only [limit]
    linarith [show 0 ≤ c * (n : ℝ) ^ 2 by positivity, show 0 ≤ 2 / c by positivity]
  have hQ : 0 < Q := by
    have hQ₁ : 1 ≤ Q := Nat.le_floor (by exact_mod_cast limit_ge_one)
    omega
  obtain ⟨q, hq, hqQ, y, hy, hplus, hminus⟩ := quarticPoleValue_dirichlet hQ a n
  have hq_le : (q : ℝ) ≤ limit := (Nat.cast_le.mpr hqQ).trans
    (Nat.floor_le (by linarith : 0 ≤ limit))
  have hwindow (m : ℤ) (hm : |(m : ℝ)| ≤ |(n : ℝ)| + (q : ℝ)) :
      2 + ‖quarticPoleHeight m‖ ≤ (2 + ‖quarticPoleHeight n‖) ^ 2 := by
    rw [quarticPoleHeight_norm, quarticPoleHeight_norm]
    change 2 + c * |(m : ℝ)| ≤ (2 + c * |(n : ℝ)|) ^ 2
    calc
      _ ≤ 2 + c * (|(n : ℝ)| + (q : ℝ)) := by gcongr
      _ ≤ 2 + c * (|(n : ℝ)| + limit) := by gcongr
      _ = _ := by
        dsimp only [limit]
        rw [← sq_abs (n : ℝ)]
        have hdiv : c * (2 / c) = 2 := by
          rw [← mul_div_assoc, mul_div_cancel_left₀ _ hc.ne']
        linear_combination hdiv
  have hwindowPlus : 2 + ‖quarticPoleHeight (n + q)‖ ≤ (2 + ‖quarticPoleHeight n‖) ^ 2 := by
    apply hwindow
    push_cast
    simpa only [abs_of_nonneg (show 0 ≤ (q : ℝ) from Nat.cast_nonneg q)] using abs_add_le (n : ℝ) (q : ℝ)
  have hwindowMinus : 2 + ‖quarticPoleHeight (n - q)‖ ≤ (2 + ‖quarticPoleHeight n‖) ^ 2 := by
    apply hwindow
    push_cast
    simpa only [abs_of_nonneg (show 0 ≤ (q : ℝ) from Nat.cast_nonneg q)] using abs_sub (n : ℝ) (q : ℝ)
  have hnorm : ‖quarticPoleValue a n‖ = 1 := by
    simp [quarticPoleValue, ha, norm_zpow, Circle.norm_coe]
  obtain ⟨x, hx, hxn⟩ := exists_turn_of_norm_eq_one hnorm
  have hlt : ‖1 - quarticPoleValue a n‖ < 1 := by
    have hp := norm_pos_iff.mpr (sub_ne_zero.mpr
      (quarticPoleValue_ne_one_of_noCommonShift a hclear n).symm)
    have h := hr.1
    rwa [QuarticEligible, norm_inv, one_lt_inv₀ hp] at h
  have hno (m : ℤ) (hm : m ≠ n) (hw : 2 + ‖quarticPoleHeight m‖ ≤ (2 + ‖quarticPoleHeight n‖) ^ 2)
      (hle : ‖1 - quarticPoleValue a m‖ ≤ ‖1 - quarticPoleValue a n‖) : False := by
    have hp := norm_pos_iff.mpr (sub_ne_zero.mpr
      (quarticPoleValue_ne_one_of_noCommonShift a hclear m).symm)
    have he : QuarticEligible a m := by
      rw [QuarticEligible, norm_inv, one_lt_inv₀ hp]
      exact hle.trans_lt hlt
    exact (not_lt_of_ge hle) (hr.2 m hm he hw)
  have hsmall : 2 * |x| < |y| := by
    by_contra! h
    rcases norm_one_sub_exp_turn_signed_step hx h with hcmp | hcmp
    · apply hno (n - q) (by omega) hwindowMinus
      rw [hminus, ← hxn, ← Complex.exp_add]
      push_cast at hcmp
      rw [mul_add] at hcmp
      exact hcmp
    · apply hno (n + q) (by omega) hwindowPlus
      rw [hplus, ← hxn, ← Complex.exp_add]
      push_cast at hcmp
      simpa only [sub_eq_add_neg, mul_add, mul_neg] using hcmp
  have hQbig : c * (n : ℝ) ^ 2 < (Q : ℝ) + 1 := by
    refine lt_of_le_of_lt ?_ (Nat.lt_floor_add_one limit)
    dsimp only [limit]
    linarith [show 0 ≤ 3 * |(n : ℝ)| by positivity, show 0 ≤ 2 / c by positivity]
  calc
    _ ≤ 2 * Real.pi * |x| := by rw [← hxn]; exact norm_one_sub_exp_turn_le x
    _ = Real.pi * (2 * |x|) := by ring
    _ < Real.pi * (1 / ((Q : ℝ) + 1)) :=
      mul_lt_mul_of_pos_left (hsmall.trans_le hy) Real.pi_pos
    _ = Real.pi / ((Q : ℝ) + 1) := by ring
    _ < Real.pi / (c * (n : ℝ) ^ 2) :=
      div_lt_div_of_pos_left Real.pi_pos (mul_pos hc (sq_pos_of_ne_zero hnReal)) hQbig
    _ = _ := by
      dsimp [c]
      field_simp [Real.pi_ne_zero, hlog.ne', hnReal]

/-! ## Mixed chord estimate -/

private theorem norm_one_sub_mul_le {x y : ℂ} (hx : ‖x‖ = 1) :
    ‖1 - x * y‖ ≤ ‖1 - x‖ + ‖1 - y‖ := by
  calc
    ‖1 - x * y‖ = ‖(1 - x) + x * (1 - y)‖ := by ring_nf
    _ ≤ ‖1 - x‖ + ‖x * (1 - y)‖ := norm_add_le _ _
    _ = ‖1 - x‖ + ‖1 - y‖ := by rw [norm_mul, hx, one_mul]

private theorem norm_one_sub_inv {x : ℂ} (hx : ‖x‖ = 1) :
    ‖1 - x⁻¹‖ = ‖1 - x‖ := by
  have hne : x ≠ 0 := by intro h; simp [h] at hx
  calc
    ‖1 - x⁻¹‖ = ‖x‖ * ‖1 - x⁻¹‖ := by rw [hx, one_mul]
    _ = ‖x * (1 - x⁻¹)‖ := (norm_mul _ _).symm
    _ = ‖x - 1‖ := by rw [mul_sub, mul_one, mul_inv_cancel₀ hne]
    _ = ‖1 - x‖ := norm_sub_rev _ _

private theorem norm_one_sub_zpow_le {x : ℂ} (hx : ‖x‖ = 1) (n : ℤ) :
    ‖1 - x ^ n‖ ≤ |(n : ℝ)| * ‖1 - x‖ := by
  have hNat (k : ℕ) : ‖1 - x ^ k‖ ≤ (k : ℝ) * ‖1 - x‖ := by
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, Nat.cast_succ, add_mul, one_mul]
      exact (norm_one_sub_mul_le (by simp [norm_pow, hx])).trans (add_le_add_left ih _)
  cases n with
  | ofNat n => simpa using hNat n
  | negSucc n =>
    rw [zpow_negSucc, norm_one_sub_inv (by simp [norm_pow, hx])]
    have hn : ((Int.negSucc n : ℤ) : ℝ) = -((n + 1 : ℕ) : ℝ) := by
      push_cast
      ring
    rw [hn, abs_neg, abs_of_nonneg (by positivity)]
    exact hNat (n + 1)

/-- Removing the common rotation couples the two denominators at distinct heights. -/
private theorem mixedChordBound (a b t : ℂ) (ha : ‖a‖ = 1) (hb : ‖b‖ = 1) (ht : ‖t‖ = 1)
    (m n : ℤ) :
    ‖1 - a ^ m * b ^ (-n)‖ ≤
      |(m : ℝ)| * ‖1 - a * t ^ n‖ + |(n : ℝ)| * ‖1 - b * t ^ m‖ := by
  have ht0 : t ≠ 0 := by intro h; simp [h] at ht
  have hleft : ‖a * t ^ n‖ = 1 := by simp [norm_zpow, ha, ht]
  have hright : ‖b * t ^ m‖ = 1 := by simp [norm_zpow, hb, ht]
  have hcancel : (a * t ^ n) ^ m * (b * t ^ m) ^ (-n) = a ^ m * b ^ (-n) := by
    calc
      _ = a ^ m * b ^ (-n) * (t ^ (n * m) * t ^ (m * (-n))) := by
        simp only [mul_zpow, zpow_mul]
        ac_rfl
      _ = a ^ m * b ^ (-n) := by
        rw [← zpow_add₀ ht0, show n * m + m * (-n) = 0 by ring, zpow_zero, mul_one]
  rw [← hcancel]
  have h := norm_one_sub_mul_le (x := (a * t ^ n) ^ m) (y := (b * t ^ m) ^ (-n))
    (by rw [norm_zpow, hleft, one_zpow])
  exact h.trans (add_le_add (norm_one_sub_zpow_le hleft m)
    (by simpa only [Int.cast_neg, abs_neg] using norm_one_sub_zpow_le hright (-n)))

/-- The principal logarithm on the unit circle is bounded by the chord length. -/
private theorem norm_log_le_chord {w : ℂ} (hw : ‖w‖ = 1) :
    (2 / Real.pi) * ‖Complex.log w‖ ≤ ‖1 - w‖ := by
  have hlog : Complex.log w = Complex.I * (w.arg : ℂ) := by
    simp [Complex.log, hw, mul_comm]
  have harg : |w.arg / 2| ≤ Real.pi / 2 := by
    rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    exact div_le_div_of_nonneg_right (Complex.abs_arg_le_pi w) (by norm_num)
  have hwe : Complex.exp (Complex.I * (w.arg : ℂ)) = w := by
    rw [← hlog]
    exact Complex.exp_log (by intro h; simp [h] at hw)
  have hchord : ‖1 - w‖ = 2 * |Real.sin (w.arg / 2)| := by
    conv_lhs => rw [norm_sub_rev 1 w, ← hwe, Complex.norm_exp_I_mul_ofReal_sub_one]
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  rw [hlog, norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs, hchord]
  convert mul_le_mul_of_nonneg_left (Real.mul_abs_le_abs_sin harg) (by norm_num : (0 : ℝ) ≤ 2) using 1
  rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  ring

private theorem norm_log_unit_le_pi {w : ℂ} (hw : ‖w‖ = 1) : ‖Complex.log w‖ ≤ Real.pi := by
  simpa [Complex.log, hw, Complex.norm_mul, Complex.norm_I, Complex.norm_real, Real.norm_eq_abs]
    using Complex.abs_arg_le_pi w

/-- Classical input: Baker–Wüstholz for three fixed complex logarithms, including the
principal logarithm of `-1`. See A. Baker and G. Wüstholz, *Logarithmic forms and group
varieties*, J. reine angew. Math. 442 (1993), 19–62, doi:10.1515/crll.1993.442.19,
and G. Wüstholz, *One Century of Logarithmic Forms*, §3, pp. 5–6.
Zero principal logarithms can be dropped. The constants depend on the fixed numbers. -/
private theorem bakerWustholz_fixedThreeLogs (a b : ℂ) (ha : IsAlgebraic ℚ a)
    (hb : IsAlgebraic ℚ b) (ha₀ : a ≠ 0) (hb₀ : b ≠ 0) :
    ∃ C > (0 : ℝ), ∃ d : ℕ, 0 < d ∧ ∀ m n k : ℤ,
      (m : ℂ) * Complex.log a - (n : ℂ) * Complex.log b -
          (2 * (k : ℂ)) * Complex.log (-1) ≠ 0 →
      C / (1 + |(m : ℝ)| + |(n : ℝ)| + |(k : ℝ)|) ^ d ≤
        ‖(m : ℂ) * Complex.log a - (n : ℂ) * Complex.log b -
          (2 * (k : ℂ)) * Complex.log (-1)‖ := by
  sorry

/-- A three-logarithm bound controls the chord of the mixed product. -/
private theorem polynomialMixedChordBound (a b : ℂ) (ha : ‖a‖ = 1) (hb : ‖b‖ = 1)
    (haAlg : IsAlgebraic ℚ a) (hbAlg : IsAlgebraic ℚ b) :
    ∃ C > (0 : ℝ), ∃ d : ℕ, 0 < d ∧ ∀ m n : ℤ, a ^ m * b ^ (-n) ≠ 1 →
      C / (1 + |(m : ℝ)| + |(n : ℝ)|) ^ d ≤ ‖1 - a ^ m * b ^ (-n)‖ := by
  have ha0 : a ≠ 0 := by intro h; simp [h] at ha
  have hb0 : b ≠ 0 := by intro h; simp [h] at hb
  obtain ⟨C, hC, d, hd, hBW⟩ := bakerWustholz_fixedThreeLogs a b haAlg hbAlg ha0 hb0
  refine ⟨(2 / Real.pi) * (C / 2 ^ d), by positivity, d, hd, ?_⟩
  intro m n hne
  let w : ℂ := a ^ m * b ^ (-n)
  let L : ℂ := (m : ℂ) * Complex.log a - (n : ℂ) * Complex.log b
  let H : ℝ := 1 + |(m : ℝ)| + |(n : ℝ)|
  have hw : ‖w‖ = 1 := by simp [w, norm_zpow, ha, hb]
  have hL : Complex.exp L = w := by
    dsimp [L, w]
    rw [sub_eq_add_neg, Complex.exp_add, ← neg_mul, ← Int.cast_neg, Complex.exp_int_mul,
      Complex.exp_int_mul, Complex.exp_log ha0, Complex.exp_log hb0]
  have hw0 : w ≠ 0 := by intro h; simp [h] at hw
  obtain ⟨k, hk⟩ := Complex.exp_eq_exp_iff_exists_int.mp (hL.trans (Complex.exp_log hw0).symm)
  have heq : L - (2 * (k : ℂ)) * Complex.log (-1) = Complex.log w := by
    rw [hk, Complex.log_neg_one]
    ring
  have hwlog : Complex.log w ≠ 0 := by
    intro h
    apply hne
    change w = 1
    simpa [h] using (Complex.exp_log hw0).symm
  have hk' : (k : ℂ) * (2 * Real.pi * Complex.I) = L - Complex.log w := by
    rw [hk]
    ring
  have hkabs : (2 * Real.pi) * |(k : ℝ)| ≤ Real.pi * H := by
    calc
      _ = ‖(k : ℂ) * (2 * Real.pi * Complex.I)‖ := by
        simp [Complex.norm_intCast, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos Real.pi_pos, mul_comm, mul_left_comm]
      _ = ‖L - Complex.log w‖ := congrArg norm hk'
      _ ≤ ‖L‖ + ‖Complex.log w‖ := norm_sub_le _ _
      _ ≤ (|(m : ℝ)| * ‖Complex.log a‖ + |(n : ℝ)| * ‖Complex.log b‖) + Real.pi :=
        add_le_add (by
          simpa only [L, norm_mul, Complex.norm_intCast] using
            (norm_sub_le ((m : ℂ) * Complex.log a) ((n : ℂ) * Complex.log b)))
          (norm_log_unit_le_pi hw)
      _ ≤ Real.pi * H := by
        have ha' := mul_le_mul_of_nonneg_left (norm_log_unit_le_pi ha) (abs_nonneg (m : ℝ))
        have hb' := mul_le_mul_of_nonneg_left (norm_log_unit_le_pi hb) (abs_nonneg (n : ℝ))
        dsimp [H]
        linarith
  have hkH : |(k : ℝ)| ≤ H := by
    exact le_of_mul_le_mul_left (by
      linarith [mul_nonneg Real.pi_pos.le (abs_nonneg (k : ℝ))]) Real.pi_pos
  have hBw : C / (H + |(k : ℝ)|) ^ d ≤ ‖Complex.log w‖ := by
    have hneL : L - (2 * (k : ℂ)) * Complex.log (-1) ≠ 0 := by rwa [heq]
    have hraw := hBW m n k hneL
    change C / (H + |(k : ℝ)|) ^ d ≤ ‖L - (2 * (k : ℂ)) * Complex.log (-1)‖ at hraw
    simpa only [heq] using hraw
  have hHs : 0 < H := by dsimp [H]; positivity
  have hcomp : C / (2 * H) ^ d ≤ ‖Complex.log w‖ := by
    refine le_trans ?_ hBw
    gcongr
    linarith
  change (2 / Real.pi) * (C / 2 ^ d) / H ^ d ≤ ‖1 - w‖
  calc
    _ = (2 / Real.pi) * (C / (2 * H) ^ d) := by rw [mul_pow]; ring
    _ ≤ (2 / Real.pi) * ‖Complex.log w‖ := mul_le_mul_of_nonneg_left hcomp (by positivity)
    _ ≤ _ := norm_log_le_chord hw

/-- On the primary pole lattice the two secondary chords satisfy a mixed inverse-polynomial
lower bound. The common rotation cancels in the middle expression. -/
theorem quarticBenchmark_twoPlaceBound :
    ∃ C > (0 : ℝ), ∃ d : ℕ, 0 < d ∧ ∀ m n : ℤ, m ≠ 0 ∨ n ≠ 0 →
      C / (1 + |(m : ℝ)| + |(n : ℝ)|) ^ d ≤
        ‖1 - quarticPhasePlus ^ m * quarticPhaseMinus ^ (-n)‖ ∧
      ‖1 - quarticPhasePlus ^ m * quarticPhaseMinus ^ (-n)‖ ≤
        |(m : ℝ)| * ‖1 - quarticPoleValue quarticPhasePlus n‖ +
        |(n : ℝ)| * ‖1 - quarticPoleValue quarticPhaseMinus m‖ := by
  obtain ⟨C, hC, d, hd, hbound⟩ := polynomialMixedChordBound _ _
    norm_quarticPhasePlus norm_quarticPhaseMinus algebraic_quarticPhasePlus algebraic_quarticPhaseMinus
  refine ⟨C, hC, d, hd, fun m n hmn ↦ ⟨hbound m n ?_, ?_⟩⟩
  · intro he
    obtain ⟨hm, hn⟩ := quarticPhases_independent m (-n) he
    exact hmn.elim (fun h ↦ h hm) (fun h ↦ h (neg_eq_zero.mp hn))
  · exact mixedChordBound _ _ _ norm_quarticPhasePlus norm_quarticPhaseMinus
      (Circle.norm_coe quarticRotation) m n

/-! ## Orbital indices from local Euler profiles -/

section OrbitalIndices

open IsDedekindDomain

variable {F : Type*} [Field F] [NumberField F]
variable {T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))}

local notation "J" => SIdeleQuotient F T
local notation "m" => sIdeleQuotientNorm F T
set_option quotPrecheck false in
local notation "shift" => quasiCharacterNormTwist m (isProperMap_sIdeleQuotientNorm F T).continuous
set_option quotPrecheck false in
local notation "E(" v ", " c ")" => finiteLocalEulerFactor (v).val (sLocalFiniteRestriction v c)

private theorem orbital_finiteRestriction_shift (v : T) (c : QuasiCharacter J) (s : ℂ)
    (x : (v.val.adicCompletion F)ˣ) :
    sLocalFiniteRestriction v (shift c s) x = sLocalFiniteRestriction v c x * (‖x.val‖ : ℂ) ^ s := by
  obtain ⟨g, hg⟩ : ∃ g : J, ∀ d : QuasiCharacter J, sLocalFiniteRestriction v d x = d g :=
    ⟨_, fun _ ↦ rfl⟩
  have h := sLocalFiniteRestriction_norm v x
  rw [hg] at h
  change ((1 : PontryaginDual J) g : ℂ) * _ ^ (1 : ℂ) = _ at h
  simp only [PontryaginDual.one_apply, Circle.coe_one, Complex.cpow_one, one_mul] at h
  rw [hg, hg]
  exact congrArg (fun t : ℂ ↦ c g * t ^ s) h

/-- At an unramified finite place, the Euler factor along the norm chart is determined by
the phase on any local element of reciprocal residue norm. -/
theorem orbital_localEulerProfile (v : T) (c : QuasiCharacter J)
    (p : (v.val.adicCompletion F)ˣ) (hp : ‖p.val‖ = (v.val.asIdeal.absNorm : ℝ)⁻¹)
    (a : ℂ) (ha : sLocalFiniteRestriction v c p = a)
    (hunit : ∀ u : (v.val.adicCompletion F)ˣ, ‖u.val‖ = 1 → sLocalFiniteRestriction v c u = 1)
    (s : ℂ) :
    finiteLocalEulerFactor v.val (sLocalFiniteRestriction v (shift c s)) =
      (1 - a * Complex.exp (-(Real.log (v.val.asIdeal.absNorm : ℝ) : ℂ) * s))⁻¹ := by
  classical
  let ι := Units.map (v.val.adicCompletionIntegers F).subtype.toMonoidHom
  have hunram : ∀ u : (v.val.adicCompletionIntegers F)ˣ,
      sLocalFiniteRestriction v (shift c s) (ι u) = 1 := by
    intro u
    have hn : ‖(ι u).val‖ = 1 := Valued.toNormedField.norm_eq_one_iff.mpr
      ((HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one (a := ι u)).mp
        ⟨u.val.property, u.inv.property⟩)
    rw [orbital_finiteRestriction_shift, hunit _ hn, hn, Complex.ofReal_one,
      Complex.one_cpow, mul_one]
  rw [finiteLocalEulerFactor, ite_eq_left hunram]
  let hπ := (Valued.v : Valuation (v.val.adicCompletion F)
    (WithZero (Multiplicative ℤ))).exists_isUniformizer_of_isCyclic_of_nontrivial
  let π : (v.val.adicCompletion F)ˣ := Units.mk0 hπ.choose hπ.choose_spec.ne_zero
  have hπn : ‖π.val‖ = (v.val.asIdeal.absNorm : ℝ)⁻¹ :=
    norm_uniformizer_adicCompletion v.val _ hπ.choose_spec
  have hquot : ‖(π / p).val‖ = 1 := by
    rw [Units.val_div_eq_div_val, norm_div, hπn, ← hp, div_self (norm_ne_zero_iff.mpr p.ne_zero)]
  have hπa : sLocalFiniteRestriction v c π = a := by
    calc
      _ = sLocalFiniteRestriction v c (π / p * p) := by rw [div_mul_cancel]
      _ = _ := by rw [map_mul, hunit _ hquot, ha, one_mul]
  change (1 - sLocalFiniteRestriction v (shift c s) π)⁻¹ = _
  rw [orbital_finiteRestriction_shift, hπa,
    Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr π.ne_zero)),
    ← Complex.ofReal_log (norm_nonneg _), hπn, Real.log_inv, Complex.ofReal_neg]

/-- Restriction to a retained finite coordinate commutes with passage to the S-local quotient. -/
theorem orbital_finiteRestriction_sIdeleRestriction (c : unramifiedOutside F T) (v : T)
    (x : (v.val.adicCompletion F)ˣ) :
    sLocalFiniteRestriction v (sIdeleRestriction F T c) x =
      finitePlaceRestriction F v.val c.val x := by
  classical
  let i : (SAdeleRing F T)ˣ := (ContinuousMulEquiv.prodUnits
    (InfiniteAdeleRing F) ((w : T) → w.val.adicCompletion F)).symm
    (1, (ContinuousMulEquiv.piUnits (M := fun w : T ↦ w.val.adicCompletion F)).symm
      (@Pi.mulSingle _ _ _ (Classical.decEq _) v x))
  change sIdeleRestriction F T c (QuotientGroup.mk i) =
    c.val (IdeleClassGroup.ofAdicCompletion (𝓞 F) F v.val x)
  rw [sIdeleRestriction_mk]
  change c.val (QuotientGroup.mk (sIdeleInsertion F T i)) =
    c.val (QuotientGroup.mk (IdeleGroup.ofAdicCompletion (𝓞 F) F v.val x))
  congr 2
  apply Units.ext
  refine Prod.ext ((sIdeleInsertion_apply F T i).1.trans rfl) ?_
  apply RestrictedProduct.ext
  intro u
  by_cases hu : u ∈ T
  · refine Eq.trans ((sIdeleInsertion_apply F T i).2.1 ⟨u, hu⟩) ?_
    change (@Pi.mulSingle T (fun w : T ↦ (w.val.adicCompletion F)ˣ)
      _ (Classical.decEq _) v x ⟨u, hu⟩).val =
      FiniteAdeleRing.ofAdicCompletion F v.val x.val u
    refine Eq.trans ?_ (FiniteAdeleRing.ofAdicCompletion_apply_coe F v.val x.val u).symm
    by_cases h : u = v.val
    · subst u
      change (@Pi.mulSingle T (fun w : T ↦ (w.val.adicCompletion F)ˣ)
        _ (Classical.decEq _) v x v).val = _
      have hl := @Pi.mulSingle_eq_same T (fun w : T ↦ (w.val.adicCompletion F)ˣ)
        _ (Classical.decEq _) v x
      have hr := @Pi.mulSingle_eq_same (HeightOneSpectrum (𝓞 F))
        (fun w ↦ w.adicCompletion F) _ (Classical.decEq _) v.val x.val
      exact (congrArg Units.val hl).trans hr.symm
    · have hne : (⟨u, hu⟩ : T) ≠ v := fun e ↦ h (congrArg Subtype.val e)
      have hleft := @Pi.mulSingle_eq_of_ne T (fun w : T ↦ (w.val.adicCompletion F)ˣ)
        _ (Classical.decEq _) v ⟨u, hu⟩ hne x
      rw [hleft, Pi.mulSingle_eq_of_ne h, Units.val_one]
  · refine Eq.trans ((sIdeleInsertion_apply F T i).2.2 u hu) ?_
    have hne : u ≠ v.val := by
      intro h
      exact hu (h.symm ▸ v.property)
    exact ((FiniteAdeleRing.ofAdicCompletion_apply_coe F v.val x.val u).trans
      (Pi.mulSingle_eq_of_ne hne _)).symm

private theorem quarticOrbital_twist_add (c : QuasiCharacter J) (s z : ℂ) :
    shift (shift c s) z = shift c (s + z) := by
  ext1 g
  let q : ℂ := (((m g).val : ℝ) : ℂ)
  have hq : q ≠ 0 := Complex.ofReal_ne_zero.mpr (NNReal.coe_ne_zero.mpr (m g).ne_zero)
  change c g * q ^ s * q ^ z = c g * q ^ (s + z)
  rw [Complex.cpow_add _ _ hq, mul_assoc]

private theorem quarticOrbital_mem_pole (c : QuasiCharacter J) (w : T) (L : ℂ) (hL : L ≠ 0)
    (s : ℂ) (hs : Complex.exp (-L * s) = 1)
    (hE : ∀ z, E(w, shift c z) = (1 - Complex.exp (-L * z))⁻¹) :
    w ∈ sLocalFinitePolePlaces (shift c s) := by
  classical
  simp only [sLocalFinitePolePlaces, Finset.mem_filter, Finset.mem_univ, true_and]
  change meromorphicOrderAt (fun z ↦ E(w, shift (shift c s) z)) 0 < 0
  have he : (fun z ↦ E(w, shift (shift c s) z)) =
      fun z ↦ (1 - Complex.exp (-L * z))⁻¹ := by
    funext z
    rw [quarticOrbital_twist_add, hE, mul_add, Complex.exp_add, hs, one_mul]
  rw [he]
  let A (z : ℂ) := 1 - Complex.exp (-L * z)
  have hA : AnalyticAt ℂ A 0 := by dsimp only [A]; fun_prop
  have hd : HasDerivAt A L 0 := by
    have hx := ((hasDerivAt_id (0 : ℂ)).const_mul (-L)).cexp
    simpa [A] using hx.const_sub (1 : ℂ)
  have hord : analyticOrderAt A 0 = (1 : ℕ∞) := by
    apply (analyticOrderAt_eq_nat_iff_iteratedDeriv_eq_zero hA (n := 1)).mpr
    refine ⟨fun k hk ↦ ?_, ?_⟩
    · have : k = 0 := by omega
      simp [this, A]
    · simpa [iteratedDeriv_one, hd.deriv] using hL
  have hm : meromorphicOrderAt A 0 = 1 := by
    simpa [hord] using hA.meromorphicOrderAt_eq
  change meromorphicOrderAt A⁻¹ 0 < 0
  rw [meromorphicOrderAt_inv, hm]
  exact WithTop.coe_lt_coe.mpr (by decide : (-1 : ℤ) < 0)

/-- Two primary Euler profiles give offset-one orbital indices. A norm section on which the
base character is trivial reads off their prescribed heights, and the outside Euler profile
is retained at those indices. -/
theorem orbitalIndices_of_localEulerProfiles
    (P : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) (c : QuasiCharacter J)
    (χ : PontryaginDual (m).ker)
    (hc : normOneRestriction m c =
      (⟨Circle.coeHom, continuous_subtype_val⟩ : Circle →ₜ* ℂ).comp χ)
    (τ : ℝ≥0ˣ →ₜ* J) (hτ : Function.RightInverse τ m) (hcτ : ∀ x, c (τ x) = 1)
    (w₁ w₂ v : T) (hw₁ : w₁.val ∈ P) (hw₂ : w₂.val ∈ P) (hw : w₁ ≠ w₂)
    (s : ℤ → ℂ) (L Q a : ℂ) (hL : L ≠ 0) (hs : ∀ n, Complex.exp (-L * s n) = 1)
    (hPrimary : ∀ w ∈ ({w₁, w₂} : Set T), ∀ z,
      E(w, shift c z) = (1 - Complex.exp (-L * z))⁻¹)
    (hOutside : ∀ z, E(v, shift c z) = (1 - a * Complex.exp (-Q * z))⁻¹) :
    ∃ j : ℤ → SLocalOrbitalIndex (S := T) P χ, ∀ n,
      (j n).val.2 = 1 ∧
      w₁ ∈ sLocalFinitePolePlaces (j n).val.1 ∧ w₂ ∈ sLocalFinitePolePlaces (j n).val.1 ∧
      (existsUnique_complexPower ((j n).val.1.comp τ)).exists.choose = s n ∧
      E(v, (j n).val.1) = (1 - a * Complex.exp (-Q * s n))⁻¹ := by
  classical
  have hcomponent (z : ℂ) : normOneRestriction m (shift c z) = normOneRestriction m c := by
    ext1 g
    change c g.val * (((m g.val).val : ℝ) : ℂ) ^ z = c g.val
    rw [MonoidHom.mem_ker.mp g.property, Units.val_one, NNReal.coe_one, Complex.ofReal_one,
      Complex.one_cpow, mul_one]
  have h₁ (n : ℤ) : w₁ ∈ sLocalFinitePolePlaces (shift c (s n)) :=
    quarticOrbital_mem_pole c w₁ L hL (s n) (hs n) (hPrimary w₁ (by simp))
  have h₂ (n : ℤ) : w₂ ∈ sLocalFinitePolePlaces (shift c (s n)) :=
    quarticOrbital_mem_pole c w₂ L hL (s n) (hs n) (hPrimary w₂ (by simp))
  have hmul (n : ℤ) : 1 < sLocalFinitePoleMultiplicity P (shift c (s n)) :=
    Finset.one_lt_card.mpr
      ⟨w₁, Finset.mem_filter.mpr ⟨h₁ n, hw₁⟩, w₂, Finset.mem_filter.mpr ⟨h₂ n, hw₂⟩, hw⟩
  refine ⟨fun n ↦ ⟨(shift c (s n), 1), (hcomponent _).trans hc, hmul n⟩,
    fun n ↦ ⟨rfl, h₁ n, h₂ n, ?_, hOutside (s n)⟩⟩
  let X := (shift c (s n)).comp τ
  apply (existsUnique_complexPower X).unique (existsUnique_complexPower X).exists.choose_spec
  intro x
  change c (τ x) * (((m (τ x)).val : ℝ) : ℂ) ^ s n = ((x.val : ℝ) : ℂ) ^ s n
  rw [hcτ, hτ, one_mul]

/-- Unbounded Euler values on a sequence of repeated poles force both unbounded Euler values
and infinitely many distinct centers in the section's eligible orbital set. -/
theorem orbitalEligible_infinite_and_unbounded
    {P : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))} {χ : PontryaginDual (m).ker}
    (v w : T) (j : ℤ → SLocalOrbitalIndex (S := T) P χ) (e : ℤ → ℝ)
    (hj : ∀ n, (j n).val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces (j n).val.1 ∧
      ‖E(v, (j n).val.1)‖ = e n)
    (he : ¬ BddAbove (e '' {n | 1 < e n})) :
    let A := {k : SLocalOrbitalIndex (S := T) P χ |
      k.val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces k.val.1 ∧ 1 < ‖E(v, k.val.1)‖}
    ((fun k ↦ k.val.1) '' A).Infinite ∧ ¬ BddAbove ((fun k ↦ ‖E(v, k.val.1)‖) '' A) := by
  dsimp only
  let A := {k : SLocalOrbitalIndex (S := T) P χ |
    k.val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces k.val.1 ∧ 1 < ‖E(v, k.val.1)‖}
  let c (k : SLocalOrbitalIndex (S := T) P χ) := k.val.1
  let M (d : QuasiCharacter J) := ‖E(v, d)‖
  change (c '' A).Infinite ∧ ¬ BddAbove ((M ∘ c) '' A)
  have hsub : e '' {n | 1 < e n} ⊆ (M ∘ c) '' A := by
    rintro _ ⟨n, hn, rfl⟩
    obtain ⟨hoff, hpole, hval⟩ := hj n
    refine ⟨j n, ⟨hoff, hpole, ?_⟩, hval⟩
    rwa [hval]
  have hA : ¬ BddAbove ((M ∘ c) '' A) := fun h ↦ he (h.mono hsub)
  refine ⟨fun h ↦ hA ?_, hA⟩
  exact (Set.image_image M c A) ▸ (h.image M).bddAbove

private theorem orbital_uniformizer_of_euler_profile
    (v : T) (c : ℤ → QuasiCharacter J) (z : ℤ → ℂ) (hz : ∀ n, z n ≠ 0)
    (hE : ∀ n, E(v, c n) = (1 - z n)⁻¹) :
    ∃ u : (v.val.adicCompletion F)ˣ, ‖u.val‖ = (v.val.asIdeal.absNorm : ℝ)⁻¹ ∧
      ∀ n, sLocalFiniteRestriction v (c n) u = z n := by
  classical
  let π := (Valued.v : Valuation (v.val.adicCompletion F)
    (WithZero (Multiplicative ℤ))).exists_isUniformizer_of_isCyclic_of_nontrivial
  let u : (v.val.adicCompletion F)ˣ := Units.mk0 π.choose π.choose_spec.ne_zero
  refine ⟨u, norm_uniformizer_adicCompletion v.val _ π.choose_spec, fun n ↦ ?_⟩
  have h := hE n
  unfold finiteLocalEulerFactor at h
  split at h
  · change (1 - sLocalFiniteRestriction v (c n) u)⁻¹ = (1 - z n)⁻¹ at h
    exact sub_right_inj.mp (inv_injective h)
  · have h' : (1 - z n)⁻¹ = (1 : ℂ)⁻¹ := by simpa only [inv_one] using h.symm
    exact (hz n (sub_eq_self.mp (inv_injective h'))).elim

/-- A common shift on the section's eligible orbital set would restrict to a common shift
on every eligible member of the scalar sequence. The Euler profile determines its
uniformizer values as soon as the prescribed local phases are nonzero. -/
theorem orbitalEligible_noCommonShift
    {P : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))} {χ : PontryaginDual (m).ker}
    (v w : T) (j : ℤ → SLocalOrbitalIndex (S := T) P χ) (τ : ℝ≥0ˣ →ₜ* J)
    (s z : ℤ → ℂ) (hz : ∀ n, z n ≠ 0)
    (hj : ∀ n, (j n).val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces (j n).val.1 ∧
      (existsUnique_complexPower ((j n).val.1.comp τ)).exists.choose = s n ∧
      E(v, (j n).val.1) = (1 - z n)⁻¹)
    (hclear : ¬ ∃ σ : ℂ, ∃ N : ℕ, 0 < N ∧ ∀ n, 1 < ‖(1 - z n)⁻¹‖ →
      Complex.exp (N * (-(Real.log w.val.asIdeal.absNorm : ℂ) * (s n - σ))) = 1 ∧
      z n ^ N = Complex.exp (N * (-(Real.log v.val.asIdeal.absNorm : ℂ) * (s n - σ)))) :
    ∃ u : (v.val.adicCompletion F)ˣ, ‖u.val‖ = (v.val.asIdeal.absNorm : ℝ)⁻¹ ∧
      let A := {k : SLocalOrbitalIndex (S := T) P χ |
        k.val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces k.val.1 ∧ 1 < ‖E(v, k.val.1)‖}
      let t (k : SLocalOrbitalIndex (S := T) P χ) :=
        (existsUnique_complexPower (k.val.1.comp τ)).exists.choose
      ¬ ∃ σ : ℂ, ∃ N : ℕ, 0 < N ∧ ∀ k ∈ A,
        Complex.exp (N * (-(Real.log w.val.asIdeal.absNorm : ℂ) * (t k - σ))) = 1 ∧
        sLocalFiniteRestriction v k.val.1 u ^ N =
          Complex.exp (N * (-(Real.log v.val.asIdeal.absNorm : ℂ) * (t k - σ))) := by
  obtain ⟨u, hu, hval⟩ :=
    orbital_uniformizer_of_euler_profile v (fun n ↦ (j n).val.1) z hz (fun n ↦ (hj n).2.2.2)
  refine ⟨u, hu, ?_⟩
  dsimp only
  rintro ⟨σ, N, hN, hA⟩
  refine hclear ⟨σ, N, hN, fun n hn ↦ ?_⟩
  obtain ⟨hoff, hpole, hheight, hE⟩ := hj n
  have h := hA (j n) ⟨hoff, hpole, by rwa [hE]⟩
  simpa only [hheight, hval n] using h

/-- Given the four local profiles of the quartic benchmark, one of the two secondary places
has infinitely many eligible orbital centers, unbounded Euler values, and no common shift. -/
theorem quarticBenchmark_orbitalExample_of_localEulerProfiles
    (P : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) (c : QuasiCharacter J)
    (χ : PontryaginDual (m).ker)
    (hc : normOneRestriction m c =
      (⟨Circle.coeHom, continuous_subtype_val⟩ : Circle →ₜ* ℂ).comp χ)
    (τ : ℝ≥0ˣ →ₜ* J) (hτ : Function.RightInverse τ m) (hcτ : ∀ x, c (τ x) = 1)
    (w₁ w₂ vPlus vMinus : T) (hw₁ : w₁.val ∈ P) (hw₂ : w₂.val ∈ P) (hw : w₁ ≠ w₂)
    (h49 : w₁.val.asIdeal.absNorm = 49)
    (h17 : ∀ v ∈ ({vPlus, vMinus} : Set T), v.val.asIdeal.absNorm = 17)
    (hPrimary : ∀ w ∈ ({w₁, w₂} : Set T), ∀ z,
      E(w, shift c z) = (1 - Complex.exp (-(Real.log 49 : ℂ) * z))⁻¹)
    (hPlus : ∀ z, E(vPlus, shift c z) =
      (1 - quarticPhasePlus * Complex.exp (-(Real.log 17 : ℂ) * z))⁻¹)
    (hMinus : ∀ z, E(vMinus, shift c z) =
      (1 - quarticPhaseMinus * Complex.exp (-(Real.log 17 : ℂ) * z))⁻¹) :
    ∃ v ∈ ({vPlus, vMinus} : Set T),
      let A := {j : SLocalOrbitalIndex (S := T) P χ |
        j.val.2 ≠ 0 ∧ w₁ ∈ sLocalFinitePolePlaces j.val.1 ∧ 1 < ‖E(v, j.val.1)‖}
      let t (j : SLocalOrbitalIndex (S := T) P χ) :=
        (existsUnique_complexPower (j.val.1.comp τ)).exists.choose
      ((fun j ↦ j.val.1) '' A).Infinite ∧ ¬ BddAbove ((fun j ↦ ‖E(v, j.val.1)‖) '' A) ∧
      ∃ u : (v.val.adicCompletion F)ˣ, ‖u.val‖ = (v.val.asIdeal.absNorm : ℝ)⁻¹ ∧
        ¬ ∃ σ : ℂ, ∃ N : ℕ, 0 < N ∧ ∀ j ∈ A,
          Complex.exp (N * (-(Real.log w₁.val.asIdeal.absNorm : ℂ) * (t j - σ))) = 1 ∧
          sLocalFiniteRestriction v j.val.1 u ^ N =
            Complex.exp (N * (-(Real.log v.val.asIdeal.absNorm : ℂ) * (t j - σ))) := by
  let conclusion (v : T) :=
    let A := {j : SLocalOrbitalIndex (S := T) P χ |
      j.val.2 ≠ 0 ∧ w₁ ∈ sLocalFinitePolePlaces j.val.1 ∧ 1 < ‖E(v, j.val.1)‖}
    let t (j : SLocalOrbitalIndex (S := T) P χ) :=
      (existsUnique_complexPower (j.val.1.comp τ)).exists.choose
    ((fun j ↦ j.val.1) '' A).Infinite ∧ ¬ BddAbove ((fun j ↦ ‖E(v, j.val.1)‖) '' A) ∧
    ∃ u : (v.val.adicCompletion F)ˣ, ‖u.val‖ = (v.val.asIdeal.absNorm : ℝ)⁻¹ ∧
      ¬ ∃ σ : ℂ, ∃ N : ℕ, 0 < N ∧ ∀ j ∈ A,
        Complex.exp (N * (-(Real.log w₁.val.asIdeal.absNorm : ℂ) * (t j - σ))) = 1 ∧
        sLocalFiniteRestriction v j.val.1 u ^ N =
          Complex.exp (N * (-(Real.log v.val.asIdeal.absNorm : ℂ) * (t j - σ)))
  have hcheck (v : T) (hv : v ∈ ({vPlus, vMinus} : Set T)) (a : ℂ) (ha : ‖a‖ = 1)
      (hshift : ¬ QuarticCommonShift a)
      (hOutside : ∀ z, E(v, shift c z) =
        (1 - a * Complex.exp (-(Real.log 17 : ℂ) * z))⁻¹) : conclusion v := by
    obtain ⟨j, hj⟩ := orbitalIndices_of_localEulerProfiles P c χ hc τ hτ hcτ
      w₁ w₂ v hw₁ hw₂ hw quarticPoleHeight (Real.log 49 : ℂ) (Real.log 17 : ℂ) a
        quartic_primary_log_ne_zero quartic_pole hPrimary hOutside
    have hdata (n : ℤ) : (j n).val.2 ≠ 0 ∧ w₁ ∈ sLocalFinitePolePlaces (j n).val.1 ∧
        (existsUnique_complexPower ((j n).val.1.comp τ)).exists.choose = quarticPoleHeight n ∧
        E(v, (j n).val.1) = (1 - quarticPoleValue a n)⁻¹ := by
      obtain ⟨hoff, hw₁, _, ht, hE⟩ := hj n
      exact ⟨hoff.trans_ne (by decide), hw₁, ht, by rwa [quarticPoleValue_eq]⟩
    have he := orbitalEligible_infinite_and_unbounded v w₁ j
      (fun n ↦ ‖(1 - quarticPoleValue a n)⁻¹‖)
      (fun n ↦ ⟨(hdata n).1, (hdata n).2.1, congrArg norm (hdata n).2.2.2⟩)
      (quarticEligible_euler_unbounded a ha)
    have hnz (n : ℤ) : quarticPoleValue a n ≠ 0 := by
      rw [quarticPoleValue_eq]
      exact mul_ne_zero (norm_ne_zero_iff.mp (by simp [ha])) (Complex.exp_ne_zero _)
    have hns := orbitalEligible_noCommonShift v w₁ j τ quarticPoleHeight
      (quarticPoleValue a) hnz hdata (by
        simpa only [h49, h17 v hv, Nat.cast_ofNat, QuarticCommonShift, QuarticEligible] using hshift)
    exact ⟨he.1, he.2, hns⟩
  rcases quarticBenchmark_noCommonShift with h | h
  · exact ⟨vPlus, by simp, hcheck vPlus (by simp) _ norm_quarticPhasePlus h hPlus⟩
  · exact ⟨vMinus, by simp, hcheck vMinus (by simp) _ norm_quarticPhaseMinus h hMinus⟩

end OrbitalIndices

section OrbitalRecord

variable {F : Type*} [Field F] [NumberField F]
    {T P : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))}
    {χ : PontryaginDual (sIdeleQuotientNorm F T).ker}

local notation "I" => SLocalOrbitalIndex (S := T) P χ
set_option quotPrecheck false in
local notation "E(" v ", " k ")" => finiteLocalEulerFactor (v : T).val
  (sLocalFiniteRestriction v (k : I).val.1)

/-- A record among section orbital indices is a record on the quartic lattice whenever
the lattice family supplies its eligible competitors and their uniformizer phases. -/
theorem quarticSquaredHeightRecord_of_orbitalRecord
    (v w : T) (τ : ℝ≥0ˣ →ₜ* SIdeleQuotient F T) (u : (v.val.adicCompletion F)ˣ)
    (j : ℤ → I) (a : ℂ) (n : ℤ)
    (hj : ∀ m, (j m).val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces (j m).val.1 ∧
      (existsUnique_complexPower ((j m).val.1.comp τ)).exists.choose = quarticPoleHeight m ∧
      E(v, j m) = (1 - quarticPoleValue a m)⁻¹ ∧
      sLocalFiniteRestriction v (j m).val.1 u = quarticPoleValue a m)
    (hr :
      let A := {k : I | k.val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces k.val.1 ∧ 1 < ‖E(v, k)‖}
      let t (k : I) := (existsUnique_complexPower (k.val.1.comp τ)).exists.choose
      let z (k : I) := sLocalFiniteRestriction v k.val.1 u
      j n ∈ A ∧ ∀ k ∈ A, k.val.1 ≠ (j n).val.1 →
        2 + ‖t k‖ ≤ (2 + ‖t (j n)‖)^2 → ‖1 - z (j n)‖ < ‖1 - z k‖) :
    QuarticSquaredHeightRecord a n := by
  dsimp only at hr
  refine ⟨?_, fun m hne hm hle ↦ ?_⟩
  · have h := hr.1.2.2
    rwa [(hj n).2.2.2.1] at h
  · obtain ⟨hoff, hpole, hmHeight, hmEuler, hmPhase⟩ := hj m
    obtain ⟨_, _, hnHeight, _, hnPhase⟩ := hj n
    have hdistinct : (j m).val.1 ≠ (j n).val.1 := by
      intro h
      apply hne
      apply quarticPoleHeight_injective
      rw [← hmHeight, ← hnHeight, h]
    have h := hr.2 (j m) ⟨hoff, hpole, by rwa [hmEuler]⟩ hdistinct (by
      simpa only [hmHeight, hnHeight] using hle)
    simpa only [hmPhase, hnPhase] using h

end OrbitalRecord

/-! ## Realization of the quartic benchmark -/

section QuarticRealization

open IsDedekindDomain
open scoped Classical in
private theorem quarticLocalProfile {T : Finset (HeightOneSpectrum (𝓞 F₈))}
    {w₁ w₂ : InfinitePlace F₈} (E₁ : w₁.Completion →+* ℂ) (E₂ : w₂.Completion →+* ℂ)
    (c₀ : unramifiedOutside F₈ ∅) (c : unramifiedOutside F₈ T) (hc : c.val = c₀.val)
    (harch : ∀ u : (integralAdelesOutside F₈ ∅)ˣ,
      let z₁ := E₁ (u.val.val.1 w₁)
      let z₂ := E₂ (u.val.val.1 w₂)
      c₀.val (QuotientGroup.mk (integralIdeleInsertion F₈ ∅ u)) =
        (z₂ / star z₂) / (z₁ / star z₁) ^ 3)
    (v : T) (x : 𝓞 F₈) (hx : v.val.asIdeal = Ideal.span {x})
    (a : ℂ)
    (ha : quarticAngularRatio (E₁ (algebraMap F₈ _ (x : F₈))) ^ 3 /
      quarticAngularRatio (E₂ (algebraMap F₈ _ (x : F₈))) = a) (s : ℂ) :
    finiteLocalEulerFactor v.val (sLocalFiniteRestriction v
      (quasiCharacterNormTwist (sIdeleQuotientNorm F₈ T)
        (isProperMap_sIdeleQuotientNorm F₈ T).continuous (sIdeleRestriction F₈ T c) s)) =
      (1 - a * Complex.exp (-(Real.log (v.val.asIdeal.absNorm : ℝ) : ℂ) * s))⁻¹ := by
  classical
  have hx₀ : x ≠ 0 := by
    intro h
    exact v.val.ne_bot (by simpa [h] using hx)
  let z : F₈ˣ := Units.mk0 (x : F₈) (RingOfIntegers.coe_ne_zero_iff.mpr hx₀)
  let t : (v.val.adicCompletion F₈)ˣ :=
    Units.map (algebraMap F₈ (v.val.adicCompletion F₈)).toMonoidHom z
  have ht : Valued.v t.val = v.val.valuation F₈ (z : F₈) :=
    HeightOneSpectrum.valuedAdicCompletion_eq_valuation' _ _
  have hval (w : HeightOneSpectrum (𝓞 F₈)) :
      w.valuation F₈ (z : F₈) = if w = v.val then WithZero.exp (-1 : ℤ) else 1 :=
    valuation_prime_ideal_generator F₈ v.val x hx w
  have hπ : Valued.v.IsUniformizer (t : v.val.adicCompletion F₈) := by
    change Valued.v t.val = _
    rw [ht, hval, ite_eq_left rfl]
    exact (congrArg Units.val (Valuation.IsRankOneDiscrete.generator_eq_exp_neg_one_of_surjective
      (v.val.valuedAdicCompletion_surjective F₈))).symm
  have hphase := quarticBenchmark_uniformizer_phase E₁ E₂ c₀ harch v.val t z ht
    (fun w hw ↦ by rw [hval, ite_eq_right hw])
  have htphase : sLocalFiniteRestriction v (sIdeleRestriction F₈ T c) t = a := by
    rw [orbital_finiteRestriction_sIdeleRestriction, hc]
    rw [HeckeCharacter.restrict, MulChar.ofUnitHom_coe] at hphase
    exact hphase.trans ha
  have hunit (u : (v.val.adicCompletion F₈)ˣ) (hu : ‖u.val‖ = 1) :
      sLocalFiniteRestriction v (sIdeleRestriction F₈ T c) u = 1 := by
    rw [orbital_finiteRestriction_sIdeleRestriction, hc]
    let R := v.val.adicCompletionIntegers F₈
    let i := Units.map R.subtype.toMonoidHom
    have hmem : u ∈ R.toSubmonoid.units :=
      HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one.mpr
        (Valued.toNormedField.norm_eq_one_iff.mp hu)
    let u' : Rˣ := R.toSubmonoid.unitsEquivUnitsType ⟨u, hmem⟩
    have hi : i u' = u := rfl
    rw [← hi]
    exact (mem_unramifiedOutside_iff F₈ ∅ c₀.val).mp c₀.property v.val (by simp) u'
  exact orbital_localEulerProfile v _ t (norm_uniformizer_adicCompletion v.val _ hπ) a
    htphase hunit s

local notation "V₈" => HeightOneSpectrum (𝓞 F₈)
local notation "Vℚ" => HeightOneSpectrum (𝓞 ℚ)
local notation "C₁" => MonoidHom.ker (ideleClassNorm F₈)

private def quarticStageProfile {T : Finset V₈}
    (c : QuasiCharacter (SIdeleQuotient F₈ T)) (v : T) (a : ℂ) : Prop :=
  ∀ s : ℂ,
    finiteLocalEulerFactor v.val (sLocalFiniteRestriction v
      (quasiCharacterNormTwist (sIdeleQuotientNorm F₈ T)
        (isProperMap_sIdeleQuotientNorm F₈ T).continuous c s)) =
      (1 - a * Complex.exp (-(Real.log (v.val.asIdeal.absNorm : ℝ) : ℂ) * s))⁻¹

private theorem quarticBenchmark_stageCharacter (T : Finset V₈) :
    ∃ (ω : PontryaginDual C₁) (hω : NormOneCharacterUnramifiedOutside ω ∅)
      (c : QuasiCharacter (SIdeleQuotient F₈ T)) (τ : ℝ≥0ˣ →ₜ* SIdeleQuotient F₈ T),
      let χ := sLocalNormOneCharacter T ω (hω.mono (Finset.empty_subset T))
      normOneRestriction (sIdeleQuotientNorm F₈ T) c =
        (⟨Circle.coeHom, continuous_subtype_val⟩ : Circle →ₜ* ℂ).comp χ ∧
      Function.RightInverse τ (sIdeleQuotientNorm F₈ T) ∧ (∀ t, c (τ t) = 1) ∧
      ¬ IsOfFinOrder ω ∧
      ∀ (v : T) (x : 𝓞 F₈), v.val.asIdeal = Ideal.span {x} →
        quarticStageProfile c v (quarticAngularRatio (quarticEmbeddingOne (x : F₈)) ^ 3 /
          quarticAngularRatio (quarticEmbeddingThree (x : F₈))) := by
  obtain ⟨E₁, E₂, c₀, ω, hc₀, hE₁, hE₂, he₁, he₂, _, harch, horder⟩ :=
    quarticBenchmark_global_character quarticEmbeddingOne.toRingHom quarticEmbeddingThree.toRingHom
      (quarticEmbeddingThree_zeta.trans (congrArg (fun z : ℂ ↦ z ^ 3) quarticEmbeddingOne_zeta).symm)
  let hω : NormOneCharacterUnramifiedOutside ω ∅ := ⟨c₀, hc₀⟩
  let c : unramifiedOutside F₈ T := ⟨c₀.val, fun v _ ↦ c₀.property v (by simp)⟩
  let χ := sLocalNormOneCharacter T ω (hω.mono (Finset.empty_subset T))
  have hccomp : normOneRestriction (sIdeleQuotientNorm F₈ T) (sIdeleRestriction F₈ T c) =
      (⟨Circle.coeHom, continuous_subtype_val⟩ : Circle →ₜ* ℂ).comp χ := by
    ext1 y
    exact (sLocalNormOneCharacter_eq_sIdeleRestriction ω c hc₀ y).symm
  obtain ⟨τ, hτ, hcτ⟩ := quarticBenchmark_normSection T c _ _
    quarticEmbedding_places.1 quarticEmbedding_places.2.1 E₁ E₂ hE₁ hE₂ harch
  refine ⟨ω, hω, sIdeleRestriction F₈ T c, τ, hccomp, hτ, hcτ,
    horder quarticEmbedding_places.2.2, fun v x hx s ↦ ?_⟩
  apply quarticLocalProfile E₁ E₂ c₀ c rfl harch v x hx
  rw [he₁, he₂]
  rfl

local instance quarticRealization_cyclotomic : IsCyclotomicExtension {8} ℚ F₈ :=
  CyclotomicField.isCyclotomicExtension 8 ℚ

local notation "ζint" => (IsPrimitiveRoot.toInteger (IsCyclotomicExtension.zeta_spec 8 ℚ F₈))
local notation "g₁" => (3 + (ζint - ζint ^ 3))
local notation "g₂" => (3 - (ζint - ζint ^ 3))
local notation "gPlus" => (2 + ζint)
local notation "gMinus" => (2 - ζint)

private theorem quarticBenchmark_placeData :
    ∃ (S₀ T : Finset V₈) (p : Vℚ) (w₁ w₂ vPlus vMinus : T),
      sLocalPrimaryPlaces T p = S₀ ∧ IsSaturatedPlaceSet S₀ ∧ S₀.card = 2 ∧
      w₁.val ∈ S₀ ∧ w₂.val ∈ S₀ ∧ w₁ ≠ w₂ ∧
      w₁.val.asIdeal = Ideal.span {g₁} ∧ w₂.val.asIdeal = Ideal.span {g₂} ∧
      vPlus.val.asIdeal = Ideal.span {gPlus} ∧ vMinus.val.asIdeal = Ideal.span {gMinus} ∧
      w₁.val.asIdeal.absNorm = 49 ∧ w₂.val.asIdeal.absNorm = 49 ∧
      (∀ v ∈ ({vPlus, vMinus} : Set T), v.val.asIdeal.absNorm = 17) ∧
      (∀ v ∈ ({vPlus, vMinus} : Set T), v.val ∉ S₀) := by
  classical
  obtain ⟨hI, hJ, hIJ⟩ := quarticPrimaryGenerator_ideals
  obtain ⟨K, L, hK, hL, hKL, _, _, _, _, hk, hl⟩ :=
    quarticBenchmark_distinct_primes_over_seventeen
      (IsCyclotomicExtension.zeta_spec 8 ℚ F₈).toInteger_isPrimitiveRoot
  obtain ⟨v₁, v₂, u₁, u₂, p, q, S, hv₁, hv₂, hu₁, hu₂, hvne, _, _, _, _, _, _, hs₀, _, _,
    _, hP, hother⟩ :=
    quarticFiniteStages (Ideal.span {g₁}) (Ideal.span {g₂}) K L hI hJ hK hL hIJ hKL
      quarticBenchmark_primes_over_seven.1
  let S₀ : Finset V₈ := {v₁, v₂}
  let T : Finset V₈ := S₀ ∪ {u₁, u₂}
  let w₁ : T := ⟨v₁, by simp [T, S₀]⟩
  let w₂ : T := ⟨v₂, by simp [T, S₀]⟩
  let vPlus : T := ⟨u₁, by simp [T]⟩
  let vMinus : T := ⟨u₂, by simp [T]⟩
  change sLocalPrimaryPlaces T p = S₀ at hP
  change T \ S₀ = {u₁, u₂} at hother
  have hwdist : w₁ ≠ w₂ := fun h ↦ hvne (congrArg Subtype.val h)
  have h49₁ : w₁.val.asIdeal.absNorm = 49 := by
    change v₁.asIdeal.absNorm = 49
    rw [hv₁]
    exact quarticPrimaryGenerator_norms.1
  have h49₂ : w₂.val.asIdeal.absNorm = 49 := by
    change v₂.asIdeal.absNorm = 49
    rw [hv₂]
    exact quarticPrimaryGenerator_norms.2
  have h17 (v : T) (hv : v ∈ ({vPlus, vMinus} : Set T)) : v.val.asIdeal.absNorm = 17 := by
    rcases Set.mem_insert_iff.mp hv with rfl | hv
    · exact quarticBenchmark_primes_over_seventeen.2 _ (hu₁.symm ▸ hK)
    · have h : v = vMinus := Set.mem_singleton_iff.mp hv
      subst v
      exact quarticBenchmark_primes_over_seventeen.2 _ (hu₂.symm ▸ hL)
  have hvOutside (v : T) (hv : v ∈ ({vPlus, vMinus} : Set T)) : v.val ∉ S₀ := by
    have hvPair : v.val ∈ ({u₁, u₂} : Finset V₈) := by
      rcases Set.mem_insert_iff.mp hv with h | h
      · simp [h, vPlus]
      · simp [Set.mem_singleton_iff.mp h, vMinus]
    rw [← hother] at hvPair
    exact (Finset.mem_sdiff.mp hvPair).2
  exact ⟨S₀, T, p, w₁, w₂, vPlus, vMinus, hP, hs₀, by simp [S₀, hvne],
    by simp [S₀, w₁], by simp [S₀, w₂], hwdist, hv₁, hv₂, hu₁.trans hk, hu₂.trans hl,
    h49₁, h49₂, h17, hvOutside⟩

open scoped Classical in
/-- The explicit quartic character realizes the repeated-primary-pole hypotheses of
issue #7336. At one of the two selected places over seventeen, the eligible centers are
infinite, their Euler values are unbounded, and no common shift clears the phases. -/
theorem quarticBenchmark_orbitalExample :
    ∃ (S₀ T : Finset V₈) (p : Vℚ) (w v : T) (ω : PontryaginDual C₁)
      (hω : NormOneCharacterUnramifiedOutside ω ∅) (τ : ℝ≥0ˣ →ₜ* SIdeleQuotient F₈ T),
      let χ := sLocalNormOneCharacter T ω (hω.mono (Finset.empty_subset T))
      let A := {j : SLocalOrbitalIndex (S := T) (sLocalPrimaryPlaces T p) χ |
        j.val.2 ≠ 0 ∧ w ∈ sLocalFinitePolePlaces j.val.1 ∧
          1 < ‖finiteLocalEulerFactor v.val (sLocalFiniteRestriction v j.val.1)‖}
      let t (j : SLocalOrbitalIndex (S := T) (sLocalPrimaryPlaces T p) χ) :=
        (existsUnique_complexPower (j.val.1.comp τ)).exists.choose
      sLocalPrimaryPlaces T p = S₀ ∧ IsSaturatedPlaceSet S₀ ∧ S₀.card = 2 ∧
      Subsingleton (CommRing.Pic (Set.integer ((T \ S₀ : Finset V₈) : Set V₈) F₈)) ∧
      w.val ∈ S₀ ∧ v.val ∉ S₀ ∧
      w.val.asIdeal.absNorm = 49 ∧ v.val.asIdeal.absNorm = 17 ∧
      (¬ ∃ k l : ℕ, 0 < k ∧ 0 < l ∧ v.val.asIdeal.absNorm ^ k = w.val.asIdeal.absNorm ^ l) ∧
      ¬ IsOfFinOrder ω ∧ Function.RightInverse τ (sIdeleQuotientNorm F₈ T) ∧
      ((fun j ↦ j.val.1) '' A).Infinite ∧
      ¬ BddAbove ((fun j ↦ ‖finiteLocalEulerFactor v.val (sLocalFiniteRestriction v j.val.1)‖) '' A) ∧
      ∃ u : (v.val.adicCompletion F₈)ˣ, ‖u.val‖ = (v.val.asIdeal.absNorm : ℝ)⁻¹ ∧
        ¬ ∃ σ : ℂ, ∃ N : ℕ, 0 < N ∧ ∀ j ∈ A,
          Complex.exp (N * (-(Real.log w.val.asIdeal.absNorm : ℂ) * (t j - σ))) = 1 ∧
          sLocalFiniteRestriction v j.val.1 u ^ N =
            Complex.exp (N * (-(Real.log v.val.asIdeal.absNorm : ℂ) * (t j - σ))) := by
  classical
  obtain ⟨S₀, T, p, w₁, w₂, vPlus, vMinus, hP, hs₀, hcard, hw₁, hw₂, hwdist,
    hv₁, hv₂, hvPlus, hvMinus, h49₁, h49₂, h17, hvOutside⟩ := quarticBenchmark_placeData
  obtain ⟨ω, hω, c, τ, hccomp, hτ, hcτ, horder, hprofile⟩ := quarticBenchmark_stageCharacter T
  let χ := sLocalNormOneCharacter T ω (hω.mono (Finset.empty_subset T))
  have hp (v : T) (x : 𝓞 F₈) (hx : v.val.asIdeal = Ideal.span {x}) (a : ℂ)
      (ha : quarticAngularRatio (quarticEmbeddingOne (x : F₈)) ^ 3 /
        quarticAngularRatio (quarticEmbeddingThree (x : F₈)) = a) : quarticStageProfile c v a :=
    ha ▸ hprofile v x hx
  have hminus (s : ℂ) := hp vMinus gMinus hvMinus quarticPhaseMinus
    (quarticAngularRatio_prime_generators.2) s
  have hplus (s : ℂ) := hp vPlus gPlus hvPlus quarticPhasePlus
    (quarticAngularRatio_prime_generators.1) s
  obtain ⟨v, hv, hinf, hunb, hclear⟩ :=
    quarticBenchmark_orbitalExample_of_localEulerProfiles (sLocalPrimaryPlaces T p)
      c χ hccomp τ hτ hcτ w₁ w₂ vPlus vMinus (by rwa [hP]) (by rwa [hP])
      hwdist h49₁ h17
      (fun w hw s ↦ by
        rcases Set.mem_insert_iff.mp hw with h | hw
        · subst w
          simpa only [h49₁, Nat.cast_ofNat, one_mul] using
            hp w₁ g₁ hv₁ 1 (quarticAngularRatio_primary_generators.1) s
        · have h : w = w₂ := Set.mem_singleton_iff.mp hw
          subst w
          simpa only [h49₂, Nat.cast_ofNat, one_mul] using
            hp w₂ g₂ hv₂ 1 (quarticAngularRatio_primary_generators.2) s)
      (fun s ↦ by simpa only [h17 vPlus (by simp), Nat.cast_ofNat] using hplus s)
      (fun s ↦ by simpa only [h17 vMinus (by simp), Nat.cast_ofNat] using hminus s)
  have hinc : ¬ ∃ k l : ℕ, 0 < k ∧ 0 < l ∧ v.val.asIdeal.absNorm ^ k = w₁.val.asIdeal.absNorm ^ l := by
    rw [h17 v hv, h49₁]
    rintro ⟨k, l, hk, _, heq⟩
    have hdvd : 17 ∣ (49 : ℕ) ^ l := heq ▸ dvd_pow_self 17 hk.ne'
    exact (by decide : ¬ (17 : ℕ) ∣ 49) ((by decide : Nat.Prime 17).dvd_of_dvd_pow hdvd)
  exact ⟨S₀, T, p, w₁, v, ω, hω, τ, hP, hs₀, hcard,
    quarticBenchmark_sInteger_picard _, hw₁, hvOutside v hv, h49₁, h17 v hv, hinc,
    horder, hτ, hinf, hunb, hclear⟩

end QuarticRealization

