module

public import Mathlib.RingTheory.Filtration
public import Mathlib.RingTheory.Unramified.LocalRing
public import Mathlib.RingTheory.Unramified.Locus
public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.Flat.Localization
public import Mathlib.RingTheory.Smooth.Flat

/-!
# Local rings of étale algebras over a principal ideal domain

* `RiemannMasullo.isDomain_of_maximalIdeal_eq_span`: a noetherian local ring whose maximal ideal
  is generated by a non-zero-divisor (or is zero) is a domain.
* `RiemannMasullo.isDomain_localization_of_etale`: the localizations at primes of an étale algebra
  over a principal ideal domain are domains.

The second gives, through étale coordinates, that the local rings of a smooth curve over a field
are domains (`RiemannMasullo/ForMathlib/AlgebraicGeometry/SmoothCurve.lean`).
-/

@[expose] public section

namespace RiemannMasullo

open IsLocalRing

/-- A noetherian local ring whose maximal ideal is generated by a non-zero-divisor (or is zero) is
a domain: every nonzero element is a unit times a power of the generator (Krull's intersection
theorem). -/
theorem isDomain_of_maximalIdeal_eq_span {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] {π : R} (hπ : maximalIdeal R = Ideal.span {π})
    (hreg : π ∈ nonZeroDivisors R ∨ π = 0) : IsDomain R := by
  rcases hreg with hreg | hreg
  · have key : ∀ a : R, a ≠ 0 → ∃ (n : ℕ) (u : R), IsUnit u ∧ a = π ^ n * u := by
      intro a ha
      have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal R) (maximalIdeal.isMaximal R).ne_top
      have hex : ∃ n, a ∉ maximalIdeal R ^ n := by
        by_contra h
        push Not at h
        apply ha
        have : a ∈ ⨅ n : ℕ, maximalIdeal R ^ n := Ideal.mem_iInf.2 h
        rwa [hK, Ideal.mem_bot] at this
      classical
      set N := Nat.find hex with hN
      have hN1 : a ∉ maximalIdeal R ^ N := Nat.find_spec hex
      have hN0 : N ≠ 0 := by
        intro h0; rw [h0, pow_zero, Ideal.one_eq_top] at hN1; exact hN1 Submodule.mem_top
      have hmem : a ∈ maximalIdeal R ^ (N - 1) := by
        by_contra h; exact Nat.find_min hex (by omega) h
      rw [hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem
      obtain ⟨u, hu⟩ := hmem
      refine ⟨N - 1, u, ?_, by rw [← hu, mul_comm]⟩
      by_contra hu'
      have hu'' : u ∈ maximalIdeal R := (mem_maximalIdeal u).2 hu'
      rw [hπ, Ideal.mem_span_singleton'] at hu''
      obtain ⟨v, hv⟩ := hu''
      apply hN1
      rw [hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
      refine ⟨v, ?_⟩
      rw [← hu, ← hv, mul_assoc, ← pow_succ']
      congr 2
      omega
    have : NoZeroDivisors R := ⟨fun {a b} hab => by
      by_contra hne
      push Not at hne
      obtain ⟨n, u, hu, rfl⟩ := key a hne.1
      obtain ⟨m, v, hv, rfl⟩ := key b hne.2
      rw [show π ^ n * u * (π ^ m * v) = π ^ (n + m) * (u * v) by ring] at hab
      have h1 : π ^ (n + m) = 0 := (hu.mul hv).mul_left_eq_zero.1 hab
      exact nonZeroDivisors.ne_zero (pow_mem hreg (n + m)) h1⟩
    exact NoZeroDivisors.to_isDomain R
  · subst hreg
    rw [Ideal.span_singleton_eq_bot.2 rfl] at hπ
    have : IsField R := (isField_iff_maximalIdeal_eq).2 hπ
    let := this.toField
    infer_instance


/-- The local rings of an étale algebra over a principal ideal domain are domains: over a
nonzero prime `(π)` the maximal ideal of `B_q` is `π B_q` (unramified) and `π` is a
non-zero-divisor (flat); over the zero prime `B_q` is a field. -/
theorem isDomain_localization_of_etale {R B : Type*} [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R] [CommRing B] [Algebra R B] [Algebra.Etale R B]
    (q : Ideal B) [q.IsPrime] : IsDomain (Localization.AtPrime q) := by
  set p := q.under R
  let := Localization.AtPrime.algebraOfLiesOver p q
  have : Algebra.IsUnramifiedAt R q := inferInstance
  have hmap := Algebra.IsUnramifiedAt.map_eq R p q
  obtain ⟨π, hπ⟩ := (IsPrincipalIdealRing.principal p).principal
  rw [hπ, Ideal.map_span, Set.image_singleton] at hmap
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R B
  refine isDomain_of_maximalIdeal_eq_span hmap.symm ?_
  by_cases h0 : π = 0
  · right; simp [h0]
  · left
    have : Module.Flat R B := Algebra.Smooth.flat R B
    have : Module.Flat R (Localization.AtPrime q) := Module.Flat.trans R B _
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Localization.AtPrime q)
      (mem_nonZeroDivisors_of_ne_zero h0)
    apply hreg
    show π • x = π • 0
    rw [smul_zero, Algebra.smul_def, mul_comm]
    exact hx

end RiemannMasullo
